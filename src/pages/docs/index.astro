---
import DocsShell from '../../layouts/DocsShell.astro';
import { getDocSections } from '../../lib/docs';
import { url } from '../../lib/url';

const sections = await getDocSections();
const total = sections.reduce((n, s) => n + s.docs.length, 0);
---
<DocsShell title="Документация" description="Как устроен Inside Darkness: мир за Стеной, ремёсла и ранги, торг и вести, дороги, город и жильё, граница с подземельями и набегами, снаряжение и чары, правила и команды." sections={sections}>
  <header class="doc-head">
    <h1 class="doc-head__title">Документация</h1>
    <p class="doc-head__lead">Всё о жизни в княжестве за Большой стеной: где что, как добывать и где выгоднее продавать, как ездить, где жить и куда ходить за риском. Все цены и числа взяты прямо из игры. Поиск слева ищет по всем страницам.</p>
  </header>

  {total === 0 ? (
    <div class="docs-empty">
      <p class="docs-empty__title">Страницы пока пишутся.</p>
      <p>Здесь будут мир, ремёсла, торг, дороги, город и правила. Как зайти на сервер, уже есть на <a href={url('/#join')}>главной</a>.</p>
    </div>
  ) : (
    <div class="docs-index">
      {sections.map((section, i) => (
        <section class="docs-index__section" aria-labelledby={`s-${i}`}>
          <h2 class="docs-index__name" id={`s-${i}`}>{section.name}</h2>
          <ul role="list">
            {section.docs.map((doc) => (
              <li>
                <a class="docs-index__link" href={url(`/docs/${doc.id}/`)}>
                  <span class="docs-index__title">{doc.data.title}</span>
                  {doc.data.description && <span class="docs-index__desc">{doc.data.description}</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  )}
</DocsShell>

<style>
  .doc-head__title {
    font-size: var(--fs-xl);
    line-height: 1;
  }

  .doc-head__lead {
    max-width: 40rem;
    margin-top: 1rem;
    color: var(--bone-2);
    font-size: var(--fs-md);
    line-height: 1.5;
  }

  .docs-empty {
    display: grid;
    gap: 0.5rem;
    margin-top: 2.5rem;
    padding: 1.25rem 1.5rem;
    box-shadow: inset 0 0 0 2px var(--slate-3);
    color: var(--ash);
  }

  .docs-empty__title {
    color: var(--bone);
    font-size: var(--fs-md);
    font-weight: 700;
  }

  .docs-index {
    display: grid;
    gap: 2.75rem;
    margin-top: 3rem;
  }

  .docs-index__name {
    font-size: var(--fs-md);
  }

  .docs-index ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 0;
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
    box-shadow: inset 0 1px 0 var(--line-2);
  }

  .docs-index__link {
    display: grid;
    gap: 0.2rem;
    height: 100%;
    padding: 0.9rem 1rem 1rem 0;
    box-shadow: inset 0 -1px 0 var(--line);
    text-decoration: none;
    transition: box-shadow 0.15s ease;
  }

  .docs-index__title {
    color: var(--gold);
    font-size: 1.1875rem;
    font-weight: 700;
  }

  .docs-index__desc {
    color: var(--ash);
    font-size: 1rem;
    line-height: 1.45;
  }

  .docs-index__link:hover .docs-index__title {
    color: var(--bone);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
