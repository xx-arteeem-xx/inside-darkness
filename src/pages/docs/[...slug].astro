---
import { render } from 'astro:content';
import DocsShell from '../../layouts/DocsShell.astro';
import { getDocSections, flatten, type Doc } from '../../lib/docs';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const sections = await getDocSections();
  const docs = flatten(sections);
  return docs.map((doc, i) => ({
    params: { slug: doc.id },
    props: { doc, prev: docs[i - 1] ?? null, next: docs[i + 1] ?? null, sections },
  }));
}

interface Props {
  doc: Doc;
  prev: Doc | null;
  next: Doc | null;
  sections: Awaited<ReturnType<typeof getDocSections>>;
}

const { doc, prev, next, sections } = Astro.props;
const { Content, headings } = await render(doc);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
<DocsShell title={doc.data.title} description={doc.data.description} sections={sections} currentId={doc.id} headings={headings}>
  <article class="doc">
    <nav class="crumbs" aria-label="Путь">
      <a href={url('/docs/')}>Документация</a>
      <span aria-hidden="true">/</span>
      <span>{doc.data.section}</span>
    </nav>
    <h1 class="doc__title">{doc.data.title}</h1>
    {doc.data.description && <p class="doc__lead">{doc.data.description}</p>}

    {toc.length > 1 && (
      <details class="toc-inline">
        <summary>На этой странице</summary>
        <ul role="list">
          {toc.map((h) => (
            <li class:list={[`toc-d${h.depth}`]}><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ul>
      </details>
    )}

    <div class="prose">
      <Content />
    </div>

    {(prev || next) && (
      <nav class="pager" aria-label="Соседние страницы">
        {prev ? (
          <a class="pager__link pager__link--prev" href={url(`/docs/${prev.id}/`)}>
            <span class="pager__hint">Назад</span>
            <span class="pager__title">{prev.data.title}</span>
          </a>
        ) : <span />}
        {next && (
          <a class="pager__link pager__link--next" href={url(`/docs/${next.id}/`)}>
            <span class="pager__hint">Дальше</span>
            <span class="pager__title">{next.data.title}</span>
          </a>
        )}
      </nav>
    )}
  </article>
</DocsShell>

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--ash);
    font-size: 1rem;
  }

  .crumbs a {
    color: var(--ash);
  }

  .crumbs a:hover {
    color: var(--gold);
  }

  .doc__title {
    margin-top: 0.75rem;
    font-size: var(--fs-xl);
    line-height: 1;
  }

  .doc__lead {
    max-width: 40rem;
    margin-top: 1rem;
    color: var(--bone-2);
    font-size: var(--fs-md);
    line-height: 1.5;
  }

  .doc .prose {
    margin-top: 2.25rem;
  }

  .toc-inline {
    display: none;
    margin-top: 1.75rem;
    padding: 0.75rem 1rem;
    background: var(--slate-0);
    box-shadow: inset 0 0 0 1px var(--slate-3);
  }

  .toc-inline summary {
    color: var(--bone);
    font-weight: 700;
    cursor: pointer;
  }

  .toc-inline ul {
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
  }

  .toc-inline a {
    display: block;
    padding-block: 0.3rem;
    color: var(--bone-2);
    text-decoration: none;
  }

  .toc-inline a:hover {
    color: var(--gold);
  }

  .toc-inline .toc-d3 a {
    padding-left: 0.9rem;
    color: var(--ash);
  }

  @media (max-width: 75rem) {
    .toc-inline {
      display: block;
    }
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 4.5rem;
  }

  .pager__link {
    display: grid;
    gap: 0.2rem;
    padding: 0.9rem 1.1rem;
    background: var(--slate-0);
    box-shadow: inset 0 0 0 2px var(--slate-3);
    text-decoration: none;
    transition: box-shadow 0.15s ease;
  }

  .pager__link:hover {
    box-shadow: inset 0 0 0 2px var(--gold-deep);
  }

  .pager__link--next {
    text-align: right;
  }

  .pager__hint {
    color: var(--ash);
    font-size: 0.9375rem;
  }

  .pager__title {
    color: var(--gold);
    font-size: 1.1875rem;
    font-weight: 700;
  }

  @media (max-width: 36rem) {
    .pager {
      grid-template-columns: 1fr;
    }

    .pager__link--next {
      text-align: left;
    }
  }
</style>
