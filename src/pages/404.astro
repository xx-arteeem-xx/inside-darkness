---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---
<Base title="Страница не найдена">
  <section class="nf wrap">
    <p class="nf__code" aria-hidden="true">Y −64</p>
    <h1>Такой страницы нет</h1>
    <p class="nf__text">Ниже только бедрок. Ссылка устарела или в адресе опечатка.</p>
    <p class="nf__links">
      <a class="btn" href={url('/')}>На главную</a>
      <a class="more" href={url('/docs/')}>Документация</a>
    </p>
  </section>
  <div class="nf__bedrock" aria-hidden="true"></div>
</Base>

<style>
  .nf {
    padding-block: clamp(4rem, 12vw, 8rem) clamp(3rem, 8vw, 5rem);
  }

  .nf__code {
    color: var(--gold);
    font-family: var(--font-pixel);
    font-size: 1.5rem;
  }

  .nf h1 {
    margin-top: 0.75rem;
    font-size: var(--fs-xl);
    line-height: 1;
  }

  .nf__text {
    margin-top: 1rem;
    color: var(--bone-2);
    font-size: var(--fs-md);
  }

  .nf__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2rem;
  }

  /* Слой бедрока: неровные тёмные блоки. */
  .nf__bedrock {
    height: 6rem;
    background:
      repeating-conic-gradient(#1b1b20 0 25%, #0f0f12 0 50%) 0 0 / 2rem 2rem,
      #0f0f12;
    opacity: 0.8;
  }
</style>
