---
import { gridLayers, rng } from '../lib/pixel';

/* Схема защиты: город в стенах с 16 башнями, кольцо охраняемых земель, дальше дикий мир.
   Не карта и не масштаб: город на схеме нарисован крупнее, чем есть. */
const N = 50;
const C = 25;
const R_LAND = 21;
const R_CITY = 7;
const r = rng(16);
const cells: string[][] = Array.from({ length: N }, () => Array(N).fill('.'));
for (let y = 0; y < N; y++) {
  for (let x = 0; x < N; x++) {
    const d = Math.hypot(x + 0.5 - C, y + 0.5 - C);
    if (d <= R_CITY - 1) cells[y][x] = 'c';
    else if (d <= R_CITY) cells[y][x] = 'w';
    else if (d <= R_LAND - 1) cells[y][x] = 'g';
    else if (d <= R_LAND) cells[y][x] = (x + y) % 3 === 0 ? 'g' : 'G';
    else if (r() > 0.78) cells[y][x] = r() > 0.5 ? 'f' : 'F';
  }
}
// 16 башен на кольце стен
for (let k = 0; k < 16; k++) {
  const a = (k / 16) * Math.PI * 2;
  const tx = Math.floor(C + Math.cos(a) * (R_CITY - 0.4));
  const ty = Math.floor(C + Math.sin(a) * (R_CITY - 0.4));
  cells[ty][tx] = 't';
}
// цитадель в центре
for (let y = C - 2; y <= C; y++) for (let x = C - 1; x <= C + 1; x++) cells[y][x] = 'k';
cells[C - 1][C] = 'y';
// южные ворота, мост и дорога к деревне
for (let y = C + R_CITY; y <= C + 12; y++) cells[y][C] = y === C + R_CITY ? 'y' : 'r';
for (const [dx, dy] of [[-2, 13], [1, 13], [-1, 14], [2, 14], [0, 15]]) cells[C + dy][C + dx] = 'h';

const diagram = gridLayers(
  {
    rows: cells.map((row) => row.join('')),
    palette: {
      c: '#2e303b',
      w: '#9a9eb0',
      t: '#d9d2bd',
      k: '#121318',
      y: '#f4c770',
      g: '#2a171c',
      G: '#a32c3c',
      f: '#1a241c',
      F: '#142019',
      r: '#6b6658',
      h: '#8a5a2b',
    },
  },
  8,
);
---
<section class="capital section" id="capital" aria-labelledby="capital-title">
  <svg class="strata" viewBox="0 0 1440 24" preserveAspectRatio="none" aria-hidden="true" shape-rendering="crispEdges">
    <path fill="#17171c" d="M0 24V8h120v8h96V4h168v12h72V8h144v8h112V0h96v12h160V4h88v12h120V8h136v8h128V24z" />
  </svg>
  <div class="wrap">
    <div class="capital__grid">
      <header class="section-head capital__head">
        <h2 class="section-title" id="capital-title">Столица</h2>
        <p class="section-lead">
          Город-крепость у моря. Здесь безопасно: можно разобраться с меню, поговорить с наставниками и собраться в
          поход.
        </p>
      </header>

      <dl class="quarters">
        <div class="quarter">
          <dt>Стены</dt>
          <dd>Мощные стены с 16 башнями. Со стороны моря морская стена. Южные ворота выходят на каменный мост к деревне.</dd>
        </div>
        <div class="quarter">
          <dt>Цитадель</dt>
          <dd>Тёмная, из глубинносланцевого кирпича. В донжоне тронный и пиршественный залы, библиотека, покои и оружейная. Во дворе большой зал и казармы.</dd>
        </div>
        <div class="quarter">
          <dt>Город</dt>
          <dd>Рынок с фонтаном и прилавками, дома и мастерские, храм, библиотека, загоны и поля, ристалище с трибунами и стрельбище.</dd>
        </div>
        <div class="quarter">
          <dt>Наставники</dt>
          <dd>По городу стоят NPC-наставники. Кликните по наставнику, и откроется окно с подсказками.</dd>
        </div>
      </dl>
    </div>

    <section class="ward" aria-labelledby="ward-title">
      <figure class="ward__figure">
        <svg class="ward__map" viewBox="0 0 400 400" role="img" aria-labelledby="ward-cap" shape-rendering="crispEdges">
          {diagram.map((l) => <path fill={l.fill} d={l.d} />)}
          <path d="M264 198h104v4H264z" fill="#d9d2bd" opacity="0.6" />
          <text x="316" y="190" text-anchor="middle" class="ward__r">1000 блоков</text>
        </svg>
        <figcaption id="ward-cap">Схема, не в масштабе: город в стенах с 16 башнями и кольцо охраняемых земель вокруг.</figcaption>
      </figure>

      <div class="ward__text">
        <h3 class="ward__title" id="ward-title">Защита</h3>
        <ul class="rules" role="list">
          <li class="rule rule--city">
            <span class="rule__key" aria-hidden="true"></span>
            <div>
              <p class="rule__name">В городе</p>
              <p>Ничего нельзя сломать, нет мобов и PvP.</p>
            </div>
          </li>
          <li class="rule rule--land">
            <span class="rule__key" aria-hidden="true"></span>
            <div>
              <p class="rule__name">Охраняемые земли, 1000 блоков вокруг столицы</p>
              <p>Без взрывов и строительства.</p>
            </div>
          </li>
          <li class="rule rule--wild">
            <span class="rule__key" aria-hidden="true"></span>
            <div>
              <p class="rule__name">Дальше</p>
              <p>Обычный мир: стройтесь, ищите замки и подземелья. Изменения блоков пишутся в журнал, гриферство откатывают.</p>
            </div>
          </li>
        </ul>
      </div>
    </section>
  </div>
</section>

<style>
  .capital {
    background: #17171c;
  }

  .capital__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 2.5rem clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .quarters {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 2.5rem;
  }

  .quarter {
    padding-top: 1rem;
    box-shadow: inset 0 2px 0 var(--slate-4);
  }

  .quarter dt {
    font-size: var(--fs-md);
    font-weight: 900;
    line-height: 1.15;
  }

  .quarter dd {
    margin: 0.5rem 0 0;
    color: var(--bone-2);
  }

  .ward {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2.5rem clamp(2.5rem, 6vw, 5rem);
    align-items: center;
    margin-top: clamp(3.5rem, 8vw, 6rem);
  }

  .ward__figure {
    max-width: 30rem;
  }

  .ward__map {
    display: block;
    width: 100%;
    height: auto;
    background: #0e1210;
    box-shadow: 0 0 0 1px var(--line);
  }

  .ward__r {
    fill: #ece4d0;
    font-family: var(--font-pixel);
    font-size: 16px;
  }

  .ward__figure figcaption {
    margin-top: 0.75rem;
    color: var(--ash);
    font-size: var(--fs-sm);
  }

  .ward__title {
    font-size: var(--fs-lg);
  }

  .rules {
    display: grid;
    gap: 1.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .rule {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: 1rem;
    align-items: start;
  }

  .rule__key {
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.2rem;
  }

  .rule--city .rule__key {
    background: #2e303b;
    box-shadow: inset 0 0 0 3px #9a9eb0;
  }

  .rule--land .rule__key {
    background: #2a171c;
    box-shadow: inset 0 0 0 3px #a32c3c;
  }

  .rule--wild .rule__key {
    background: repeating-conic-gradient(#1a241c 0 25%, #0e1210 0 50%) 0 0 / 0.75rem 0.75rem;
    box-shadow: inset 0 0 0 1px var(--line-2);
  }

  .rule__name {
    color: var(--bone);
    font-weight: 700;
  }

  .rule p + p {
    margin-top: 0.15rem;
    color: var(--bone-2);
  }

  @media (max-width: 60rem) {
    .capital__grid,
    .ward {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 36rem) {
    .quarters {
      grid-template-columns: 1fr;
    }
  }
</style>
