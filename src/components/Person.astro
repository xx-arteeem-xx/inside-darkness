---
/**
 * Житель или «игрок» в стиле края: пиксельная фигура из настоящего скина (scripts/people.py) в ячейке инвентаря
 * и подпись «Имя · дело» подсказкой предмета. Жителя задаёт id из config.yml, «игрока» — скин из people.json → player.
 *   size: bust — по грудь в ячейке, figure — во весь рост; scale — во сколько раз увеличить (целое).
 */
import { DATA } from '../lib/site-facts';
import { person, caption, skinSrc } from '../lib/people.mjs';

interface Props {
  id?: string;
  skin?: string;
  size?: 'bust' | 'figure';
  scale?: number;
  tip?: boolean;
  class?: string;
}

const { id, skin: skinProp, size = 'bust', scale = 3, tip = true, class: className } = Astro.props;
const p = id ? person(DATA, id) : null;
if (id && !p) throw new Error(`Person: нет жителя «${id}» в people.json`);
const skin = p?.skin ?? skinProp;
if (!skin) throw new Error('Person: нужен id жителя или skin');
const W = DATA.people.w;
const H = DATA.people.h;
const frameH = size === 'bust' ? DATA.people.bust : H;
---
<figure class:list={['pp', `pp--${size}`, className]} style={`--s:${scale};--w:${W}px;--h:${H}px;--fh:${frameH}px`}>
  <span class="pp__frame" aria-hidden="true">
    <img src={skinSrc(DATA, skin)} alt="" width={W} height={H} loading="lazy" decoding="async" />
  </span>
  {p && tip && (
    <figcaption class="pp__tip">
      <span class="pp__name">{caption(p)}</span>
      <span class="pp__does">{p.does}</span>
    </figcaption>
  )}
</figure>

<style>
  .pp {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    margin: 0;
  }

  .pp__frame {
    position: relative;
    display: block;
    width: calc(var(--w) * var(--s));
    height: calc(var(--fh) * var(--s));
    overflow: hidden;
  }

  .pp--bust .pp__frame {
    box-sizing: content-box;
    padding: 3px;
    background: #1b1f28;
    box-shadow: inset 3px 3px 0 #090b10, inset -3px -3px 0 #3a4050;
  }

  .pp__frame img {
    position: absolute;
    left: 0;
    top: 0;
    width: calc(var(--w) * var(--s));
    height: calc(var(--h) * var(--s));
    max-width: none;
    image-rendering: pixelated;
  }

  .pp--bust .pp__frame img {
    left: 3px;
    top: 3px;
  }

  .pp__tip {
    display: grid;
    gap: 0.1rem;
    max-width: 14rem;
    padding: 0.35rem 0.6rem 0.4rem;
    background: rgb(16 1 16 / 0.94);
    box-shadow: inset 0 0 0 2px #100110, inset 0 0 0 4px #2b0d5a;
    font-family: var(--font-pixel);
    font-size: 0.875rem;
    line-height: 1.3;
    text-align: center;
  }

  .pp__name {
    color: var(--gold);
    font-size: 0.9375rem;
  }

  .pp__does {
    color: #a8a8a8;
  }
</style>
