---
import Pixel from './Pixel.astro';
import { GLYPHS } from '../lib/emblems';
import { G, CRAFTS, TROPHIES, TROPHY_CHANCE, LEVELS, fmt, pct, range, count, type Trophy } from '../data/game';
import { docHref } from '../lib/docs';

const craftsHref = await docHref('crafts');
const huntingHref = await docHref('hunting');
const dungeonsHref = await docHref('dungeons');
const ordersHref = await docHref('orders');
const mapsHref = await docHref('maps');
const pricesHref = await docHref('prices');

const lootRows = (list: Trophy[]) =>
  list.map((t) => [t.name, t.rare ? `редко, ${t.rare}` : `ур. ${t.levels}`, fmt(t.price)] as const);

const B = G.bosses;
const hunts = [
  {
    id: 'dungeons',
    name: 'Подземелья',
    glyph: 'skull' as const,
    levels: LEVELS.dungeons,
    where: `${count(B.count, ['подземелье', 'подземелья', 'подземелий'])} внутри Стены`,
    facts: [
      'Твари появляются снова и снова: даже если до тебя всё зачистили, найдёшь кого бить.',
      'Чем дальше подземелье от столицы и чем глубже тварь, тем выше уровень. Ударь — над хотбаром появятся уровень и здоровье.',
      `Трофей падает с ${TROPHY_CHANCE.dungeons} тварей. Ратное дело добавляет ${TROPHY_CHANCE.combat}.`,
      `В глубине каждого — хозяин: котёл ${range(B.coinsMin, B.coinsMax)} монет делят по доле урона.`,
    ],
    loot: lootRows(TROPHIES.dungeons),
  },
  {
    id: 'dark',
    name: 'Тёмные земли',
    glyph: 'darkheart' as const,
    levels: LEVELS.dark,
    where: `за Большой стеной, ${range(G.world.wallRadius, G.world.borderRadius)} блоков от столицы`,
    facts: [
      'Матёрые твари, без солнца и без сна: кровати там не работают.',
      `Трофей падает с ${TROPHY_CHANCE.dark} тварей. И закона нет: напасть может любой игрок.`,
    ],
    loot: lootRows(TROPHIES.dark),
  },
];

const O = G.orders;
const C = G.chronicle;
const extra = [
  { title: 'Заказы старост', text: `${count(O.perDay, ['заказ', 'заказа', 'заказов'])} в день в каждой из ${count(O.villageCount, ['деревни', 'деревень', 'деревень'])}: монеты и опыт ремесла сверх добычи.`, href: ordersHref },
  { title: 'Летописец', text: `За каждое новое место мира ${range(C.rewardMin, C.rewardMax)} монет, за Стеной ×${fmt(C.darkMult)}, за ${fmt(C.lastTitle.count)} мест — звание «${C.lastTitle.title}».`, href: mapsHref },
  { title: 'Клады', text: `Карты сокровищ у картографа за ${G.maps.treasurePrices.map(fmt).join(', ')}: в кладе монеты и трофеи.`, href: `${mapsHref}#карты-сокровищ` },
  { title: 'Хозяева и набеги', text: `Котёл хозяина подземелья — до ${fmt(B.coinsMax)} монет, отбитый набег — ${fmt(G.raids.coins)} и ещё ${fmt(G.raids.coinsPerKill)} за каждую тварь.`, href: dungeonsHref },
];
---
<section class="earn section" id="earn" aria-labelledby="earn-title">
  <svg class="strata" viewBox="0 0 1440 24" preserveAspectRatio="none" aria-hidden="true" shape-rendering="crispEdges">
    <path fill="#17171c" d="M0 24V8h120v8h96V4h168v12h72V8h144v8h112V0h96v12h160V4h88v12h120V8h136v8h128V24z" />
  </svg>
  <div class="wrap">
    <header class="section-head">
      <h2 class="section-title" id="earn-title">Ремесло и охота</h2>
      <p class="section-lead">
        Ремесло — ровный и спокойный заработок. Охота выгоднее, а за Стеной — ещё и опасна. За убийство обычной твари
        не платят: деньги за то, что ты донёс до купца. Монеты за сам бой дают только хозяева подземелий и отбитые
        набеги тьмы.
      </p>
    </header>

    <div class="paths">
      <section class="path path--craft" aria-labelledby="craft-title">
        <div class="path__head">
          <h3 class="path__title" id="craft-title">Угодья</h3>
          <span class="tag tag--moss">надёжно</span>
        </div>
        <p class="path__lead">Ломать блоки можно только здесь. У каждого угодья — свой скупщик и ямская станция. Цены — базовые, у купца их двигают вести и место.</p>
        <ul class="crafts" role="list">
          {CRAFTS.map((c) => (
            <li class="craft">
              <div class="craft__top">
                <span class="slot" aria-hidden="true"><Pixel grid={GLYPHS[c.glyph]} /></span>
                <div>
                  <h4 class="craft__name">{c.name}</h4>
                  <p class="craft__where">
                    {c.where}{c.coords && <> · <code>{c.coords}</code></>}
                  </p>
                </div>
              </div>
              <ul class="craft__facts" role="list">
                {c.facts.map((f) => <li>{f}</li>)}
              </ul>
              <p class="craft__sells">{c.sells}</p>
            </li>
          ))}
        </ul>
        <a class="more" href={craftsHref}>Шахта, поле, сад и рыбалка</a>
      </section>

      <section class="path path--hunt" aria-labelledby="hunt-title">
        <div class="path__head">
          <h3 class="path__title" id="hunt-title">Охота</h3>
          <span class="tag">выгоднее</span>
        </div>
        <p class="path__lead">Трофеи и добычу с тварей берёт скупщик диковин, снятое с тварей снаряжение — кузнецы. Чем выше уровень твари, тем дороже трофей.</p>
        <ul class="hunts" role="list">
          {hunts.map((h) => (
            <li class:list={['hunt', `hunt--${h.id}`]}>
              <div class="hunt__top">
                <span class="slot slot--dark" aria-hidden="true"><Pixel grid={GLYPHS[h.glyph]} /></span>
                <div>
                  <h4 class="hunt__name">{h.name}</h4>
                  <p class="hunt__where">{h.where}</p>
                </div>
                <p class="lvl"><span>ур.</span> {h.levels}</p>
              </div>
              <ul class="hunt__facts" role="list">
                {h.facts.map((f) => <li>{f}</li>)}
              </ul>
              <dl class="loot">
                {h.loot.map(([name, note, price]) => (
                  <div><dt>{name} <span>{note}</span></dt><dd>{price}</dd></div>
                ))}
              </dl>
            </li>
          ))}
        </ul>
        <p class="path__links">
          <a class="more" href={huntingHref}>Охота и трофеи</a>
          <a class="more" href={dungeonsHref}>Подземелья и боссы</a>
        </p>
      </section>
    </div>

    <section class="marks" aria-labelledby="marks-title">
      <h3 class="marks__title" id="marks-title">Ещё монеты</h3>
      <ul class="marks__list" role="list">
        {extra.map((e) => <li><b><a href={e.href}>{e.title}</a>.</b> {e.text}</li>)}
      </ul>
      <p class="marks__note">Все, кто платит, и базовые цены: <a href={pricesHref}>Купцы и базовые цены</a>.</p>
    </section>
  </div>
</section>

<style>
  .earn {
    background: #17171c;
  }

  /* ——— два пути ——— */
  .paths {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 3rem clamp(2rem, 5vw, 4rem);
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  .path {
    display: grid;
    align-content: start;
    gap: 1rem;
  }

  .path > .more {
    justify-self: start;
    margin-top: 0.5rem;
  }

  .path__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin-top: 0.5rem;
  }

  .path__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    padding-bottom: 0.9rem;
    border-bottom: 2px solid var(--slate-4);
  }

  .path__title {
    font-size: var(--fs-lg);
  }

  .path__lead {
    color: var(--bone-2);
  }

  .tag--moss {
    background: rgb(131 196 147 / 0.1);
    box-shadow: inset 0 0 0 2px rgb(131 196 147 / 0.4);
    color: var(--moss);
  }

  .crafts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .craft,
  .hunt {
    display: grid;
    align-content: start;
    gap: 0.9rem;
    padding: 1.1rem 1.15rem 1.2rem;
    background: #1d1c22;
    box-shadow:
      inset 0 0 0 2px #0b0b0e,
      inset 2px 2px 0 2px #33323c,
      inset -2px -2px 0 2px #121116;
  }

  .craft__top,
  .hunt__top {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.9rem;
  }

  .craft__name,
  .hunt__name {
    font-size: var(--fs-md);
    line-height: 1.15;
  }

  .craft__where,
  .hunt__where {
    margin-top: 0.15rem;
    color: var(--ash);
    font-size: 0.9375rem;
    line-height: 1.35;
  }

  .craft__where code {
    color: var(--bone-2);
    font-size: 0.875rem;
    white-space: nowrap;
  }

  .craft__facts,
  .hunt__facts {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--bone-2);
    font-size: 1rem;
    line-height: 1.45;
  }

  .craft__facts li,
  .hunt__facts li {
    position: relative;
    padding-left: 1rem;
  }

  .craft__facts li::before,
  .hunt__facts li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 5px;
    background: var(--torch);
  }

  .craft__sells {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--line-2);
    color: var(--gold);
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  .slot {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    background: #26272f;
    box-shadow:
      inset 3px 3px 0 #0e0e12,
      inset -3px -3px 0 #464856;
  }

  .slot :global(.pixel) {
    width: 2.1rem;
    height: 2.1rem;
  }

  .slot--dark {
    background: #1a1320;
  }

  .hunts {
    display: grid;
    gap: 1rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .hunt__top {
    grid-template-columns: auto 1fr auto;
  }

  .hunt--dark {
    background:
      radial-gradient(90% 70% at 100% 0%, rgb(124 31 44 / 0.35), transparent 70%),
      #120f16;
    box-shadow:
      inset 0 0 0 2px #050406,
      inset 2px 2px 0 2px #3a2233,
      inset -2px -2px 0 2px #0b0710;
  }

  /* Уровень моба: пиксельная плашка, как подпись над головой. */
  .lvl {
    align-self: start;
    padding: 0.2rem 0.5rem;
    background: rgb(0 0 0 / 0.55);
    color: #ff8a7a;
    font-family: var(--font-pixel);
    font-size: 1.125rem;
    line-height: 1.2;
    white-space: nowrap;
  }

  .lvl span {
    color: var(--ash);
    font-size: 0.875rem;
  }

  .hunt--dungeons .lvl {
    color: var(--gold);
  }

  .loot {
    display: grid;
    margin: 0;
    border-top: 1px dashed var(--line-2);
  }

  .loot div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.55rem;
  }

  .loot dt {
    color: var(--bone-2);
    font-size: 1rem;
  }

  .loot dt span {
    margin-left: 0.3rem;
    color: var(--ash);
    font-size: 0.875rem;
    white-space: nowrap;
  }

  .loot dd {
    margin: 0;
    color: var(--gold);
    font-family: var(--font-pixel);
    font-size: 1.0625rem;
    white-space: nowrap;
  }

  /* ——— ориентиры ——— */
  .marks {
    display: grid;
    grid-template-columns: minmax(10rem, 1fr) minmax(0, 4fr);
    gap: 1rem 3rem;
    margin-top: clamp(3rem, 7vw, 4.5rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--line-2);
  }

  .marks__title {
    font-size: var(--fs-md);
  }

  .marks__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--bone-2);
  }

  .marks__list li {
    padding-left: 1rem;
    box-shadow: inset 2px 0 0 var(--gold-deep);
  }

  .marks__list b,
  .marks__list a {
    color: var(--bone);
  }

  .marks__list a:hover {
    color: var(--gold);
  }

  .marks__note {
    grid-column: 2;
    color: var(--ash);
    font-size: var(--fs-sm);
  }

  @media (max-width: 64rem) {
    .paths,
    .marks {
      grid-template-columns: 1fr;
    }

    .marks__note {
      grid-column: auto;
    }
  }

  @media (max-width: 48rem) {
    .marks__list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 40rem) {
    .crafts {
      grid-template-columns: 1fr;
    }

  }
</style>
