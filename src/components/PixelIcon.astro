---
import { ICONS, toRects, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className } = Astro.props;
const rects = toRects(ICONS[name]);
---
<span class:list={['slot', className]} aria-hidden="true">
  <svg viewBox="0 0 16 16" shape-rendering="crispEdges">
    {rects.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" fill={r.fill} />)}
  </svg>
</span>

<style>
  /* Ячейка инвентаря: тёмная, с фаской сверху-слева и светлым краем снизу-справа. */
  .slot {
    display: inline-grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    flex: none;
    background: #2a2e3a;
    border: 3px solid;
    border-color: #121318 #4b5164 #4b5164 #121318;
  }

  .slot svg {
    width: 2.5rem;
    height: 2.5rem;
  }
</style>
