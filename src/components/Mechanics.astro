---
import Pixel from './Pixel.astro';
import { GLYPHS } from '../lib/emblems';
import { url } from '../lib/url';

// Глаза в темноте: [x, y, цвет, задержка моргания в секундах]
const eyes: Array<[number, number, string, number]> = [
  [86, 214, '#ff5c4d', 0.4],
  [94, 226, '#ff5c4d', 0.4],
  [176, 238, '#c9a2ff', 2.6],
  [262, 206, '#ffb347', 1.3],
  [330, 246, '#ff5c4d', 3.4],
  [338, 234, '#ff5c4d', 3.4],
  [404, 222, '#e9eef8', 0.9],
  [40, 252, '#ffb347', 4.1],
];

// Мёртвые деревья: [x, высота ствола, ветви: [dx, dy, ширина]]
const trees: Array<[number, number, Array<[number, number, number]>]> = [
  [24, 150, [[-24, 40, 24], [8, 64, 28], [-16, 96, 16]]],
  [132, 120, [[8, 30, 32], [-28, 52, 28], [8, 84, 20]]],
  [228, 168, [[-32, 36, 32], [8, 70, 36], [-20, 110, 20]]],
  [372, 140, [[8, 32, 28], [-36, 60, 36], [8, 98, 24]]],
  [452, 110, [[-24, 36, 24], [8, 70, 20]]],
];
const treeRects: string = trees
  .map(([x, h, branches]) => {
    const trunk = `M${x} ${300 - h}h12v${h}h-12z`;
    const br = branches
      .map(([dx, dy, w]) => `M${dx < 0 ? x + dx : x + 12} ${300 - h + dy}h${w}v8h${-w}z`)
      .join('');
    return trunk + br;
  })
  .join('');

const frames = ['fighter', 'miner', 'cleric', 'scout', 'survivor', 'archer', 'bard', 'hermit'] as const;
---
<section class="mech section" id="mechanics" aria-labelledby="mech-title">
  <div class="wrap">
    <header class="section-head">
      <h2 class="section-title" id="mech-title">Что вас ждёт</h2>
      <p class="section-lead">
        Персонаж растёт от того, чем вы занимаетесь: навыки, профессии, раса и класс качаются параллельно. Чем дальше
        уходите от точки появления, тем сильнее мобы.
      </p>
    </header>

    <div class="mech__split">
      <section class="day" aria-labelledby="day-title">
        <h3 class="mech__h" id="day-title">Растёте и зарабатываете</h3>
        <dl class="list">
          <div>
            <dt>Навыки, мана и способности</dt>
            <dd>11 навыков AuraSkills, у каждого до 100 уровней. С уровнем растут характеристики и открываются способности.</dd>
          </div>
          <div>
            <dt>Гильдии платят золотом</dt>
            <dd>12 профессий: шахтёр, лесоруб, охотник, рыбак, кузнец и другие. Плата за каждое засчитанное действие, вступить можно сразу в три.</dd>
          </div>
          <div>
            <dt>Магазин</dt>
            <dd>Продать добытое и купить нужное через меню <code>/shop</code>.</dd>
          </div>
          <div>
            <dt>Главное меню</dt>
            <dd><code>/menu</code> ведёт к навыкам, профессиям, магазину и телепортам.</dd>
          </div>
        </dl>
        <div class="xp" aria-hidden="true">
          <span class="xp__bar"><span class="xp__fill"></span></span>
        </div>
      </section>

      <section class="night" aria-labelledby="night-title">
        <svg class="night__art" viewBox="0 0 480 300" aria-hidden="true" shape-rendering="crispEdges">
          <g class="night__moon">
            <rect x="392" y="24" width="40" height="40" fill="#a8252f" />
            <rect x="400" y="32" width="8" height="8" fill="#7d1822" />
            <rect x="416" y="40" width="8" height="8" fill="#7d1822" />
            <rect x="404" y="52" width="8" height="8" fill="#7d1822" />
          </g>
          <path d={treeRects} fill="#050608" />
          <rect x="0" y="292" width="480" height="8" fill="#050608" />
          {eyes.map(([x, y, c, d]) => (
            <g class="eye" style={`--d:${d}s`}>
              <rect x={x} y={y} width="6" height="4" fill={c} />
              <rect x={x + 12} y={y} width="6" height="4" fill={c} />
            </g>
          ))}
        </svg>
        <h3 class="mech__h" id="night-title">За стенами опасно</h3>
        <dl class="list">
          <div>
            <dt>Уровни мобов</dt>
            <dd>От 1 до 50. Чем дальше от точки появления и чем глубже, тем выше уровень, а с ним здоровье, урон и добыча.</dd>
          </div>
          <div>
            <dt>Элитные мобы и боссы</dt>
            <dd>Ветераны, чемпионы, легендарные мобы и 17 именных боссов: Dread Knight, Headless Horseman, Abyss Watcher и другие.</dd>
          </div>
          <div>
            <dt>Ночные события</dt>
            <dd>С закатом может начаться ночь боссов, кровавая луна или нашествие криперов и пауков. Длится до утра.</dd>
          </div>
          <div>
            <dt>RPG-лут</dt>
            <dd>Предметы рангов от Uncommon до Legendary, новые зачарования и силы за отделку брони.</dd>
          </div>
        </dl>
      </section>
    </div>

    <section class="roads" aria-labelledby="roads-title">
      <h3 class="mech__h roads__title" id="roads-title">Куда идти</h3>
      <dl class="roads__list">
        <div>
          <dt>Замки и крепости</dt>
          <dd>Около сотни построек Grim Kingdoms: цитадели, форты, сторожевые башни и два королевства.</dd>
        </div>
        <div>
          <dt>Таверны</dt>
          <dd>Двенадцать вариантов под разные биомы. Картограф в таверне продаёт свитки-карты к данжам и другим тавернам.</dd>
        </div>
        <div>
          <dt>Подземелья</dt>
          <dd>Катакомбы и склепы, Запечатанные залы в Незере, замок Энда с мини-боссом, подземелья на глубине около Y −50.</dd>
        </div>
      </dl>
    </section>

    <section class="adv" aria-labelledby="adv-title">
      <div class="adv__frames" aria-hidden="true">
        {frames.map((id, i) => (
          <span class:list={['frame', `frame--${['task', 'goal', 'challenge'][i % 3]}`]}>
            <Pixel grid={GLYPHS[id]} />
          </span>
        ))}
      </div>
      <div class="adv__text">
        <h3 class="mech__h" id="adv-title">900+ достижений</h3>
        <p>
          Расширенное дерево BlazeandCave's: вкладки по темам, награды опытом, предметами и трофеями. Список в{' '}
          <a href={url('/docs/advancements/')}>документации</a>.
        </p>
      </div>
    </section>
  </div>
</section>

<style>
  .mech {
    background: var(--slate-0);
  }

  .mech__split {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    box-shadow: 0 0 0 1px var(--line);
  }

  .mech__h {
    font-size: var(--fs-lg);
    line-height: 1.1;
  }

  .list {
    display: grid;
    gap: 1.4rem;
    margin-top: 1.75rem;
  }

  .list dt,
  .roads__list dt {
    color: var(--bone);
    font-size: 1.1875rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .list dd,
  .roads__list dd {
    margin: 0.3rem 0 0;
    color: var(--bone-2);
    line-height: 1.55;
  }

  .mech code {
    color: var(--gold);
  }

  /* День: тёплый камень, свет факела сверху. */
  .day {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(1.75rem, 4vw, 3rem);
    background:
      radial-gradient(120% 70% at 30% 0%, rgb(237 163 60 / 0.12), transparent 60%),
      #1d1c20;
  }

  .xp {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 2.25rem;
  }

  /* Полоса опыта как в игре: сегменты и заполнение. */
  .xp__bar {
    position: relative;
    flex: 1;
    height: 12px;
    background:
      repeating-linear-gradient(90deg, transparent 0 calc(10% - 2px), #0b0c0f calc(10% - 2px) 10%),
      #23262e;
    box-shadow: inset 0 0 0 2px #0b0c0f;
  }

  .xp__fill {
    position: absolute;
    inset: 2px auto 2px 2px;
    width: 62%;
    background:
      repeating-linear-gradient(90deg, transparent 0 calc(16.13% - 2px), #0b0c0f calc(16.13% - 2px) 16.13%),
      linear-gradient(#a6f06f 0 50%, #6fbf3e 50%);
  }

  /* Ночь: почти чёрная, красная луна, глаза между деревьями. */
  .night {
    position: relative;
    padding: 0 clamp(1.75rem, 4vw, 3rem) clamp(1.75rem, 4vw, 3rem);
    background:
      linear-gradient(180deg, #0a0b12 0%, #050608 70%);
    overflow: hidden;
  }

  .night__art {
    display: block;
    max-width: none;
    width: calc(100% + 2 * clamp(1.75rem, 4vw, 3rem));
    height: auto;
    margin-inline: calc(-1 * clamp(1.75rem, 4vw, 3rem));
    margin-bottom: 1.5rem;
    background: radial-gradient(60% 80% at 88% 10%, rgb(168 37 47 / 0.28), transparent 70%);
  }

  .night__moon {
    filter: drop-shadow(0 0 10px rgb(200 40 50 / 0.7));
  }

  .night .list dd {
    color: #cfc7b3;
  }

  .eye {
    animation: blink 6s steps(1, end) infinite;
    animation-delay: var(--d);
  }

  @keyframes blink {
    0%, 92%, 100% { opacity: 1; }
    94%, 97% { opacity: 0; }
  }

  /* Дороги: широкая полоса в три колонки, разделённых швами кладки. */
  .roads {
    display: grid;
    grid-template-columns: minmax(12rem, 1fr) minmax(0, 3fr);
    gap: 1.5rem 3rem;
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-top: 2rem;
    border-top: 1px solid var(--line-2);
  }

  .roads__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem 2.25rem;
  }

  .roads__list > div {
    padding-left: 1.1rem;
    box-shadow: inset 2px 0 0 var(--slate-4);
  }

  /* Достижения: рамки как в игровом дереве достижений. */
  .adv {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: center;
    gap: 2rem 3.5rem;
    margin-top: clamp(3rem, 7vw, 5rem);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: #17171c;
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .adv__frames {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .frame {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    background: #2c2a24;
    box-shadow:
      inset 0 0 0 3px #0c0c0e,
      inset 3px 3px 0 3px #5a5546,
      inset -3px -3px 0 3px #1a1915;
  }

  .frame :global(.pixel) {
    width: 2.25rem;
    height: 2.25rem;
  }

  .frame--goal {
    border-radius: 30%;
    background: #2a2c36;
    box-shadow:
      inset 0 0 0 3px #0c0c0e,
      inset 3px 3px 0 3px #5b6074,
      inset -3px -3px 0 3px #17181f;
  }

  .frame--challenge {
    background: #3a2a12;
    clip-path: polygon(15% 0, 85% 0, 100% 15%, 100% 85%, 85% 100%, 15% 100%, 0 85%, 0 15%);
    box-shadow:
      inset 0 0 0 3px #0c0c0e,
      inset 3px 3px 0 3px #b98a2e,
      inset -3px -3px 0 3px #4a330c;
  }

  .adv__text p {
    margin-top: 0.6rem;
    color: var(--bone-2);
  }

  @media (max-width: 60rem) {
    .mech__split,
    .roads,
    .adv {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 44rem) {
    .roads__list {
      grid-template-columns: 1fr;
    }
  }
</style>
