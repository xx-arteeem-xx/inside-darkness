---
/**
 * Торг и вести: цена = база × вести × место × события. Все числа — из generated.json (раздел demand).
 */
import Block from './Block.astro';
import { G, fmt, times, pct, count } from '../data/game';
import { docHref } from '../lib/docs';

const tradeHref = await docHref('trade');
const pricesHref = await docHref('prices');
const D = G.demand;
const CATS = ['crops', 'fish', 'wood', 'ore', 'curio'] as const;

// Три вести для примера: самая щедрая, самая скупая и та, что двигает больше всего товаров.
const strongest = (dir: 'up' | 'down') =>
  [...D.news].sort((a, b) =>
    dir === 'up'
      ? Math.max(0, ...b.up.map((u) => u.mult)) - Math.max(0, ...a.up.map((u) => u.mult))
      : Math.min(2, ...a.down.map((u) => u.mult)) - Math.min(2, ...b.down.map((u) => u.mult)),
  )[0];
const picks = [strongest('up'), strongest('down')];
const busiest = [...D.news].filter((n) => !picks.includes(n)).sort((a, b) => b.up.length + b.down.length - (a.up.length + a.down.length))[0];
if (busiest) picks.push(busiest);

const tone = (v: number) => (v >= 1.15 ? 'hi' : v > 1.001 ? 'up' : v <= 0.85 ? 'lo' : v < 0.999 ? 'down' : 'mid');
const s = D.schemes[0];
---
<Block
  id="trade"
  title="Торг и вести"
  bg="#131216"
  lead={`Цены у купцов живые. По княжеству ходят вести — война, урожай, мор, стройка, — и раз в ${count(D.periodDays, ['игровой день', 'игровых дня', 'игровых дней'])} спрос меняется. Товар дешевле там, откуда он берётся, и дороже там, куда его надо везти. Кто следит за вестями и не ленится ездить, зарабатывает больше.`}
  links={[{ href: tradeHref, text: 'Как складывается цена' }, { href: pricesHref, text: 'Купцы и базовые цены' }]}
>
  <ol class="formula" role="list" aria-label="Из чего складывается цена">
    <li><b>База</b><span>цена товара</span></li>
    <li><b>Вести</b><span>{times(D.newsMin)}…{times(D.newsMax)}, по всему миру</span></li>
    <li><b>Место</b><span>{times(D.localMin)}…{times(D.localMax)}, от угодья к дальней деревне</span></li>
    <li><b>События</b><span>набег, павший хозяин подземелья</span></li>
  </ol>
  <p class="formula__note">Итог — от {times(D.clampMin)} до {times(D.clampMax)} базы. Надбавки ранга идут сверху.</p>

  <div class="trade">
    <section class="news" aria-labelledby="news-title">
      <h3 class="trade__sub" id="news-title">Какие бывают вести</h3>
      <ul class="news__list" role="list">
        {picks.map((n) => (
          <li class="notice">
            <p class="notice__title">{n.title}</p>
            <p class="notice__text">{n.text}</p>
            <p class="notice__moves">
              {n.up.map((u) => <span class="mv mv--up">▲ {u.cat} {times(u.mult)}</span>)}
              {n.down.map((u) => <span class="mv mv--down">▼ {u.cat} {times(u.mult)}</span>)}
            </p>
          </li>
        ))}
      </ul>
      <p class="trade__small">Всего вестей — {fmt(D.newsCount)}. Какая сейчас и что придёт следом — у любого ямщика и картографа, колокол «Вести».</p>
    </section>

    <section class="geo" aria-labelledby="geo-title">
      <h3 class="trade__sub" id="geo-title">Где что дороже</h3>
      <div class="geo__wrap" role="region" aria-label="Множители места, таблица прокручивается вбок" tabindex="0">
        <table class="geo__table">
          <thead>
            <tr>
              <th scope="col">Где продаёшь</th>
              {CATS.map((c) => <th scope="col">{D.names[c]}</th>)}
            </tr>
          </thead>
          <tbody>
            {D.places.map((p) => (
              <tr>
                <th scope="row">{p.name}</th>
                {CATS.map((c) => <td class={`t-${tone(p.cells[c].mult)}`}>{times(p.cells[c].mult)}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="trade__small">Множитель места без вестей. Скупщики у шахты, поля и сада платят {pct(D.siteFactor)} базы — место у них не в счёт.</p>
      {s && (
        <p class="scheme">
          <b>Пример.</b> {s.itemName[0].toUpperCase() + s.itemName.slice(1)}: у угодья — {fmt(s.sitePrice, 3)} за штуку, дороже всего — «{s.place}», {fmt(s.placePrice, 3)}.
          Разница — {times(s.gain)}, а удачная весть поднимет обе цены.
        </p>
      )}
    </section>
  </div>
</Block>

<style>
  .formula {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: clamp(2rem, 5vw, 3rem) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: f;
  }

  .formula li {
    position: relative;
    display: grid;
    gap: 0.2rem;
    padding: 0.9rem 1.1rem 1rem;
    background: #1d1b21;
    box-shadow: inset 0 0 0 2px #0b0b0e;
  }

  .formula li + li::before {
    content: '×';
    position: absolute;
    top: 50%;
    left: -0.65rem;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 1.3rem;
    height: 1.3rem;
    margin-top: -0.65rem;
    background: var(--torch);
    color: var(--ink);
    font-family: var(--font-pixel);
    font-size: 1rem;
  }

  .formula b {
    color: var(--gold);
    font-size: var(--fs-md);
  }

  .formula span {
    color: var(--ash);
    font-size: 0.9375rem;
  }

  .formula__note {
    margin-top: 0.75rem;
    color: var(--ash);
    font-size: var(--fs-sm);
  }

  .trade {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 2.5rem clamp(2rem, 5vw, 4rem);
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
  }

  .trade__sub {
    font-size: var(--fs-md);
  }

  .trade__small {
    margin-top: 0.9rem;
    color: var(--ash);
    font-size: var(--fs-sm);
  }

  .news__list {
    display: grid;
    gap: 0.9rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  /* Весть — как лист на доске у ямской станции. */
  .notice {
    display: grid;
    gap: 0.4rem;
    padding: 0.9rem 1.1rem 1rem;
    background: #e3d6b4;
    box-shadow:
      inset 0 0 0 2px #b9a77c,
      4px 4px 0 #0b0b0e;
    color: #2a2116;
  }

  .notice__title {
    font-weight: 700;
    font-size: 1.125rem;
  }

  .notice__text {
    font-size: 0.975rem;
    line-height: 1.45;
  }

  .notice__moves {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
    font-family: var(--font-pixel);
    font-size: 0.9375rem;
  }

  .mv--up {
    color: #1f6b33;
  }

  .mv--down {
    color: #8e2232;
  }

  .geo__wrap {
    margin-top: 1rem;
    overflow-x: auto;
  }

  .geo__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.975rem;
  }

  .geo__table th,
  .geo__table td {
    padding: 0.5rem 0.55rem;
    border-bottom: 1px solid var(--line);
    text-align: right;
    white-space: nowrap;
  }

  .geo__table th[scope='row'],
  .geo__table thead th:first-child {
    text-align: left;
    white-space: normal;
  }

  .geo__table thead th {
    color: var(--ash);
    font-weight: 400;
  }

  .geo__table td {
    font-family: var(--font-pixel);
  }

  .t-hi {
    background: rgb(237 163 60 / 0.28);
    color: var(--gold);
  }

  .t-up {
    background: rgb(237 163 60 / 0.12);
    color: var(--bone);
  }

  .t-mid {
    color: var(--ash);
  }

  .t-down {
    background: rgb(53 56 69 / 0.45);
    color: var(--ash);
  }

  .t-lo {
    background: rgb(53 56 69 / 0.8);
    color: var(--ash-2);
  }

  .scheme {
    margin-top: 1.25rem;
    padding: 0.9rem 1.1rem;
    box-shadow: inset 2px 0 0 var(--torch);
    background: rgb(237 163 60 / 0.06);
    color: var(--bone-2);
  }

  .scheme b {
    color: var(--bone);
  }

  @media (max-width: 64rem) {
    .trade {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 44rem) {
    .formula {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }

    .formula li + li::before {
      display: none;
    }
  }
</style>
