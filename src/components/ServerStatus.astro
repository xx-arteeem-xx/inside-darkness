---
import { SERVER } from '../config/site';
---
<div class="status" data-server-status data-state="loading" data-api={SERVER.liveApi}>
  <span class="status__dot" aria-hidden="true"></span>
  <div class="status__body">
    <p class="status__text" data-status-text role="status" aria-live="polite">Проверяю, запущен ли сервер…</p>
    <p class="status__meta" data-status-meta hidden></p>
    <noscript>
      <p class="status__text">Статус показывается с включённым JavaScript. Адрес выше от этого не зависит.</p>
    </noscript>
  </div>
  <button type="button" class="status__retry" data-status-retry hidden>Проверить снова</button>
</div>

<style>
  .status {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 0.25rem 0.75rem;
    font-family: var(--font-ui);
    font-size: 1.0625rem;
    line-height: 1.4;
  }

  .status__dot {
    width: 0.75rem;
    height: 0.75rem;
    margin-top: 0.35rem;
    background: var(--iron-dim);
    box-shadow: 0 0 0 3px rgb(0 0 0 / 0.25);
  }

  .status[data-state='online'] .status__dot {
    background: var(--moss);
    box-shadow: 0 0 0 3px rgb(143 202 165 / 0.2), 0 0 12px rgb(143 202 165 / 0.6);
  }

  .status[data-state='offline'] .status__dot {
    background: #5d6170;
  }

  .status[data-state='error'] .status__dot {
    background: var(--redstone);
  }

  .status[data-state='loading'] .status__dot {
    animation: blink 1.1s steps(2, jump-none) infinite;
  }

  .status__text {
    color: var(--bone);
  }

  .status__meta {
    color: var(--iron);
    font-size: 0.9375rem;
  }

  .status__retry {
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--bone);
    font: inherit;
    font-size: 0.9375rem;
    cursor: pointer;
  }

  .status__retry:hover {
    border-color: var(--torch);
    color: var(--torch-soft);
  }

  @keyframes blink {
    from { opacity: 1; }
    to { opacity: 0.25; }
  }
</style>

<script>
  const TIMEOUT_MS = 10000;

  function plural(n: number): string {
    const m10 = n % 10;
    const m100 = n % 100;
    if (m10 === 1 && m100 !== 11) return 'игрок';
    if (m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14)) return 'игрока';
    return 'игроков';
  }

  function render(root: HTMLElement, state: string, text: string, meta = '', retry = false) {
    root.dataset.state = state;
    const t = root.querySelector<HTMLElement>('[data-status-text]');
    const m = root.querySelector<HTMLElement>('[data-status-meta]');
    const r = root.querySelector<HTMLButtonElement>('[data-status-retry]');
    if (t) t.textContent = text;
    if (m) {
      m.textContent = meta;
      m.hidden = !meta;
    }
    if (r) r.hidden = !retry;
  }

  async function check(root: HTMLElement) {
    const api = root.dataset.api;
    if (!api) return;
    render(root, 'loading', 'Проверяю, запущен ли сервер…');

    const ctrl = new AbortController();
    const timer = window.setTimeout(() => ctrl.abort(), TIMEOUT_MS);
    try {
      let data: { players?: Array<{ name?: string }> } | null = null;
      try {
        const res = await fetch(api, { signal: ctrl.signal, cache: 'no-store' });
        if (res.ok) data = await res.json();
      } catch (err) {
        if (err instanceof DOMException && err.name === 'AbortError') throw err;
        data = null; // заглушка exaroton без CORS или не JSON — сервер спит
      }
      if (data && Array.isArray(data.players)) {
        const names = data.players.map((p) => p.name).filter(Boolean) as string[];
        const on = names.length;
        const text = on ? `Сервер запущен. Сейчас ${on} ${plural(on)}.` : 'Сервер запущен, можно заходить.';
        const meta = on ? `В игре: ${names.slice(0, 5).join(', ')}${on > 5 ? ' и другие' : ''}.` : '';
        render(root, 'online', text, meta);
      } else {
        render(root, 'offline', 'Сервер сейчас выключен. На хостинге exaroton он засыпает, когда в игре никого нет.');
      }
    } catch (err) {
      render(root, 'error', 'Статус не загрузился: сервер не ответил за 10 секунд.',
        'Адрес от этого не меняется, можно попробовать зайти из игры.', true);
    } finally {
      window.clearTimeout(timer);
    }
  }

  document.querySelectorAll<HTMLElement>('[data-server-status]').forEach((root) => {
    check(root);
    root.querySelector('[data-status-retry]')?.addEventListener('click', () => check(root));
  });
</script>
