---
import CopyButton from './CopyButton.astro';
import { SERVER, CABINET_URL } from '../config/site';
import { url } from '../lib/url';
import { MAP } from '../lib/map';

// Диск края на обзорной карте: 768 точек на сторону, центр — середина.
const V = 768;
const c = MAP.center[0] * V;
const r = (n: number) => (n * V).toFixed(1);
const wallPoints = MAP.wall.map(([u, v]) => `${r(u)},${r(v)}`).join(' ');
// Подписи по дуге: Стена — по своей линии, тёмные земли — посередине между Стеной и краем мира.
const wallR = Math.hypot(MAP.wall[0][0] - 0.5, MAP.wall[0][1] - 0.5);
const darkR = (wallR + MAP.border) / 2;
const arc = (rad: number, from: number, to: number) => {
  const a0 = (from * Math.PI) / 180;
  const a1 = (to * Math.PI) / 180;
  const R = rad * V;
  const p = (a: number) => `${(c + R * Math.cos(a)).toFixed(1)} ${(c + R * Math.sin(a)).toFixed(1)}`;
  return `M${p(a0)} A${R.toFixed(1)} ${R.toFixed(1)} 0 0 1 ${p(a1)}`;
};
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__map" aria-hidden="true">
    <div class="hero__disc">
      <img
        src={url('/map/0.webp')}
        alt=""
        width={V}
        height={V}
        fetchpriority="high"
        decoding="async"
      />
      <svg viewBox={`0 0 ${V} ${V}`} class="hero__ring">
        <defs>
          <path id="arc-dark" d={arc(darkR, 200, 290)} />
          <path id="arc-wall" d={arc(wallR + 0.012, 300, 352)} />
          <radialGradient id="hero-vignette" cx="0.5" cy="0.5" r="0.5">
            <stop offset="0.6" stop-color="#07090f" stop-opacity="0" />
            <stop offset="1" stop-color="#07090f" stop-opacity="0.85" />
          </radialGradient>
        </defs>
        <rect width={V} height={V} fill="url(#hero-vignette)" />
        <polygon class="hero__wall-glow" points={wallPoints} />
        <polygon class="hero__wall" points={wallPoints} pathLength="1" />
        <text class="hero__arc hero__arc--dark"><textPath href="#arc-dark" startOffset="50%" text-anchor="middle">Тёмные земли</textPath></text>
        <text class="hero__arc hero__arc--wall"><textPath href="#arc-wall" startOffset="50%" text-anchor="middle">Большая стена</textPath></text>
        <g class="hero__capital" transform={`translate(${r(MAP.center[0])} ${r(MAP.center[1])})`}>
          <rect x="-4" y="-4" width="8" height="8" />
          <text x="10" y="-8">Столица</text>
        </g>
      </svg>
    </div>
  </div>

  <div class="hero__body">
    <h1 class="hero__title" id="hero-title">
      <span class="hero__name">Inside Darkness</span>
      <span class="hero__genre">MMORPG</span>
    </h1>
    <p class="hero__tagline">Последний обжитой край посреди тьмы</p>
    <p class="hero__lead">
      Русский сервер Minecraft, устроенный как настоящая MMORPG, — без модов и без команд. Ремесло и торг кормят,
      ранги и качество вещей растят силу, хозяева подземелий ждут дружину, а за Большой стеной лежат тёмные земли.
    </p>

    <div class="plate">
      <p class="plate__label" id="address-label">Адрес для Java Edition {SERVER.versions}</p>
      <div class="plate__row">
        <code class="plate__addr" id="server-address" aria-labelledby="address-label">{SERVER.address}</code>
        <CopyButton text={SERVER.address} target="server-address" label="Скопировать" done="Адрес скопирован" />
      </div>
      <p class="plate__note">Подходит и лицензия, и пиратский клиент: вход по паролю на самом сервере.</p>
    </div>

    <div class="hero__actions">
      <a class="btn btn--ember" href={url('/#join')}>Как зайти</a>
      <a class="btn btn--quiet" href={CABINET_URL}>Личный кабинет</a>
      <a class="more" href={url('/guide/')}>Гайд по краю</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-height: min(100vh, 62rem);
    padding: 7.5rem var(--gutter) 4rem;
    overflow: hidden;
    background:
      radial-gradient(ellipse 60% 70% at 72% 48%, rgb(194 51 69 / 0.1), transparent 70%),
      var(--void);
  }

  /* ——— диск края ——— */
  .hero__map {
    position: absolute;
    z-index: -1;
    top: 50%;
    right: max(-14rem, calc(50% - 50rem));
    width: min(58rem, 112vh);
    transform: translateY(-50%);
  }

  .hero__disc {
    position: relative;
    aspect-ratio: 1;
  }

  .hero__disc img,
  .hero__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero__disc img {
    image-rendering: pixelated;
  }

  .hero__wall,
  .hero__wall-glow {
    fill: none;
    stroke-linejoin: round;
  }

  .hero__wall-glow {
    stroke: rgb(194 51 69 / 0.4);
    stroke-width: 9;
    filter: blur(1.5px);
  }

  .hero__wall {
    stroke: #f0c4ae;
    stroke-width: 2;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .hero__arc {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 17px;
    letter-spacing: 0.22em;
  }

  .hero__arc--dark {
    fill: rgb(214 170 190 / 0.55);
  }

  .hero__arc--wall {
    fill: #f0c4ae;
    font-size: 14px;
  }

  .hero__capital rect {
    fill: var(--gold);
    stroke: #000;
    stroke-width: 2;
  }

  .hero__capital text {
    fill: var(--bone);
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 17px;
    paint-order: stroke;
    stroke: #07090f;
    stroke-width: 4px;
  }

  /* Одна сцена при загрузке: Стена обходит край по кругу. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__wall {
      animation: wall-draw 2.4s cubic-bezier(0.6, 0, 0.2, 1) 0.2s both;
    }

    .hero__wall-glow {
      animation: glow-in 1.2s ease 2s both;
    }

    @keyframes wall-draw {
      from { stroke-dashoffset: 1; }
      to { stroke-dashoffset: 0; }
    }

    @keyframes glow-in {
      from { opacity: 0; }
      to { opacity: 1; }
    }
  }

  /* ——— текст ——— */
  .hero__body {
    position: relative;
    align-self: center;
    width: 100%;
    max-width: calc(var(--wrap) - 2 * var(--gutter));
    margin-inline: auto;
  }

  .hero__body > * {
    max-width: 36rem;
  }

  .hero__title {
    display: grid;
    justify-items: start;
    gap: 0.9rem;
    max-width: none;
  }

  .hero__name {
    color: var(--ember);
    font-size: var(--fs-hero);
    font-weight: 900;
    line-height: 0.86;
    letter-spacing: -0.04em;
    text-shadow: 0 0.035em 0 #3a0a12, 0 0 0.6em rgb(194 51 69 / 0.25);
  }

  .hero__genre {
    padding: 0.3rem 0.65rem 0.35rem;
    background: rgb(7 9 15 / 0.7);
    box-shadow: inset 0 0 0 2px var(--ember-deep), inset 0 0 0 4px rgb(0 0 0 / 0.6);
    color: var(--bone);
    font-family: var(--font-pixel);
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    font-weight: 400;
    letter-spacing: 0.18em;
    line-height: 1;
  }

  .hero__tagline {
    margin-top: 1.6rem;
    color: var(--bone);
    font-size: var(--fs-lg);
    font-weight: 700;
    line-height: 1.2;
    text-wrap: balance;
  }

  .hero__lead {
    margin-top: 1rem;
    color: var(--bone-2);
    font-size: var(--fs-md);
    line-height: 1.5;
  }

  .plate {
    margin-top: 2rem;
  }

  .plate__label {
    margin-bottom: 0.5rem;
    color: var(--ash);
    font-size: 1rem;
  }

  .plate__row {
    display: flex;
    align-items: center;
    gap: 0.75rem 1rem;
    padding: 0.5rem 0.5rem 0.5rem 1.1rem;
    background: rgb(5 6 10 / 0.82);
    box-shadow: inset 0 0 0 2px #3b4156, inset 0 0 0 4px rgb(0 0 0 / 0.6);
  }

  .plate__addr {
    flex: 1 1 auto;
    min-width: 0;
    color: var(--gold);
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    line-height: 1.2;
    overflow-wrap: anywhere;
    user-select: all;
  }

  .plate__note {
    margin-top: 0.6rem;
    color: var(--ash);
    font-size: 1rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 1.75rem;
  }

  /* Невысокий экран ноутбука: адрес и кнопки должны попасть в первый экран. */
  @media (min-width: 64rem) and (max-height: 50rem) {
    .hero {
      padding-top: 5.5rem;
      padding-bottom: 2.5rem;
    }

    .hero__map {
      width: min(52rem, 104vh);
    }

    .hero__name {
      font-size: clamp(3.5rem, 13.5vh, 7rem);
    }

    .hero__title {
      gap: 0.7rem;
    }

    .hero__tagline {
      margin-top: 1.1rem;
      font-size: clamp(1.375rem, 3.6vh, 1.75rem);
    }

    .hero__lead {
      margin-top: 0.7rem;
      font-size: 1.125rem;
    }

    .plate {
      margin-top: 1.25rem;
    }

    .hero__actions {
      margin-top: 1.25rem;
    }
  }

  @media (max-width: 64rem) {
    .hero {
      min-height: 0;
      padding-top: 0;
    }

    .hero__map {
      position: relative;
      top: auto;
      right: auto;
      width: min(40rem, 118vw);
      margin: 5.5rem auto -32% max(-9vw, calc(50% - 20rem));
      transform: none;
      -webkit-mask-image: linear-gradient(180deg, #000 55%, transparent 92%);
      mask-image: linear-gradient(180deg, #000 55%, transparent 92%);
    }

    .hero__body > * {
      max-width: 40rem;
    }
  }

  @media (max-width: 40rem) {
    .hero__map {
      margin-top: 6.5rem;
      margin-left: -9vw;
    }

    .hero__arc {
      font-size: 24px;
    }

    .plate__row {
      flex-direction: column;
      align-items: stretch;
      padding: 0.9rem;
    }

    .plate__row :global(.copy),
    .plate__row :global(.btn) {
      width: 100%;
    }
  }
</style>
