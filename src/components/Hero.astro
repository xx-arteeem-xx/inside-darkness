---
import CopyButton from './CopyButton.astro';
import ServerStatus from './ServerStatus.astro';
import { SERVER } from '../config/site';
import { url } from '../lib/url';
import { buildCapital, W, H } from '../lib/art/capital';
import { START_COINS } from '../data/game';

const art = buildCapital();

const FILL: Record<string, string> = {
  ridge2: '#19213a',
  ridge1: '#121829',
  sea: '#0d1426',
  wave: '#1f2b49',
  house: '#1b1d26',
  roofW: '#3b1821',
  roofWrim: '#5e2532',
  roofS: '#252836',
  roofSrim: '#3b4054',
  temple: '#1e2029',
  templeRim: '#363b4e',
  pole: '#5c5648',
  deep: 'url(#pat-deep)',
  deepRim: '#353a4e',
  deepBand: '#262833',
  flag: '#8e2232',
  flagRim: '#b8323f',
  banner: '#e0a845',
  wall: 'url(#pat-wall)',
  wallTop: '#3a4054',
  rim: '#3a4157',
  shade: '#15171e',
  slit: '#07080b',
  gate: 'url(#gate-light)',
  grate: '#2a1d10',
  water: '#0b1120',
  ground: '#101014',
  grass: '#171a21',
  bush: '#13151b',
  bridge: '#252832',
  bridgeRim: '#3b4052',
  arch: '#0b1120',
  cottage: '#1c1e27',
};

// Квадратная луна 6×6 клеток: светлые и чуть темнее «кратеры».
const craters = [[1, 1], [2, 1], [4, 2], [1, 3], [3, 4], [4, 4], [2, 4]];
---
<section class="hero" id="server" aria-labelledby="hero-title">
  <div class="hero__sky" aria-hidden="true">
    <svg class="hero__stars" viewBox="0 0 1600 600" preserveAspectRatio="xMidYMin slice" shape-rendering="crispEdges">
      <path d={art.sky} fill="#d9d3c2" opacity="0.45" />
      <path d={art.skyBright} fill="#f3eddc" opacity="0.8" />
    </svg>
    <svg class="hero__moon" viewBox="0 0 48 48" shape-rendering="crispEdges">
      <rect width="48" height="48" fill="#eae3cf" />
      {craters.map(([cx, cy]) => <rect x={cx * 8} y={cy * 8} width="8" height="8" fill="#cdc5ae" />)}
    </svg>
  </div>

  <div class="wrap hero__content">
    <p class="hero__kicker">Средневековый сервер Minecraft</p>
    <h1 class="hero__title" id="hero-title"><span>Inside</span> <span>Darkness</span></h1>
    <p class="hero__lead">
      Заработай и прокачайся в тёмном средневековом государстве за Большой стеной.
    </p>
    <p class="hero__sub">
      Копай руду, собирай урожай, охоться в подземельях. Купцы на рынке платят монетами, мастера в деревне дают ранги
      в ремёслах. Всё делается у живых NPC, команд почти нет.
    </p>

    <ul class="hero__stats" role="list">
      <li><b>{START_COINS}</b> монет на старте</li>
      <li><b>4</b> народа</li>
      <li><b>6</b> ремёсел</li>
      <li><b>5</b> подземелий</li>
    </ul>

    <div class="plate">
      <p class="plate__label" id="address-label">Адрес для Java Edition {SERVER.versions}</p>
      <div class="plate__row">
        <code class="plate__addr" id="server-address" aria-labelledby="address-label">{SERVER.address}</code>
        <CopyButton text={SERVER.address} target="server-address" label="Скопировать адрес" done="Адрес скопирован" />
      </div>
    </div>

    <ServerStatus />

    <p class="hero__facts">
      Пиратские клиенты пускаются. Моды не нужны, ресурспак сервер выдаёт сам.{' '}
      <a class="hero__how" href={url('/#join')}>Как зайти</a>
      <span aria-hidden="true"> · </span>
      <a class="hero__how" href={url('/#how')}>Как устроена игра</a>
    </p>
  </div>

  <div class="hero__art" aria-hidden="true">
    <div class="pano">
      <svg class="pano__layer pano__layer--far" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" shape-rendering="crispEdges">
        <defs>
          <radialGradient id="haze" cx="0.62" cy="0.78" r="0.5">
            <stop offset="0" stop-color="#eda33c" stop-opacity="0.16" />
            <stop offset="0.55" stop-color="#eda33c" stop-opacity="0.05" />
            <stop offset="1" stop-color="#eda33c" stop-opacity="0" />
          </radialGradient>
        </defs>
        <rect x="200" y="180" width="1400" height="460" fill="url(#haze)" shape-rendering="auto" />
        {art.far.map((p) => <path d={p.d} fill={FILL[p.key]} />)}
      </svg>

      <svg class="pano__layer pano__layer--city" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" shape-rendering="crispEdges">
        <defs>
          <pattern id="pat-wall" width="24" height="12" patternUnits="userSpaceOnUse">
            <rect width="24" height="12" fill="#20232d" />
            <path d="M0 0h24v2H0zM0 6h24v2H0zM0 0h2v6H0zM12 6h2v6h-2z" fill="#1a1c24" />
            <path d="M4 2h6v2H4zM16 8h6v2h-6z" fill="#252833" />
          </pattern>
          <pattern id="pat-deep" width="16" height="8" patternUnits="userSpaceOnUse">
            <rect width="16" height="8" fill="#1a1b23" />
            <path d="M0 0h16v2H0zM0 0h2v4H0zM8 4h2v4H8z" fill="#121318" />
            <path d="M0 4h16v1H0z" fill="#121318" />
            <path d="M3 2h4v1H3zM11 5h4v1h-4z" fill="#22232d" />
          </pattern>
          <linearGradient id="gate-light" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#3a220c" />
            <stop offset="0.6" stop-color="#b8701f" />
            <stop offset="1" stop-color="#f2b04a" />
          </linearGradient>
          <radialGradient id="torch-glow">
            <stop offset="0" stop-color="#f4b350" stop-opacity="0.55" />
            <stop offset="0.4" stop-color="#eda33c" stop-opacity="0.18" />
            <stop offset="1" stop-color="#eda33c" stop-opacity="0" />
          </radialGradient>
        </defs>
        {art.back.map((p) => <path d={p.d} fill={FILL[p.key]} />)}
        <path d={art.dark} fill="#0b0c11" />
        <g class="windows">
          {art.windows.map((d, i) => <path class="win" d={d} style={`--i:${i}`} />)}
        </g>
        {art.front.map((p) => <path d={p.d} fill={FILL[p.key]} />)}
        {[0, 1, 2].map((g) => (
          <g class:list={['torch', `torch--${g}`]}>
            {art.torches.filter((t) => t.g === g).map((t) => (
              <circle cx={t.x + 2} cy={t.y + 2} r="26" fill="url(#torch-glow)" shape-rendering="auto" />
            ))}
            <path
              fill="#f2a83e"
              d={art.torches.filter((t) => t.g === g).map((t) => `M${t.x - 1} ${t.y}h6v6h-6z`).join('')}
            />
            <path
              fill="#fff1c4"
              d={art.torches.filter((t) => t.g === g).map((t) => `M${t.x + 1} ${t.y + 2}h2v3h-2z`).join('')}
            />
            <path
              fill="#4d3418"
              d={art.torches.filter((t) => t.g === g).map((t) => `M${t.x + 1} ${t.y + 6}h2v10h-2z`).join('')}
            />
          </g>
        ))}
      </svg>

      <svg class="pano__layer pano__layer--fore" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" shape-rendering="crispEdges">
        {art.fore.map((p) => <path d={p.d} fill={FILL[p.key]} />)}
      </svg>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: linear-gradient(180deg, #05070e 0%, #0a0f1d 30%, #121a30 62%, #1c2543 88%, #1c2543 100%);
    /* --pw: ширина панорамы, не уже экрана; высота по пропорции 1600×640 */
    container-type: inline-size;
    --pw: max(100vw, 46rem);
    --ph: calc(var(--pw) / 2.5);
    --overlap: 0.08;
    --focus: 0.64;
    --anchor: 0.56;
  }

  @supports (width: 1cqw) {
    .hero {
      --pw: max(100cqw, 46rem);
    }
  }

  .hero__sky {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__stars {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero__moon {
    position: absolute;
    top: clamp(6.5rem, 14vh, 9rem);
    right: clamp(1.5rem, 12vw, 14rem);
    width: clamp(2.5rem, 3.4vw, 3.5rem);
    height: auto;
    filter: drop-shadow(0 0 1.75rem rgb(234 227 207 / 0.38));
  }

  .hero__content {
    position: relative;
    z-index: 2;
    padding-top: clamp(7.5rem, 15vh, 9.5rem);
  }

  .hero__kicker {
    margin-bottom: 1rem;
    color: var(--torch);
    font-family: var(--font-pixel);
    font-size: 1rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hero__title {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.25em;
    font-size: var(--fs-hero);
    font-weight: 900;
    line-height: 0.84;
    letter-spacing: -0.035em;
    color: var(--bone);
    text-shadow: 0 0.04em 0 rgb(0 0 0 / 0.35);
  }

  .hero__title span {
    display: block;
  }

  .hero__lead {
    max-width: 34rem;
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    color: var(--bone);
    font-size: var(--fs-lg);
    font-weight: 700;
    line-height: 1.22;
    text-wrap: balance;
  }

  .hero__sub {
    max-width: 34rem;
    margin-top: 0.9rem;
    color: var(--bone-2);
    font-size: var(--fs-md);
    line-height: 1.45;
  }

  /* Цифры-факты: плашки как подписи в игровом интерфейсе. */
  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    max-width: 38rem;
    margin: 1.6rem 0 0;
    padding: 0;
    list-style: none;
  }

  .hero__stats li {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    padding: 0.3rem 0.7rem 0.35rem;
    background: rgb(5 6 10 / 0.6);
    box-shadow: inset 0 0 0 2px var(--slate-3);
    color: var(--bone-2);
    font-size: 1rem;
    line-height: 1.3;
  }

  .hero__stats b {
    color: var(--gold);
    font-family: var(--font-pixel);
    font-size: 1.125rem;
    font-weight: 400;
  }

  .plate {
    max-width: 38rem;
    margin-top: 2rem;
  }

  .plate__label {
    margin-bottom: 0.5rem;
    color: var(--ash);
    font-size: 1rem;
  }

  .plate__row {
    display: flex;
    align-items: center;
    gap: 0.75rem 1rem;
    padding: 0.5rem 0.5rem 0.5rem 1.1rem;
    background: rgb(5 6 10 / 0.72);
    box-shadow:
      inset 0 0 0 2px #3b4156,
      inset 0 0 0 4px rgb(0 0 0 / 0.6);
  }

  .plate__addr {
    flex: 1 1 auto;
    min-width: 0;
    color: var(--gold);
    font-size: 1.5rem;
    line-height: 1.2;
    overflow-wrap: anywhere;
    user-select: all;
  }

  .hero :global(.status) {
    max-width: 38rem;
    margin-top: 1.1rem;
  }

  .hero__facts {
    max-width: 38rem;
    margin-top: 1.1rem;
    color: var(--ash);
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  .hero__how {
    color: var(--bone);
    font-weight: 700;
    white-space: nowrap;
    text-decoration-color: var(--gold-deep);
  }

  .hero__how:hover {
    color: var(--gold);
    text-decoration-color: var(--gold);
  }

  /* ——— панорама ——— */
  .hero__art {
    position: relative;
    z-index: 1;
    height: var(--ph);
    margin-top: calc(var(--ph) * var(--overlap) * -1 + 2rem);
    pointer-events: none;
  }

  .pano {
    position: absolute;
    bottom: 0;
    width: var(--pw);
    height: var(--ph);
    /* точка --focus картинки встаёт в точку --anchor экрана, края не уходят внутрь */
    left: clamp(calc(100% - var(--pw)), calc(100% * var(--anchor) - var(--pw) * var(--focus)), 0px);
  }

  .pano__layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .win {
    fill: #f2b04a;
    animation: win-on 0.4s steps(2, end) both;
    animation-delay: calc(var(--i) * 180ms + 400ms);
  }

  .windows {
    filter: drop-shadow(0 0 3px rgb(242 176 74 / 0.75));
  }

  @keyframes win-on {
    from { fill: #0b0c11; }
    to { fill: #f2b04a; }
  }

  .torch {
    animation: flicker 2.3s steps(6, end) infinite;
  }

  .torch--1 {
    animation-duration: 1.9s;
    animation-delay: -0.7s;
  }

  .torch--2 {
    animation-duration: 2.7s;
    animation-delay: -1.3s;
  }

  .hero[data-paused] .torch {
    animation-play-state: paused;
  }

  @keyframes flicker {
    0%, 100% { opacity: 1; }
    18% { opacity: 0.82; }
    34% { opacity: 1; }
    52% { opacity: 0.74; }
    70% { opacity: 0.95; }
    84% { opacity: 0.86; }
  }

  @media (prefers-reduced-motion: reduce) {
    .win,
    .torch {
      animation: none;
    }
  }

  /* Глубина при прокрутке: дальние слои отстают. Только если браузер умеет scroll-timeline
     и человек не просил убрать движение. */
  @media (prefers-reduced-motion: no-preference) and (min-width: 48rem) {
    @supports (animation-timeline: scroll()) {
      .hero__stars,
      .hero__moon,
      .pano__layer--far,
      .pano__layer--city {
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }

      .hero__stars { animation-name: sink-stars; }
      .hero__moon { animation-name: sink-moon; }
      .pano__layer--far { animation-name: sink-far; }
      .pano__layer--city { animation-name: sink-city; }

      @keyframes sink-stars { to { transform: translateY(22vh); } }
      @keyframes sink-moon { to { transform: translateY(26vh); } }
      @keyframes sink-far { to { transform: translateY(14%); } }
      @keyframes sink-city { to { transform: translateY(6%); } }
    }
  }

  /* Широкий экран: текст слева на фоне неба, город встаёт под ним и справа. */
  @media (min-width: 64rem) {
    .hero {
      --overlap: 0.46;
      --focus: 0.5;
      --anchor: 0.5;
    }

    .hero__art {
      margin-top: calc(var(--ph) * var(--overlap) * -1);
    }

    .plate__addr {
      white-space: nowrap;
    }
  }

  /* Ноутбук: колонка текста широкая относительно экрана, поэтому панорама шире экрана
     и донжон уезжает вправо, чтобы не встать за адресом. */
  @media (min-width: 64rem) and (max-width: 82rem) {
    .hero {
      --pw: max(100vw, 82rem);
      --focus: 0.64;
      --anchor: 0.8;
    }

    @supports (width: 1cqw) {
      .hero {
        --pw: max(100cqw, 82rem);
      }
    }
  }

  @media (max-width: 40rem) {
    /* Луна уходит к короткой строке «Inside», чтобы не наезжать на подпись. */
    .hero__moon {
      top: 10.75rem;
      right: 1.5rem;
      width: 2.25rem;
    }

    .plate__row {
      flex-direction: column;
      align-items: stretch;
      padding: 0.9rem;
    }

    .plate__addr {
      font-size: 1.25rem;
    }

    .plate__row :global(.copy),
    .plate__row :global(.btn) {
      width: 100%;
    }
  }
</style>

<script>
  // Факелы не мерцают, пока шапка вне экрана: экономим батарею телефона.
  const hero = document.querySelector<HTMLElement>('.hero');
  if (hero && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      hero.toggleAttribute('data-paused', !entry.isIntersecting);
    }).observe(hero);
  }
</script>
