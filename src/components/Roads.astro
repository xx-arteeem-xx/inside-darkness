---
/** Дороги: ямщики, «К игроку» и «Домой», почта, свиток, шорник, картограф и летописец. */
import Block from './Block.astro';
import Cards, { type Card } from './Cards.astro';
import { G, fmt, pct, count, range } from '../data/game';
import { docHref } from '../lib/docs';

const roadsHref = await docHref('roads');
const mapsHref = await docHref('maps');
const S = G.stations;
const R = G.roads;
const M = G.mail;
const saddler = G.market.item.saddler;
const C = G.chronicle;

const cards: Card[] = [
  {
    glyph: 'horseshoe',
    name: 'Ямская служба',
    sub: count(S.count, ['станция', 'станции', 'станций']),
    text: [
      `У столицы, рынка, Деревни мастеров, угодий, ристалища и в каждой деревне. Станция открывается, когда дойдёшь до неё пешком.`,
      `Поездка — ${fmt(S.base)} монет и ещё монета за каждые ${fmt(S.perBlocks)} блоков: от столицы до самой дальней деревни ≈ ${fmt(S.fareMax)}. Отсчёт — стой на месте.`,
    ],
  },
  {
    glyph: 'banner',
    name: 'К игроку и домой',
    sub: 'у любого ямщика',
    text: [
      `<b>К игроку</b> — повозка к другу, если он согласится. Только внутри Стены, по цене поездки.`,
      `<b>Домой</b> — к своему жилью за ${pct(R.homeDiscount)} цены. Без жилья кнопки нет.`,
    ],
  },
  {
    glyph: 'letter',
    name: 'Почта',
    sub: 'у любого ямщика',
    text: [
      `Вещи, до ${count(M.maxStacks, ['стопки', 'стопок', 'стопок'])}, и монеты любому игроку — получателя выбираешь из списка, даже если его нет в игре.`,
      `Доставка — ${fmt(M.base)} + ${fmt(M.perStack)} за стопку + ${pct(M.coinShare)} от монет. Монеты командой не передать — только так.`,
    ],
  },
  {
    glyph: 'scroll',
    name: 'Свиток возвращения',
    sub: 'у чародея',
    text: [
      `${fmt(R.scrollPrice)} монет. ПКМ — и ты на станции «${R.scrollStation}», откуда угодно, даже из тёмных земель. Не действует на ристалище.`,
    ],
  },
  {
    glyph: 'lantern',
    name: 'Шорник',
    sub: G.npcs.who.saddler.name + ', рынок',
    rows: [
      ['Элитры', fmt(saddler.ELYTRA), 'только внутри Стены'],
      ['Сапоги-скороходы', fmt(saddler.LEATHER_BOOTS), 'шаг как под Скоростью V'],
    ],
    note: 'На ристалище не помогают ни крылья, ни сапоги. Над Стеной крылья не держат.',
  },
  {
    glyph: 'map',
    name: 'Картограф',
    sub: 'Деревня мастеров',
    text: [
      `Карта странника за ${fmt(G.maps.minimapPrice)} — мини-карта во второй руке, ты всегда в центре. ${count(G.maps.regionCount, ['лист', 'листа', 'листов'])} местностей по ${range(G.maps.regionPriceMin, G.maps.regionPriceMax)}, карты сокровищ за ${G.maps.treasurePrices.map(fmt).join(', ')}.`,
      `Ещё — метки для Xaero's Minimap и колокол «Вести». Летописец в столице платит ${range(C.rewardMin, C.rewardMax)} монет за каждое новое место.`,
    ],
  },
];
---
<Block
  id="roads"
  title="Дороги"
  bg="#16151a"
  lead="Княжество большое. По нему ездят на ямских, шлют посылки, возвращаются по свитку и летают на крыльях — но только внутри Стены. За Стену ходят пешком."
  links={[{ href: roadsHref, text: 'Ямщики, почта и быстрые пути' }, { href: mapsHref, text: 'Карты, клады и летопись' }]}
>
  <Cards cards={cards} cols={3} />
</Block>
