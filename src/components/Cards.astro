---
/**
 * Сетка карточек «как окно в игре»: значок в слоте, заголовок, текст, строки цен.
 * Общая для разделов главной (дороги, город, граница, снаряжение), чтобы стиль карточек жил в одном месте.
 */
import Pixel from './Pixel.astro';
import { GLYPHS, type GlyphId } from '../lib/emblems';

export interface Card {
  glyph: GlyphId;
  name: string;
  sub?: string;
  /** Абзацы текста; HTML разрешён (ссылки, <b>). */
  text?: string[];
  /** Строки «название — значение», третья ячейка — подпись под названием. */
  rows?: Array<[string, string, string?]>;
  /** Столбики: подпись и значение, высота — доля от наибольшего. */
  bars?: { caption: string; items: Array<[string, number]> };
  note?: string;
  tone?: 'enchant' | 'dark' | 'gold';
  span?: 2;
}
interface Props {
  cards: Card[];
  cols?: 2 | 3 | 4;
}
const { cards, cols = 3 } = Astro.props;
const fmt = (n: number) => n.toLocaleString('ru-RU').replace(/ /g, ' ').replace(/^(\d) (\d{3})$/, '$1$2');
---
<ul class:list={['cards', `cards--${cols}`]} role="list">
  {cards.map((c) => {
    const top = c.bars ? Math.max(...c.bars.items.map(([, v]) => v)) : 1;
    return (
      <li class:list={['mcard', c.tone && `mcard--${c.tone}`, { 'mcard--span': c.span === 2 }]}>
        <div class="mcard__top">
          <span class="slot slot--sm" aria-hidden="true"><Pixel grid={GLYPHS[c.glyph]} /></span>
          <h4 class="mcard__name">{c.name}{c.sub && <span>{c.sub}</span>}</h4>
        </div>
        {c.text?.map((t) => <p class="mcard__text" set:html={t} />)}
        {c.bars && (
          <figure class="steps">
            <figcaption>{c.bars.caption}</figcaption>
            <ol class="steps__list" role="list" style={`--n:${c.bars.items.length}`}>
              {c.bars.items.map(([label, v]) => (
                <li style={`--h:${(v / top).toFixed(3)}`}>
                  <span class="steps__price">{fmt(v)}</span>
                  <span class="steps__bar" aria-hidden="true"></span>
                  <span class="steps__lvl">{label}</span>
                </li>
              ))}
            </ol>
          </figure>
        )}
        {c.rows && (
          <dl class="mcard__prices">
            {c.rows.map(([k, v, s]) => (
              <div><dt>{k}{s && <span>{s}</span>}</dt><dd>{v}</dd></div>
            ))}
          </dl>
        )}
        {c.note && <p class="mcard__note">{c.note}</p>}
      </li>
    );
  })}
</ul>

<style>
  .cards {
    display: grid;
    gap: 1rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .cards--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .cards--3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .cards--4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .mcard {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 1.1rem 1.15rem 1.2rem;
    background: #1d1c22;
    box-shadow:
      inset 0 0 0 2px #0b0b0e,
      inset 2px 2px 0 2px #33323c,
      inset -2px -2px 0 2px #121116;
  }

  .mcard--span {
    grid-column: span 2;
  }

  .mcard--enchant {
    background:
      radial-gradient(80% 60% at 100% 0%, rgb(123 58 138 / 0.22), transparent 70%),
      #1b1922;
  }

  .mcard--dark {
    background:
      radial-gradient(90% 70% at 100% 0%, rgb(124 31 44 / 0.25), transparent 70%),
      #18151a;
  }

  .mcard--gold {
    background:
      radial-gradient(90% 70% at 100% 0%, rgb(237 163 60 / 0.14), transparent 70%),
      #1d1b1f;
  }

  .mcard__top {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .mcard__name {
    font-size: var(--fs-md);
    line-height: 1.15;
  }

  .mcard__name span {
    display: block;
    margin-top: 0.2rem;
    color: var(--ash);
    font-size: 0.9375rem;
    font-weight: 400;
  }

  .mcard__text {
    color: var(--bone-2);
    font-size: 1rem;
    line-height: 1.5;
  }

  .mcard__text :global(b) {
    color: var(--bone);
  }

  .mcard__note {
    color: var(--ash);
    font-size: 0.9375rem;
  }

  .slot {
    display: grid;
    place-items: center;
    background: #26272f;
    box-shadow:
      inset 3px 3px 0 #0e0e12,
      inset -3px -3px 0 #464856;
  }

  .slot--sm {
    width: 3rem;
    height: 3rem;
    flex: none;
  }

  .slot--sm :global(.pixel) {
    width: 2rem;
    height: 2rem;
  }

  .mcard__prices {
    display: grid;
    margin: 0;
    border-top: 1px dashed var(--line-2);
  }

  .mcard__prices div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.55rem;
  }

  .mcard__prices dt {
    color: var(--bone-2);
    font-size: 1rem;
  }

  .mcard__prices dt span {
    display: block;
    color: var(--ash);
    font-size: 0.875rem;
  }

  .mcard__prices dd {
    margin: 0;
    color: var(--gold);
    font-family: var(--font-pixel);
    font-size: 1.0625rem;
    white-space: nowrap;
  }

  .steps figcaption {
    color: var(--ash);
    font-size: 0.9375rem;
  }

  .steps__list {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    align-items: end;
    gap: 0.5rem;
    height: 9rem;
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
  }

  .steps__list li {
    display: grid;
    grid-template-rows: auto 1fr auto;
    justify-items: center;
    align-items: end;
    gap: 0.3rem;
    height: 100%;
  }

  .steps__price {
    color: var(--gold);
    font-family: var(--font-pixel);
    font-size: 0.9375rem;
    white-space: nowrap;
  }

  .steps__bar {
    width: 100%;
    max-width: 3rem;
    height: calc(var(--h) * 100%);
    min-height: 4px;
    background: linear-gradient(90deg, #b88ad0 0 45%, #7b3a8a 45%);
    box-shadow: inset 0 2px 0 rgb(255 255 255 / 0.18);
  }

  .steps__lvl {
    color: var(--bone);
    font-family: var(--font-pixel);
    font-size: 0.9375rem;
  }

  @media (max-width: 64rem) {
    .cards--3,
    .cards--4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 44rem) {
    .cards--2,
    .cards--3,
    .cards--4 {
      grid-template-columns: 1fr;
    }

    .mcard--span {
      grid-column: auto;
    }
  }
</style>
