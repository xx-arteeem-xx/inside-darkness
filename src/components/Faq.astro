---
import { SERVER } from '../config/site';
import { docHref } from '../lib/docs';

const economyHref = await docHref('economy');
const villageHref = await docHref('village');
const commandsHref = await docHref('commands');
const rulesHref = await docHref('rules');
const worldHref = await docHref('world');

const items: Array<{ q: string; a: string }> = [
  {
    q: 'Нужна ли лицензия?',
    a: 'Нет, пиратские клиенты пускаются. При первом входе зарегистрируйся командой <code>/register</code>, дальше входи через <code>/login</code>.',
  },
  {
    q: 'Какая версия Minecraft подойдёт?',
    a: `Java Edition от ${SERVER.versions.replace('–', ' до ')}. Моды ставить не нужно.`,
  },
  {
    q: 'Как продать добычу?',
    a: `Возьми товар в руку и нажми ПКМ по нужному купцу на центральном рынке: уйдёт вся стопка. Shift + ПКМ продаёт весь такой товар из инвентаря, ПКМ пустой рукой — купец назовёт цены. Таблицы цен: <a href="${economyHref}">Монеты и рынок</a>.`,
  },
  {
    q: 'Куда деть то, что купцы не берут?',
    a: 'Отнеси старьёвщику на рынке. Он берёт всё, что не берут другие купцы, но за копейки: мелочь по 0,01 за штуку, вещи — от 0,1 до 5 в зависимости от материала. Купленное у NPC, трофеи и шалкеры он не берёт.',
  },
  {
    q: 'Можно ли продавать не на рынке?',
    a: `Да, в шести деревнях внутри стены есть сельские торговцы. Скупщик берёт всё, что и рынок, за 80% цены, лавочник продаёт еду, инструменты, оружие и свет. В деревне у столицы торговцев нет. Где деревни: <a href="${worldHref}">Карта и места</a>.`,
  },
  {
    q: 'Платят ли за убийство мобов?',
    a: 'Нет. Деньги дают только за лут: трофеи и обычную добычу с мобов берёт скупщик диковин на рынке.',
  },
  {
    q: 'Можно ли передать монеты другу?',
    a: 'Нет, командой монеты не передаются. Заработать их можно только продажей добытого купцам и победами на ристалище.',
  },
  {
    q: 'Почему нельзя ломать и ставить блоки?',
    a: `Мир общий и защищён целиком. Копать можно в карьере шахты, собирать урожай на поле и рубить деревья в саду. Строить нельзя нигде. Подробно: <a href="${rulesHref}">Правила</a>.`,
  },
  {
    q: 'Где хранить вещи?',
    a: 'В своём жилье: сундуки, двери и печи работают только там. Комната в ночлежке стоит 20 монет в сутки, дом в деревне — 120 в сутки или 8000 навсегда. Ещё есть шалкер за 750 у инструментщика: его можно поставить где угодно, кроме карьера шахты, и открыть его сможешь только ты.',
  },
  {
    q: 'Как не сидеть в темноте, если факелы ставить нельзя?',
    a: 'Держи свет в руке. Факел, фонарь, светокамень и похожие вещи в любой руке светят вокруг тебя, свет видят все рядом. Факелы и фонари продаёт фонарщик на рынке.',
  },
  {
    q: 'Можно ли сменить расу?',
    a: `Да, у старейшины в деревне за 1000 монет. Первый выбор бесплатный. Подробно: <a href="${villageHref}">Деревня: расы и мастера</a>.`,
  },
  {
    q: 'Что будет, если меня убьют на ристалище?',
    a: 'Потеряешь 100 монет, победитель получит 90. Вещи при смерти на ристалище не теряются. Выход из игры посреди боя тоже считается поражением.',
  },
  {
    q: 'Я отказался от ресурспака. Как его вернуть?',
    a: 'Выбери сервер в списке, нажми «Настроить» и поставь «Наборы ресурсов: Включены».',
  },
  {
    q: 'Почему сервер выключен?',
    a: 'Сервер работает не круглосуточно: на хостинге exaroton он засыпает, когда в игре никого нет. Статус в начале страницы показывает, запущен ли он сейчас.',
  },
  {
    q: 'Какие есть команды?',
    a: `Почти никаких: <code>/монеты</code> показывает баланс, плюс вход в аккаунт, <code>/spawn</code> и <code>/msg</code>. Всё остальное делается через NPC. Список: <a href="${commandsHref}">Команды</a>.`,
  },
  {
    q: 'Даёт ли донат преимущества в игре?',
    a: 'Нет. Донат добровольный и не даёт игровых преимуществ.',
  },
];
---
<section class="faq section" id="faq" aria-labelledby="faq-title">
  <div class="wrap faq__grid">
    <h2 class="section-title" id="faq-title">Частые вопросы</h2>
    <div class="faq__list">
      {items.map((item) => (
        <details class="qa">
          <summary>{item.q}</summary>
          <p set:html={item.a} />
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--slate-0);
  }

  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 2rem clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .faq__list {
    border-top: 1px solid var(--line-2);
  }

  .qa {
    border-bottom: 1px solid var(--line-2);
  }

  .qa summary {
    position: relative;
    display: block;
    padding: 1.1rem 3rem 1.1rem 0;
    color: var(--bone);
    font-size: var(--fs-md);
    font-weight: 700;
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
    transition: color 0.15s ease;
  }

  .qa summary::-webkit-details-marker {
    display: none;
  }

  /* Пиксельный плюс, который становится минусом. */
  .qa summary::before,
  .qa summary::after {
    content: '';
    position: absolute;
    right: 0.5rem;
    top: 50%;
    width: 14px;
    height: 4px;
    margin-top: -2px;
    background: var(--gold);
    transition: transform 0.2s ease;
  }

  .qa summary::after {
    transform: rotate(90deg);
  }

  .qa[open] summary::after {
    transform: rotate(0deg);
  }

  .qa summary:hover {
    color: var(--gold);
  }

  .qa summary:focus-visible {
    outline-offset: 2px;
  }

  .qa p {
    max-width: 44rem;
    padding: 0 3rem 1.4rem 0;
    color: var(--bone-2);
  }

  .qa :global(code) {
    padding: 0.05em 0.35em;
    background: rgb(0 0 0 / 0.5);
    color: #f3f0e6;
  }

  @media (max-width: 56rem) {
    .faq__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
