---
import { SERVER } from '../config/site';
import { url } from '../lib/url';
import { G, fmt, pct, count } from '../data/game';

const g = (slug: string) => url(`/guide/${slug}/`);

// Коротко — самое частое. Полный список с ответами — в гайде, «Частые вопросы».
const items: Array<{ q: string; a: string }> = [
  {
    q: 'Нужна ли лицензия?',
    a: 'Нет, пиратские клиенты пускают. При первом входе придумай пароль и напиши его в чат: <code>/register пароль пароль</code>. Дальше входи через <code>/login пароль</code>.',
  },
  {
    q: 'Какая версия Minecraft подойдёт?',
    a: `Java Edition от ${SERVER.versionFrom} до ${SERVER.versionTo}. Моды ставить не нужно.`,
  },
  {
    q: 'С чего начать?',
    a: `С проводника на площади у цитадели: в его окне — основы игры и ${count(G.guide.count, ['задание', 'задания', 'заданий'])}, за все вместе он доплачивает ${count(G.guide.total, ['монету', 'монеты', 'монет'])}. Подробно: <a href="${g('start')}">Начало пути</a>.`,
  },
  {
    q: 'Почему цены у купцов разные?',
    a: `По миру ходят вести, и спрос меняется. А ещё товар дешевле там, откуда он берётся: в дальней деревне за него дают больше, чем у угодья. Скупщики у шахты, поля и сада платят ${pct(G.market.siteFactor)} базы. Подробно: <a href="${g('trade')}">Торг</a>.`,
  },
  {
    q: 'Как быстро перемещаться?',
    a: `На ямских: ${count(G.stations.count, ['станция', 'станции', 'станций'])}, каждая открывается, когда дойдёшь до неё пешком. Ямщик довезёт и к другу, если тот согласится, и домой. Телепорт-команд нет. Подробно: <a href="${g('world')}">Край и его места</a>.`,
  },
  {
    q: 'Что будет, если погибнуть?',
    a: `Вещи не рассыпаются по земле: они ждут в могиле на месте смерти, открыть её можешь только ты. Туда же ложится почти всё из кошелька, а монеты в банке не теряются никогда. Подробно: <a href="${g('death')}">Смерть, могила и банк</a>.`,
  },
  {
    q: 'Есть ли PvP?',
    a: `Внутри Стены — только на ристалище, на монеты. За Стеной закона нет: в тёмных землях напасть может любой. Подробно: <a href="${g('rules')}">Правила</a>.`,
  },
  {
    q: 'Можно ли купить силу за деньги?',
    a: `Нет. Монеты в личном кабинете продаются только из казначейства княжества и не больше половины за раз, а ранги, качество вещей и комплекты с хозяев за деньги не купить. За поддержку есть внешний вид: облики, титулы, цвет имени. Подробно: <a href="${g('cabinet')}">Кабинет и поддержка</a>.`,
  },
];
---
<section class="faq section" id="faq" aria-labelledby="faq-title">
  <div class="wrap faq__grid">
    <h2 class="section-title" id="faq-title">Частые вопросы</h2>
    <div class="faq__list">
      {items.map((item) => (
        <details class="qa">
          <summary>{item.q}</summary>
          <p set:html={item.a} />
        </details>
      ))}
      <p class="faq__all"><a class="more" href={g('faq')}>Все вопросы и ответы</a></p>
    </div>
  </div>
</section>

<style>
  .faq__all {
    margin-top: 1.5rem;
  }

  .faq {
    background: var(--slate-0);
  }

  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 2rem clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .faq__list {
    border-top: 1px solid var(--line-2);
  }

  .qa {
    border-bottom: 1px solid var(--line-2);
  }

  .qa summary {
    position: relative;
    display: block;
    padding: 1.1rem 3rem 1.1rem 0;
    color: var(--bone);
    font-size: var(--fs-md);
    font-weight: 700;
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
    transition: color 0.15s ease;
  }

  .qa summary::-webkit-details-marker {
    display: none;
  }

  /* Пиксельный плюс, который становится минусом. */
  .qa summary::before,
  .qa summary::after {
    content: '';
    position: absolute;
    right: 0.5rem;
    top: 50%;
    width: 14px;
    height: 4px;
    margin-top: -2px;
    background: var(--gold);
    transition: transform 0.2s ease;
  }

  .qa summary::after {
    transform: rotate(90deg);
  }

  .qa[open] summary::after {
    transform: rotate(0deg);
  }

  .qa summary:hover {
    color: var(--gold);
  }

  .qa summary:focus-visible {
    outline-offset: 2px;
  }

  .qa p {
    max-width: 44rem;
    padding: 0 3rem 1.4rem 0;
    color: var(--bone-2);
  }

  .qa :global(code) {
    padding: 0.05em 0.35em;
    background: rgb(0 0 0 / 0.5);
    color: #f3f0e6;
  }

  @media (max-width: 56rem) {
    .faq__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
