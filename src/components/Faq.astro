---
import { SERVER } from '../config/site';
import { docHref } from '../lib/docs';
import { G, QUESTS, QUEST_TOTAL, fmt, pct, count } from '../data/game';

const faqHref = await docHref('faq');
const startHref = await docHref('start');
const tradeHref = await docHref('trade');
const roadsHref = await docHref('roads');
const housingHref = await docHref('housing');
const rulesHref = await docHref('rules');
const commandsHref = await docHref('commands');

// Коротко — самое частое. Полный список с ответами: документация, «Вопросы и ответы».
const items: Array<{ q: string; a: string }> = [
  {
    q: 'Нужна ли лицензия?',
    a: 'Нет, пиратские клиенты пускают. При первом входе зарегистрируйся командой <code>/register</code>, дальше входи через <code>/login</code>.',
  },
  {
    q: 'Какая версия Minecraft подойдёт?',
    a: `Java Edition от ${SERVER.versions.replace('–', ' до ')}. Моды ставить не нужно.`,
  },
  {
    q: 'С чего начать?',
    a: `С проводника на площади у цитадели: в его окне — основы игры и ${count(QUESTS.length, ['задание', 'задания', 'заданий'])}, за все вместе он доплачивает ${fmt(QUEST_TOTAL)} монет. Подробно: <a href="${startHref}">Первые шаги</a>.`,
  },
  {
    q: 'Почему цены у купцов разные?',
    a: `По миру ходят вести, и спрос меняется. А ещё товар дешевле там, откуда он берётся: в дальней деревне за него дают больше, чем у угодья. Скупщики у шахты, поля и сада платят ${pct(G.market.siteFactor)} базы. Подробно: <a href="${tradeHref}">Торг и вести</a>.`,
  },
  {
    q: 'Как быстро перемещаться?',
    a: `На ямских: ${count(G.stations.count, ['станция', 'станции', 'станций'])}, каждая открывается, когда дойдёшь до неё пешком. Ямщик довезёт и к другу, если тот согласится, и домой. Свиток возвращения у чародея перенесёт в столицу откуда угодно. Телепорт-команд нет. Подробно: <a href="${roadsHref}">Дороги</a>.`,
  },
  {
    q: 'Где хранить вещи и где я возрождаюсь?',
    a: `В своём жилье: комната от ${fmt(G.homes.roomRentMin)} монет в сутки или дом в деревне. Кровать в своём жилье — твоя точка возрождения. Ещё есть ячейка в банке столицы. Подробно: <a href="${housingHref}">Жильё</a>.`,
  },
  {
    q: 'Есть ли PvP?',
    a: `Внутри Стены — только на ристалище, на монеты. За Стеной закона нет: в тёмных землях напасть может любой. Подробно: <a href="${rulesHref}">Правила</a>.`,
  },
  {
    q: 'Почему нельзя ломать и ставить блоки?',
    a: 'Мир общий и защищён целиком. Копать можно в карьере шахты, собирать урожай на поле и рубить деревья в саду. Свет носят в руке.',
  },
  {
    q: 'Какие есть команды?',
    a: `Почти никаких: вход в аккаунт, личные сообщения, <code>/монеты</code>, <code>/skin</code>, <code>/helpop</code>, <code>/sb</code>. Всё остальное — у жителей. Список: <a href="${commandsHref}">Команды</a>.`,
  },
  {
    q: 'Почему сервер выключен?',
    a: 'Он работает не круглосуточно: на хостинге exaroton засыпает, когда в игре никого нет. Статус в начале страницы показывает, запущен ли он сейчас.',
  },
  {
    q: 'Даёт ли донат преимущества?',
    a: 'Нет. Донат добровольный и не даёт игровых преимуществ.',
  },
];
---
<section class="faq section" id="faq" aria-labelledby="faq-title">
  <div class="wrap faq__grid">
    <h2 class="section-title" id="faq-title">Частые вопросы</h2>
    <div class="faq__list">
      {items.map((item) => (
        <details class="qa">
          <summary>{item.q}</summary>
          <p set:html={item.a} />
        </details>
      ))}
      <p class="faq__all"><a class="more" href={faqHref}>Все вопросы и ответы</a></p>
    </div>
  </div>
</section>

<style>
  .faq__all {
    margin-top: 1.5rem;
  }

  .faq {
    background: var(--slate-0);
  }

  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 2rem clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .faq__list {
    border-top: 1px solid var(--line-2);
  }

  .qa {
    border-bottom: 1px solid var(--line-2);
  }

  .qa summary {
    position: relative;
    display: block;
    padding: 1.1rem 3rem 1.1rem 0;
    color: var(--bone);
    font-size: var(--fs-md);
    font-weight: 700;
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
    transition: color 0.15s ease;
  }

  .qa summary::-webkit-details-marker {
    display: none;
  }

  /* Пиксельный плюс, который становится минусом. */
  .qa summary::before,
  .qa summary::after {
    content: '';
    position: absolute;
    right: 0.5rem;
    top: 50%;
    width: 14px;
    height: 4px;
    margin-top: -2px;
    background: var(--gold);
    transition: transform 0.2s ease;
  }

  .qa summary::after {
    transform: rotate(90deg);
  }

  .qa[open] summary::after {
    transform: rotate(0deg);
  }

  .qa summary:hover {
    color: var(--gold);
  }

  .qa summary:focus-visible {
    outline-offset: 2px;
  }

  .qa p {
    max-width: 44rem;
    padding: 0 3rem 1.4rem 0;
    color: var(--bone-2);
  }

  .qa :global(code) {
    padding: 0.05em 0.35em;
    background: rgb(0 0 0 / 0.5);
    color: #f3f0e6;
  }

  @media (max-width: 56rem) {
    .faq__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
