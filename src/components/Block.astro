---
/**
 * Раздел главной: срез породы сверху, заголовок с подводкой, содержимое и ссылки «подробно» в документацию.
 */
interface Props {
  id: string;
  title: string;
  lead?: string;
  kicker?: string;
  /** Цвет фона раздела и среза над ним. */
  bg?: string;
  links?: Array<{ href: string; text: string }>;
}
const { id, title, lead, kicker, bg = '#141418', links = [] } = Astro.props;
---
<section class="block section" id={id} aria-labelledby={`${id}-title`} style={`--bg:${bg}`}>
  <svg class="strata" viewBox="0 0 1440 24" preserveAspectRatio="none" aria-hidden="true" shape-rendering="crispEdges">
    <path fill={bg} d="M0 24V10h96V2h112v14h128V6h80v10h168V0h88v12h144V4h96v12h120V8h104v8h136V2h96v14h72V24z" />
  </svg>
  <div class="wrap">
    <header class="section-head">
      {kicker && <p class="block__kicker">{kicker}</p>}
      <h2 class="section-title" id={`${id}-title`}>{title}</h2>
      {lead && <p class="section-lead" set:html={lead} />}
    </header>
    <slot />
    {links.length > 0 && (
      <p class="block__more">
        {links.map((l) => <a class="more" href={l.href}>{l.text}</a>)}
      </p>
    )}
  </div>
</section>

<style>
  .block {
    background: var(--bg);
  }

  .block__kicker {
    color: var(--torch);
    font-family: var(--font-pixel);
    font-size: 1rem;
    letter-spacing: 0.04em;
  }

  .block__more {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin-top: 1.75rem;
  }
</style>
