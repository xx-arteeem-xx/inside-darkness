---
import Mark from './Mark.astro';
import { url } from '../lib/url';
import { CABINET_URL } from '../config/site';

interface Props {
  variant?: 'home' | 'inner' | 'map';
}
const { variant = 'inner' } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: url('/#features'), text: 'Об игре', current: false },
  { href: url('/map/'), text: 'Карта', current: path.includes('/map') },
  { href: url('/guide/'), text: 'Гайд', current: path.includes('/guide') },
  { href: url('/#join'), text: 'Как зайти', current: false },
  { href: url('/#support'), text: 'Поддержать', current: false },
];
---
<header class:list={['site-header', `site-header--${variant}`]}>
  <div class="site-header__row">
    <a class="site-header__brand" href={url('/')} aria-label="Inside Darkness, на главную">
      <Mark class="site-header__mark" />
      <span>Inside Darkness</span>
    </a>
    <nav class="site-header__nav" aria-label="Основная навигация">
      <ul role="list">
        {links.map((l) => (
          <li>
            <a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.text}</a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="btn btn--small site-header__cabinet" href={CABINET_URL}>
      <span class="cab-long">Личный кабинет</span><span class="cab-short" aria-hidden="true">Кабинет</span>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 30;
  }

  .site-header--home {
    position: absolute;
    inset: 0 0 auto 0;
  }

  .site-header--inner,
  .site-header--map {
    background: rgb(7 9 15 / 0.92);
    box-shadow: inset 0 -1px 0 var(--line);
  }

  .site-header--inner {
    position: sticky;
    top: 0;
    backdrop-filter: blur(8px);
  }

  .site-header__row {
    display: flex;
    align-items: center;
    gap: 0.75rem 2rem;
    max-width: 90rem;
    min-height: 4.25rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    flex: none;
    color: var(--bone);
    font-size: 1.25rem;
    font-weight: 900;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .site-header__brand:hover {
    color: var(--gold);
  }

  .site-header__brand :global(.site-header__mark) {
    width: 1.875rem;
    height: 1.875rem;
  }

  .site-header__nav {
    margin-left: auto;
  }

  .site-header__nav ul {
    display: flex;
    gap: 0.25rem 1.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__nav a {
    display: block;
    padding-block: 0.6rem 0.5rem;
    color: var(--bone-2);
    font-size: 1.0625rem;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: inset 0 -2px 0 transparent;
    transition: color 0.15s ease, box-shadow 0.15s ease;
  }

  .site-header__nav a:hover {
    color: var(--bone);
    box-shadow: inset 0 -2px 0 var(--gold-deep);
  }

  .site-header__nav a:focus-visible {
    outline-offset: -3px;
  }

  .site-header__nav a[aria-current='page'] {
    color: var(--gold);
    box-shadow: inset 0 -2px 0 var(--gold);
  }

  .site-header__cabinet {
    flex: none;
  }

  .cab-short {
    display: none;
  }

  /* Узкий экран: знак и кабинет в первой строке, ссылки — второй строкой с прокруткой вбок. */
  @media (max-width: 60rem) {
    .site-header__row {
      flex-wrap: wrap;
      padding-top: 0.55rem;
      min-height: 0;
    }

    .site-header__cabinet {
      margin-left: auto;
    }

    .site-header__nav {
      order: 3;
      width: calc(100% + 2 * var(--gutter));
      margin-inline: calc(-1 * var(--gutter));
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-mask-image: linear-gradient(90deg, #000 85%, transparent);
      mask-image: linear-gradient(90deg, #000 85%, transparent);
    }

    .site-header__nav::-webkit-scrollbar {
      display: none;
    }

    .site-header__nav ul {
      gap: 1.3rem;
      padding-inline: var(--gutter) 2.5rem;
    }

    .site-header__nav a {
      font-size: 1rem;
    }

    .site-header--inner {
      position: relative;
    }
  }

  @media (max-width: 30rem) {
    .cab-long {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .cab-short {
      display: inline;
    }
  }

  @media (max-width: 22rem) {
    .site-header__brand span {
      font-size: 1.0625rem;
    }
  }
</style>
