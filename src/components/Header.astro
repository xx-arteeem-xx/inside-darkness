---
import Mark from './Mark.astro';
import { url } from '../lib/url';

interface Props {
  variant?: 'home' | 'inner';
}
const { variant = 'inner' } = Astro.props;
const inDocs = Astro.url.pathname.includes('/docs');
const links = [
  { href: url('/#how'), text: 'Как играть' },
  { href: url('/#earn'), text: 'Заработок' },
  { href: url('/#places'), text: 'Места' },
  { href: url('/#village'), text: 'Деревня' },
  { href: url('/#arena'), text: 'Ристалище' },
  { href: url('/docs/'), text: 'Документация', current: inDocs },
];
---
<header class:list={['site-header', `site-header--${variant}`]}>
  <div class="wrap site-header__row">
    <a class="site-header__brand" href={url('/')} aria-label="Inside Darkness, на главную">
      <Mark class="site-header__mark" />
      <span>Inside Darkness</span>
    </a>
    <nav class="site-header__nav" aria-label="Основная навигация">
      <ul role="list">
        {links.map((l) => (
          <li>
            <a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 20;
  }

  .site-header--home {
    position: absolute;
    inset: 0 0 auto 0;
  }

  .site-header--inner {
    background: var(--slate-0);
    box-shadow: inset 0 -1px 0 var(--line);
  }

  .site-header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    min-height: 4.5rem;
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    flex: none;
    color: var(--bone);
    font-size: 1.3125rem;
    font-weight: 900;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .site-header__brand:hover {
    color: var(--gold);
  }

  .site-header__brand :global(.site-header__mark) {
    width: 2rem;
    height: 2rem;
  }

  .site-header__nav ul {
    display: flex;
    gap: 0.25rem 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__nav a {
    display: block;
    padding-block: 0.6rem 0.5rem;
    color: var(--bone-2);
    font-size: 1.0625rem;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: inset 0 -2px 0 transparent;
    transition: color 0.15s ease, box-shadow 0.15s ease;
  }

  .site-header__nav a:hover {
    color: var(--bone);
    box-shadow: inset 0 -2px 0 var(--gold-deep);
  }

  /* Кольцо фокуса внутрь: на телефоне ряд прокручивается и обрезал бы внешнее. */
  .site-header__nav a:focus-visible {
    outline-offset: -3px;
  }

  .site-header__nav a[aria-current='page'] {
    color: var(--gold);
    box-shadow: inset 0 -2px 0 var(--gold);
  }

  /* На узком экране навигация уходит во вторую строку и прокручивается вбок, без скрытого меню.
     Шесть ссылок и знак в одну строку помещаются только от 62rem. */
  @media (max-width: 62rem) {
    .site-header__row {
      flex-wrap: wrap;
      padding-top: 0.6rem;
    }

    .site-header__nav {
      width: calc(100% + 2 * var(--gutter));
      margin-inline: calc(-1 * var(--gutter));
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-mask-image: linear-gradient(90deg, #000 85%, transparent);
      mask-image: linear-gradient(90deg, #000 85%, transparent);
    }

    .site-header__nav::-webkit-scrollbar {
      display: none;
    }

    .site-header__nav ul {
      gap: 1.35rem;
      padding-inline: var(--gutter) 2.5rem;
    }

    .site-header__nav a {
      font-size: 1rem;
    }
  }
</style>
