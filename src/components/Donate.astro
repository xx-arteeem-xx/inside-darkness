---
import donate from '../config/donate.json';
import CopyButton from './CopyButton.astro';
import { url } from '../lib/url';

type Crypto = { network?: string; address?: string };

const sbp = {
  link: (donate.sbp?.link ?? '').trim(),
  phone: (donate.sbp?.phone ?? '').trim(),
  bank: (donate.sbp?.bank ?? '').trim(),
  qr: (donate.sbp?.qr ?? '').trim(),
};
const crypto = ((donate.crypto ?? []) as Crypto[])
  .map((c) => ({ network: (c.network ?? '').trim(), address: (c.address ?? '').trim() }))
  .filter((c) => c.address);

const hasSbp = Boolean(sbp.link || sbp.phone || sbp.qr);
const hasCrypto = crypto.length > 0;
const hasAny = hasSbp || hasCrypto;
const qrSrc = sbp.qr ? url(sbp.qr) : '';
---
<section class="donate section" id="donate" aria-labelledby="donate-title">
  <div class="wrap donate__grid">
    <div class="section-head">
      <h2 class="section-title" id="donate-title">Поддержать проект</h2>
      <p class="section-lead">
        Хостинг exaroton оплачивается за часы работы сервера. Донат добровольный и не даёт игровых преимуществ.
      </p>
    </div>

    {hasAny ? (
      <div class="donate__methods">
        <section class="method" aria-labelledby="m-sbp">
          <h3 class="method__title" id="m-sbp">СБП</h3>
          {hasSbp ? (
            <div class="method__body">
              {sbp.link && (
                <p>
                  <a class="btn" href={sbp.link} rel="noopener">Перевести по СБП</a>
                </p>
              )}
              {sbp.phone && (
                <div class="field">
                  <p class="field__label">Номер{sbp.bank && <>, банк {sbp.bank}</>}</p>
                  <div class="field__row">
                    <code id="sbp-phone">{sbp.phone}</code>
                    <CopyButton text={sbp.phone} target="sbp-phone" label="Скопировать" done="Номер скопирован" quiet small />
                  </div>
                </div>
              )}
              {!sbp.phone && sbp.bank && <p class="field__label">Банк: {sbp.bank}</p>}
              {qrSrc && (
                <img class="method__qr" src={qrSrc} alt="QR-код для перевода по СБП" width="200" height="200" loading="lazy" />
              )}
            </div>
          ) : (
            <p class="method__empty">Реквизиты появятся позже.</p>
          )}
        </section>

        <section class="method" aria-labelledby="m-crypto">
          <h3 class="method__title" id="m-crypto">Криптовалюта</h3>
          {hasCrypto ? (
            <ul class="method__body" role="list">
              {crypto.map((c, i) => (
                <li class="field">
                  <p class="field__label">{c.network || 'Адрес'}</p>
                  <div class="field__row">
                    <code id={`crypto-${i}`}>{c.address}</code>
                    <CopyButton text={c.address} target={`crypto-${i}`} label="Скопировать" done="Адрес скопирован" quiet small />
                  </div>
                </li>
              ))}
            </ul>
          ) : (
            <p class="method__empty">Реквизиты появятся позже.</p>
          )}
        </section>
      </div>
    ) : (
      <div class="donate__empty">
        <span class="tag">скоро</span>
        <p class="donate__empty-title">Реквизиты появятся позже.</p>
        <p>Здесь будут перевод по СБП и адреса для криптовалюты.</p>
      </div>
    )}
  </div>
</section>

<style>
  .donate {
    background: var(--slate-0);
  }

  .donate__grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: 2.5rem clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .donate__methods {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 2rem;
  }

  .method {
    padding-top: 1rem;
    box-shadow: inset 0 3px 0 var(--wine-2);
  }

  .method__title {
    font-size: var(--fs-md);
  }

  .method__body {
    display: grid;
    gap: 1rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .method__empty {
    margin-top: 0.75rem;
    color: var(--ash);
  }

  .method__qr {
    width: 200px;
    height: auto;
    max-width: 100%;
    aspect-ratio: 1;
    background: #fff;
    padding: 8px;
    image-rendering: pixelated;
  }

  .field__label {
    color: var(--ash);
    font-size: 1rem;
  }

  .field__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-top: 0.3rem;
  }

  .field__row code {
    min-width: 0;
    color: var(--gold);
    overflow-wrap: anywhere;
  }

  /* Пустое состояние: пустой сундук, рамка из пунктира. */
  .donate__empty {
    display: grid;
    justify-items: start;
    gap: 0.6rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    background: #17171c;
    box-shadow: inset 0 0 0 2px var(--slate-3);
    color: var(--ash);
  }

  .donate__empty-title {
    color: var(--bone);
    font-size: var(--fs-md);
    font-weight: 700;
  }

  @media (max-width: 56rem) {
    .donate__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
