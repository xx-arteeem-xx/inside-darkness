---
import Pixel from './Pixel.astro';
import { CRESTS, GLYPHS } from '../lib/emblems';
import { RACES, CLASSES } from '../data/roots';
import { docHref } from '../lib/docs';

const racesHref = await docHref('races');
const classesHref = await docHref('classes');
---
<section class="roots section" id="roots" aria-labelledby="roots-title">
  <div class="wrap">
    <header class="section-head">
      <h2 class="section-title" id="roots-title">Расы и классы</h2>
      <p class="section-lead">
        При первом входе откроется меню: сначала раса, потом класс. Сменить их позже можно сбросом корней за 100 уровней
        опыта.
      </p>
    </header>

    <div class="picker" data-picker>
      <div class="picker__board" role="tablist" aria-label="Расы" aria-orientation="horizontal">
        {RACES.map((race, i) => (
          <button
            class="crest"
            type="button"
            role="tab"
            id={`tab-${race.id}`}
            aria-controls={`race-${race.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            <Pixel grid={CRESTS[race.id]} class="crest__img" />
            <span class="crest__name">{race.name}</span>
          </button>
        ))}
      </div>

      <div class="picker__panels">
        {RACES.map((race, i) => (
          <div class="race" id={`race-${race.id}`} role="tabpanel" aria-labelledby={`tab-${race.id}`} hidden={i !== 0}>
            <Pixel grid={CRESTS[race.id]} class="race__crest" />
            <div class="race__body">
              <h3 class="race__name">{race.name} <span lang="en">{race.en}</span></h3>
              <p class="race__about">{race.about}</p>
              <dl class="race__facts">
                <div><dt>Родные земли</dt><dd>{race.home}</dd></div>
                <div><dt>Оружие</dt><dd>{race.weapon}</dd></div>
                <div><dt>Способность</dt><dd>{race.ability}</dd></div>
                <div><dt>Рост</dt><dd>{race.height}</dd></div>
              </dl>
            </div>
          </div>
        ))}
        <p class="picker__more">
          Плюсы, минусы и родовые постройки каждой расы: <a href={racesHref}>Расы</a>.
        </p>
      </div>
    </div>

    <section class="classes" aria-labelledby="classes-title">
      <div class="classes__head">
        <h3 class="classes__title" id="classes-title">Классы</h3>
        <p>Класс даёт одно умение и бонусный опыт за любимое дело. Подробно: <a href={classesHref}>Классы</a>.</p>
      </div>
      <ul class="classes__list" role="list">
        {CLASSES.map((k) => (
          <li class="klass">
            <span class="slot" aria-hidden="true"><Pixel grid={GLYPHS[k.id]} /></span>
            <div>
              <p class="klass__name">{k.name} <span lang="en">{k.en}</span></p>
              <p class="klass__skill">{k.skill}</p>
              <p class="klass__xp">Опыт за {k.xp}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  </div>
</section>

<style>
  .roots {
    background:
      radial-gradient(70% 50% at 80% 0%, rgb(124 31 44 / 0.12), transparent 70%),
      var(--slate-1);
  }

  .picker {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: 2rem clamp(2rem, 5vw, 4rem);
    align-items: start;
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .picker__board {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.5rem;
  }

  /* Кнопка-герб: тёмная ниша, выбранный герб поднимается и получает золотую рамку. */
  .crest {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    padding: 0.9rem 0.25rem 0.75rem;
    border: 0;
    background: transparent;
    color: var(--ash);
    font: inherit;
    font-size: 0.9375rem;
    line-height: 1.2;
    cursor: pointer;
    box-shadow: inset 0 0 0 2px transparent;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .crest:hover {
    background: rgb(255 255 255 / 0.04);
    color: var(--bone);
  }

  .crest[aria-selected='true'] {
    background: #222129;
    color: var(--gold);
    box-shadow: inset 0 0 0 2px var(--gold-deep);
  }

  .crest:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: -3px;
  }

  .crest :global(.crest__img) {
    width: 4rem;
    height: 4.25rem;
    transition: transform 0.15s ease;
  }

  .crest[aria-selected='true'] :global(.crest__img) {
    transform: translateY(-3px);
    filter: drop-shadow(0 6px 0 rgb(0 0 0 / 0.45));
  }

  .crest__name {
    max-width: 100%;
    overflow-wrap: anywhere;
    text-align: center;
  }

  .race {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem 1.75rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    background: #1b1a21;
    box-shadow:
      inset 0 0 0 2px #0b0b0e,
      inset 2px 2px 0 2px #34333d,
      inset -2px -2px 0 2px #121116;
  }

  .race :global(.race__crest) {
    width: 6rem;
    height: 6.375rem;
  }

  .race__name {
    font-size: var(--fs-lg);
  }

  .race__name span {
    display: block;
    margin-top: 0.3rem;
    color: var(--ash);
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0;
  }

  .race__about {
    margin-top: 0.75rem;
    color: var(--bone-2);
  }

  .race__facts {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }

  .race__facts div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--line);
  }

  .race__facts dt {
    color: var(--ash);
  }

  .race__facts dd {
    margin: 0;
    color: var(--bone);
  }

  .picker__more {
    margin-top: 1rem;
    color: var(--ash);
    font-size: 1rem;
  }

  /* Без JavaScript показываем все расы списком. */
  :global(html:not(.js)) .race[hidden] {
    display: grid !important;
  }

  :global(html:not(.js)) .picker__panels {
    display: grid;
    gap: 1rem;
  }

  /* ——— классы ——— */
  .classes {
    margin-top: clamp(4rem, 9vw, 6.5rem);
  }

  .classes__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line-2);
  }

  .classes__title {
    font-size: var(--fs-lg);
  }

  .classes__head p {
    color: var(--ash);
  }

  .classes__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .klass {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1.1rem;
    align-items: start;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  /* Ячейка инвентаря. */
  .slot {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    background: #26272f;
    box-shadow:
      inset 3px 3px 0 #0e0e12,
      inset -3px -3px 0 #464856;
  }

  .slot :global(.pixel) {
    width: 2.5rem;
    height: 2.5rem;
  }

  .klass__name {
    font-size: 1.1875rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .klass__name span {
    margin-left: 0.35rem;
    color: var(--ash);
    font-size: 0.9375rem;
    font-weight: 400;
  }

  .klass__skill {
    margin-top: 0.25rem;
    color: var(--bone-2);
  }

  .klass__xp {
    margin-top: 0.25rem;
    color: var(--ash);
    font-size: 0.9375rem;
  }

  @media (max-width: 64rem) {
    .picker {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 48rem) {
    .classes__list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 36rem) {
    .crest {
      padding: 0.6rem 0.1rem;
    }

    .crest :global(.crest__img) {
      width: 3rem;
      height: 3.2rem;
    }

    .crest__name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .race {
      grid-template-columns: 1fr;
    }

    .race__facts div {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
</style>

<script>
  // Вкладки рас: клик, стрелки, Home/End. Панели переключаются атрибутом hidden.
  document.querySelectorAll<HTMLElement>('[data-picker]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !on;
      });
      if (focus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const cols = 5;
        let next = -1;
        if (e.key === 'ArrowRight') next = (i + 1) % tabs.length;
        else if (e.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'ArrowDown') next = (i + cols) % tabs.length;
        else if (e.key === 'ArrowUp') next = (i - cols + tabs.length) % tabs.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = tabs.length - 1;
        if (next >= 0) {
          e.preventDefault();
          select(tabs[next], true);
        }
      });
    });
  });
</script>
