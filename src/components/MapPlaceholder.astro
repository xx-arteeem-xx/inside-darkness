---
import { SERVER } from '../config/site';
import { gridLayers, rng } from '../lib/pixel';

// Заставка: условная местность сверху, клетками. Это не карта сервера.
const r = rng(7341);
const COLS = 96;
const ROWS = 40;
const ph = Array.from({ length: 6 }, () => r() * Math.PI * 2);
const height = (x: number, y: number) =>
  Math.sin(x * 0.09 + ph[0]) * 0.9 +
  Math.cos(y * 0.17 + ph[1]) * 0.7 +
  Math.sin((x + y) * 0.06 + ph[2]) * 0.8 +
  Math.cos((x - y * 1.7) * 0.045 + ph[3]) * 0.6 +
  (r() - 0.5) * 0.35;
const tone = (h: number) => {
  if (h < -1.05) return 'a';
  if (h < -0.6) return 'b';
  if (h < -0.4) return 's';
  if (h < 0.55) return 'g';
  if (h < 1.3) return 'f';
  if (h < 1.85) return 'm';
  return 'M';
};
const rows = Array.from({ length: ROWS }, (_, y) => Array.from({ length: COLS }, (_, x) => tone(height(x, y))).join(''));
const tiles = gridLayers({
  rows,
  palette: { a: '#17202f', b: '#1c2840', s: '#38362f', g: '#232c26', f: '#1b231e', m: '#2b2c33', M: '#3a3b43' },
});
---
<section class="map section" id="map" aria-labelledby="map-title">
  <div class="wrap">
    <div class="map__head">
      <h2 class="section-title" id="map-title">Живая карта</h2>
      <p class="section-lead">
        3D-карта мира на BlueMap: столица, окрестности и игроки онлайн. Работает, пока запущен сервер.
      </p>
    </div>

    <div class="map__frame">
      <svg class="map__tiles" viewBox={`0 0 ${COLS} ${ROWS}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" shape-rendering="crispEdges">
        {tiles.map((t) => <path fill={t.fill} d={t.d} />)}
      </svg>
      <div class="map__fog" aria-hidden="true"></div>
      <div class="map__label" data-map-label>
        <p class="map__state" data-map-text role="status" aria-live="polite">Проверяю, запущен ли сервер…</p>
        <div class="map__actions" data-map-actions hidden>
          <button type="button" class="btn" data-map-open>Открыть карту</button>
          <a class="map__link" href={SERVER.mapUrl} target="_blank" rel="noopener">В новой вкладке</a>
        </div>
      </div>
      <iframe class="map__iframe" data-map-iframe title="Карта мира Inside Darkness" hidden loading="lazy"></iframe>
    </div>
  </div>
</section>

<script define:vars={{ liveApi: SERVER.liveApi, mapUrl: SERVER.mapUrl }}>
  const root = document.getElementById('map');
  const text = root.querySelector('[data-map-text]');
  const actions = root.querySelector('[data-map-actions]');
  const label = root.querySelector('[data-map-label]');
  const iframe = root.querySelector('[data-map-iframe]');
  root.querySelector('[data-map-open]').addEventListener('click', () => {
    iframe.src = mapUrl;
    iframe.hidden = false;
    label.hidden = true;
    root.querySelector('.map__fog').hidden = true;
    iframe.focus();
  });
  const ctrl = new AbortController();
  setTimeout(() => ctrl.abort(), 10000);
  fetch(liveApi, { signal: ctrl.signal, cache: 'no-store' })
    .then((r) => (r.ok ? r.json() : null))
    .catch(() => null)
    .then((s) => {
      if (s && Array.isArray(s.players)) {
        text.textContent = 'Сервер запущен, карта доступна. Постройки и игроки обновляются сами.';
        actions.hidden = false;
      } else {
        text.textContent = 'Сервер сейчас спит, поэтому карта не открывается. Загляните, когда в игре кто-то будет.';
      }
    });
</script>

<style>
  .map {
    background: var(--slate-1);
  }

  .map__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1rem 3rem;
    align-items: end;
  }

  .map__frame {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(20rem, 46vw, 34rem);
    margin-top: clamp(2rem, 5vw, 3rem);
    overflow: hidden;
    background: #0e1210;
    box-shadow:
      0 0 0 2px #0a0a0d,
      0 0 0 6px #2a2b33,
      0 0 0 8px #0a0a0d;
  }

  .map__tiles {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .map__fog {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 50% 55% at 50% 50%, rgb(10 10 13 / 0.9) 0%, rgb(10 10 13 / 0.6) 50%, rgb(10 10 13 / 0.2) 100%);
  }

  .map__label {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    max-width: 30rem;
    padding: 1.5rem;
    text-align: center;
  }

  .map__state {
    color: var(--bone);
    font-size: var(--fs-md);
    line-height: 1.4;
  }

  .map__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    justify-content: center;
    align-items: center;
  }

  .map__link {
    color: var(--bone-2);
  }

  .map__iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 52rem) {
    .map__head {
      grid-template-columns: 1fr;
    }
  }
</style>
