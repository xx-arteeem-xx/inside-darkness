---
import Mark from './Mark.astro';
import { url } from '../lib/url';
import { SERVER, CABINET_URL } from '../config/site';
import links from '../config/links.json';
---
<footer class="site-footer">
  <div class="wrap site-footer__grid">
    <div class="site-footer__id">
      <p class="site-footer__name"><Mark class="site-footer__mark" /> Inside Darkness</p>
      <p class="site-footer__addr"><code>{SERVER.address}</code></p>
      <p>Minecraft Java Edition {SERVER.versions}</p>
    </div>
    <nav class="site-footer__nav" aria-label="Ссылки в подвале">
      <ul role="list">
        <li><a href={url('/#join')}>Как зайти</a></li>
        <li><a href={url('/guide/')}>Гайд</a></li>
        <li><a href={url('/guide/start/')}>Новичку</a></li>
        <li><a href={url('/map/')}>Карта края</a></li>
        <li><a href={url('/guide/faq/')}>Частые вопросы</a></li>
        <li><a href={url('/guide/rules/')}>Правила</a></li>
      </ul>
      <ul role="list">
        <li><a href={CABINET_URL}>Личный кабинет</a></li>
        <li><a href={url('/#support')}>Поддержать край</a></li>
        {links.telegram.channel && <li><a href={links.telegram.channel} rel="noopener">Канал в Telegram</a></li>}
        {links.telegram.chat && <li><a href={links.telegram.chat} rel="noopener">Беседа в Telegram</a></li>}
        <li><a href={SERVER.repo}>Исходники сайта</a></li>
      </ul>
    </nav>
    <p class="site-footer__legal">
      Не является официальным продуктом Minecraft. Не одобрено и не связано с Mojang или Microsoft.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: var(--bedrock);
    box-shadow: inset 0 1px 0 var(--line);
    color: var(--ash);
    font-size: 1rem;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2.5rem 3rem;
    padding-block: 3.5rem 2.5rem;
  }

  .site-footer__id {
    display: grid;
    align-content: start;
    gap: 0.35rem;
  }

  .site-footer__name {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.4rem;
    color: var(--bone);
    font-size: 1.5rem;
    font-weight: 900;
  }

  .site-footer__name :global(.site-footer__mark) {
    width: 2rem;
    height: 2rem;
  }

  .site-footer__addr code {
    color: var(--gold);
    overflow-wrap: anywhere;
  }

  .site-footer__nav {
    display: flex;
    gap: 1rem 3.5rem;
  }

  .site-footer__nav ul {
    display: grid;
    align-content: start;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__nav a {
    color: var(--bone-2);
    text-decoration: none;
  }

  .site-footer__nav a:hover {
    color: var(--gold);
    text-decoration: underline;
  }

  .site-footer__legal {
    grid-column: 1 / -1;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--ash-2);
    font-size: 0.9375rem;
  }

  @media (max-width: 40rem) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }

    .site-footer__nav {
      gap: 1rem 2rem;
      flex-wrap: wrap;
    }
  }
</style>
