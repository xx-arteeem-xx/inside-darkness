---
import Pixel from './Pixel.astro';
import Cards, { type Card } from './Cards.astro';
import { GLYPHS } from '../lib/emblems';
import { G, HOMES, fmt, pct, plus, count, range } from '../data/game';
import { docHref } from '../lib/docs';

const housingHref = await docHref('housing');
const cityHref = await docHref('city');
const H = HOMES;
const W = G.dwelling;
const tavernNames = H.taverns.map((t) => t.name.replace(/ таверна$/, '').replace('Таверна в джунглях', 'в джунглях')).join(', ');

const deeds = [
  {
    id: 'inn',
    glyph: 'bed' as const,
    name: 'Комната в ночлежке',
    where: 'Цитадель столицы',
    price: fmt(H.inn.rent),
    per: 'монет в сутки',
    rows: [
      ['Мест', count(H.inn.count, ['комната', 'комнаты', 'комнат'])],
      ['Внутри', 'кровать и сундук'],
      ['Срок', `${H.terms.days.map(fmt).join(', ')} суток, вперёд — до ${fmt(H.terms.ahead)}`],
      ['Сдаёт', G.npcs.who.innkeeper.name],
    ],
  },
  {
    id: 'tavern',
    glyph: 'bread' as const,
    name: 'Комната в таверне',
    where: tavernNames,
    price: fmt(H.tavernRent),
    per: 'монет в сутки',
    rows: [
      ['Мест', H.tavernRooms ? `${count(H.tavernCount, ['таверна', 'таверны', 'таверн'])} по ${count(H.tavernRooms, ['комнате', 'комнаты', 'комнат'])}` : `${count(H.tavernTotal, ['комната', 'комнаты', 'комнат'])} в ${count(H.tavernCount, ['таверне', 'тавернах', 'тавернах'])}`],
      ['Сдаёт', 'трактирщик'],
    ],
  },
];

const city: Card[] = [
  {
    glyph: 'bed',
    name: 'Своё жильё',
    sub: 'что оно даёт',
    text: [
      '<b>Кровать — точка возрождения.</b> Погиб — очнёшься у себя, а не на площади столицы.',
      `<b>Отдых:</b> выспался дома — ${count(W.restMinutes, ['минуту', 'минуты', 'минут'])} ${plus(W.xpBonus)} опыта всех ремёсел и лёгкая регенерация, не чаще раза в ${count(W.cooldownHours, ['час', 'часа', 'часов'])}.`,
      `<b>«Домой»</b> у ямщика — за ${pct(G.roads.homeDiscount)} цены поездки.`,
    ],
  },
  {
    glyph: 'house',
    name: 'Купленный дом',
    sub: 'навсегда',
    text: [
      'Табличка с твоим именем у двери, и все сундуки дома — твои.',
      `Арендатору открыта только часть сундуков: ${pct(W.renterShare)}, но не меньше ${fmt(W.renterMin)}.`,
    ],
  },
  {
    glyph: 'pouch',
    name: 'Банк',
    sub: `${G.bank.npc}, у входа в донжон`,
    text: [
      `Личная ячейка для вещей, даром. Мест — от ${fmt(G.bank.slots[0])} до ${fmt(G.bank.slots[G.bank.slots.length - 1])}: растёт с рангом торгового дела.`,
      'Съехал или кончился срок — вещи из сундуков жилья переезжают в ячейку, а не пропадают.',
    ],
  },
  {
    glyph: 'banner',
    name: 'Доска почёта',
    sub: `${G.honor.npc}, двор цитадели`,
    text: [`Первые ${fmt(G.honor.top)} княжества по ${count(G.honor.count, ['вкладке', 'вкладкам', 'вкладкам'])}: ${G.honor.titles.join(', ')}. Своё место — внизу.`],
  },
];
---
<section class="housing section" id="housing" aria-labelledby="housing-title">
  <div class="wrap housing__grid">
    <header class="section-head housing__head">
      <h2 class="section-title" id="housing-title">Город и жильё</h2>
      <p class="section-lead">
        Двери, сундуки, кровать, печь и верстак работают только в своём жилье. Всего {count(H.total, ['жилище', 'жилища', 'жилищ'])}: комнаты в
        ночлежке и тавернах, дома во всех деревнях.
      </p>
      <ul class="housing__rules" role="list">
        <li>Одно жильё на игрока. Сутки — реальные, идут и когда ты не в игре.</li>
        <li>Остаток аренды виден в табло справа: <span class="board">Жильё: Комната 12 · 29 ч</span></li>
        <li>Кончился срок — жильё освобождается. Продлить можно заранее у того же жителя.</li>
        <li>Съехать или продать дом — там же, <kbd>Shift</kbd> + клик. Вещи из сундуков уедут в банк.</li>
        <li>Ранг в торговом деле снижает аренду на {range(G.effects['trade-rent'][1] * 100, G.effects['trade-rent'][4] * 100)}%.</li>
      </ul>
      <a class="more" href={housingHref}>Всё о жилье</a>
    </header>

    <ul class="deeds" role="list">
      {deeds.map((d) => (
        <li class:list={['deed', `deed--${d.id}`]}>
          <div class="deed__top">
            <span class="slot" aria-hidden="true"><Pixel grid={GLYPHS[d.glyph]} /></span>
            <div>
              <h3 class="deed__name">{d.name}</h3>
              <p class="deed__where">{d.where}</p>
            </div>
          </div>
          <p class="deed__price"><b>{d.price}</b> {d.per}</p>
          <dl class="deed__rows">
            {d.rows.map(([k, v]) => (
              <div><dt>{k}</dt><dd>{v}</dd></div>
            ))}
          </dl>
        </li>
      ))}
      <li class="deed deed--house">
        <div class="deed__top">
          <span class="slot" aria-hidden="true"><Pixel grid={GLYPHS.house} /></span>
          <div>
            <h3 class="deed__name">Дом в деревне</h3>
            <p class="deed__where">{count(H.houses, ['дом', 'дома', 'домов'])} во всех деревнях, у старост</p>
          </div>
        </div>
        <p class="deed__price">
          <b>{range(H.rentMin, H.rentMax)}</b> монет в сутки, навсегда — {range(H.priceMin, H.priceMax)}
        </p>
        <table class="tiers">
          <thead>
            <tr><th scope="col">Деревня</th><th scope="col">В сутки</th><th scope="col">Навсегда</th></tr>
          </thead>
          <tbody>
            {H.tiers.map((t) => (
              <tr>
                <th scope="row">{t.names.join(', ')}</th>
                <td>{fmt(t.rent)}</td>
                <td>{fmt(t.price)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </li>
    </ul>

    <div class="city">
      <Cards cards={city} cols={4} />
      <p class="city__more"><a class="more" href={cityHref}>Банк и доска почёта</a></p>
    </div>
  </div>
</section>

<style>
  .housing {
    background: var(--slate-0);
  }

  .city {
    grid-column: 1 / -1;
  }

  .city__more {
    margin-top: 1.5rem;
  }

  .housing__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 2.5rem clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .housing__head .more {
    justify-self: start;
  }

  .housing__rules {
    display: grid;
    gap: 0.5rem;
    margin: 0.25rem 0 0.5rem;
    padding: 0;
    list-style: none;
    color: var(--bone-2);
  }

  .housing__rules li {
    position: relative;
    padding-left: 1.1rem;
  }

  /* Строка табло справа, как в игре. */
  .board {
    display: inline-block;
    padding: 0.05rem 0.45rem;
    background: rgb(0 0 0 / 0.55);
    color: #f3f0e6;
    font-family: var(--font-pixel);
    font-size: 0.9375rem;
  }

  .housing__rules li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 6px;
    height: 6px;
    background: var(--torch);
  }

  .deeds {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Грамота на жильё: пергамент в тёмной раме. */
  .deed {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: 1.4rem 1.3rem 1.3rem;
    background:
      linear-gradient(180deg, rgb(237 163 60 / 0.07), transparent 40%),
      #1f1d22;
    box-shadow:
      inset 0 0 0 2px #0b0b0e,
      inset 2px 2px 0 2px #3a362f,
      inset -2px -2px 0 2px #121116;
  }

  .deed--house {
    grid-column: 1 / -1;
    background:
      linear-gradient(180deg, rgb(163 44 60 / 0.12), transparent 40%),
      #1f1d22;
  }

  .deed--house .deed__price b {
    font-size: var(--fs-lg);
  }

  /* Цены домов по деревням. */
  .tiers {
    width: 100%;
    border-collapse: collapse;
    font-size: 1rem;
  }

  .tiers th,
  .tiers td {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--line);
    text-align: right;
    vertical-align: baseline;
  }

  .tiers thead th {
    border-top: 1px dashed var(--line-2);
    color: var(--ash);
    font-weight: 400;
  }

  .tiers thead th + th {
    padding-left: 1rem;
    white-space: nowrap;
  }

  .tiers th:first-child {
    padding-right: 1rem;
    text-align: left;
  }

  .tiers tbody th {
    color: var(--bone);
    font-weight: 400;
  }

  .tiers td {
    padding-left: 1rem;
    color: var(--gold);
    font-family: var(--font-pixel);
    white-space: nowrap;
  }

  .deed__top {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.9rem;
  }

  .slot {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    background: #26272f;
    box-shadow:
      inset 3px 3px 0 #0e0e12,
      inset -3px -3px 0 #464856;
  }

  .slot :global(.pixel) {
    width: 2.1rem;
    height: 2.1rem;
  }

  .deed__name {
    font-size: var(--fs-md);
    line-height: 1.15;
  }

  .deed__where {
    margin-top: 0.15rem;
    color: var(--ash);
    font-size: 0.9375rem;
  }

  .deed__price {
    color: var(--bone-2);
  }

  .deed__price b {
    margin-right: 0.3rem;
    color: var(--gold);
    font-size: var(--fs-xl);
    font-weight: 900;
    line-height: 1;
  }

  .deed__rows {
    display: grid;
    margin: 0;
    border-top: 1px dashed var(--line-2);
  }

  .deed__rows div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--line);
    font-size: 1rem;
  }

  .deed__rows dt {
    color: var(--ash);
  }

  .deed__rows dd {
    margin: 0;
    color: var(--bone);
    text-align: right;
  }

  @media (max-width: 64rem) {
    .city {
    grid-column: 1 / -1;
  }

  .city__more {
    margin-top: 1.5rem;
  }

  .housing__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 40rem) {
    .deeds {
      grid-template-columns: 1fr;
    }
  }
</style>
