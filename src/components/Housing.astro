---
import Pixel from './Pixel.astro';
import { GLYPHS } from '../lib/emblems';
import { docHref } from '../lib/docs';

const housingHref = await docHref('housing');

const deeds = [
  {
    id: 'inn',
    glyph: 'bed' as const,
    name: 'Комната в ночлежке',
    where: 'Столица',
    price: '20',
    per: 'монет в сутки',
    rows: [
      ['Мест', '20 комнат'],
      ['Внутри', 'кровать и сундук'],
      ['Срок', '1, 3 или 7 суток, не больше 14 вперёд'],
      ['Сдаёт', 'хозяйка ночлежки'],
    ],
  },
  {
    id: 'house',
    glyph: 'house' as const,
    name: 'Дом в деревне',
    where: 'Деревня за южными воротами столицы',
    price: '120',
    per: 'монет в сутки',
    rows: [
      ['Мест', '5 домов'],
      ['Купить навсегда', '8000 монет'],
      ['Сдаёт и продаёт', 'староста'],
    ],
  },
];
---
<section class="housing section" id="housing" aria-labelledby="housing-title">
  <div class="wrap housing__grid">
    <header class="section-head housing__head">
      <h2 class="section-title" id="housing-title">Жильё</h2>
      <p class="section-lead">
        Двери, сундуки, кровать, печь и верстак работают только в своём жилье: в снятой комнате или своём доме.
      </p>
      <ul class="housing__rules" role="list">
        <li>Одно жильё на игрока.</li>
        <li>Сутки — реальные 24 часа, идут и когда ты не в игре.</li>
        <li>Остаток аренды виден в часах в табло справа: <span class="board">Жильё: Комната 12 · 29 ч</span></li>
        <li>Кончился срок — жильё освобождается. Продлить можно заранее у того же NPC.</li>
        <li>Ранг в торговом деле снижает аренду на 5–20%.</li>
        <li>Ворота и калитки построек открыты для всех.</li>
      </ul>
      <a class="more" href={housingHref}>Всё о жилье</a>
    </header>

    <ul class="deeds" role="list">
      {deeds.map((d) => (
        <li class:list={['deed', `deed--${d.id}`]}>
          <div class="deed__top">
            <span class="slot" aria-hidden="true"><Pixel grid={GLYPHS[d.glyph]} /></span>
            <div>
              <h3 class="deed__name">{d.name}</h3>
              <p class="deed__where">{d.where}</p>
            </div>
          </div>
          <p class="deed__price"><b>{d.price}</b> {d.per}</p>
          <dl class="deed__rows">
            {d.rows.map(([k, v]) => (
              <div><dt>{k}</dt><dd>{v}</dd></div>
            ))}
          </dl>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .housing {
    background: var(--slate-0);
  }

  .housing__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 2.5rem clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .housing__head .more {
    justify-self: start;
  }

  .housing__rules {
    display: grid;
    gap: 0.5rem;
    margin: 0.25rem 0 0.5rem;
    padding: 0;
    list-style: none;
    color: var(--bone-2);
  }

  .housing__rules li {
    position: relative;
    padding-left: 1.1rem;
  }

  /* Строка табло справа, как в игре. */
  .board {
    display: inline-block;
    padding: 0.05rem 0.45rem;
    background: rgb(0 0 0 / 0.55);
    color: #f3f0e6;
    font-family: var(--font-pixel);
    font-size: 0.9375rem;
  }

  .housing__rules li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 6px;
    height: 6px;
    background: var(--torch);
  }

  .deeds {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Грамота на жильё: пергамент в тёмной раме. */
  .deed {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: 1.4rem 1.3rem 1.3rem;
    background:
      linear-gradient(180deg, rgb(237 163 60 / 0.07), transparent 40%),
      #1f1d22;
    box-shadow:
      inset 0 0 0 2px #0b0b0e,
      inset 2px 2px 0 2px #3a362f,
      inset -2px -2px 0 2px #121116;
  }

  .deed--house {
    background:
      linear-gradient(180deg, rgb(163 44 60 / 0.12), transparent 40%),
      #1f1d22;
  }

  .deed__top {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.9rem;
  }

  .slot {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    background: #26272f;
    box-shadow:
      inset 3px 3px 0 #0e0e12,
      inset -3px -3px 0 #464856;
  }

  .slot :global(.pixel) {
    width: 2.1rem;
    height: 2.1rem;
  }

  .deed__name {
    font-size: var(--fs-md);
    line-height: 1.15;
  }

  .deed__where {
    margin-top: 0.15rem;
    color: var(--ash);
    font-size: 0.9375rem;
  }

  .deed__price {
    color: var(--bone-2);
  }

  .deed__price b {
    margin-right: 0.3rem;
    color: var(--gold);
    font-size: var(--fs-xl);
    font-weight: 900;
    line-height: 1;
  }

  .deed__rows {
    display: grid;
    margin: 0;
    border-top: 1px dashed var(--line-2);
  }

  .deed__rows div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--line);
    font-size: 1rem;
  }

  .deed__rows dt {
    color: var(--ash);
  }

  .deed__rows dd {
    margin: 0;
    color: var(--bone);
    text-align: right;
  }

  @media (max-width: 64rem) {
    .housing__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 40rem) {
    .deeds {
      grid-template-columns: 1fr;
    }
  }
</style>
