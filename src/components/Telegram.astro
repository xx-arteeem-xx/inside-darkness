---
import links from '../config/links.json';

const channel = (links.telegram?.channel ?? '').trim();
const chat = (links.telegram?.chat ?? '').trim();
const rows = [
  { name: 'Канал', text: 'Обновления, набеги тьмы, поверженные боссы и свежие вести.', href: channel, cta: 'Открыть канал' },
  { name: 'Чат', text: 'Общение игроков: вопросы, сделки, поиск компании в поход.', href: chat, cta: 'Открыть чат' },
];
const any = Boolean(channel || chat);
---
<section class="community section" id="telegram" aria-labelledby="tg-title">
  <svg class="strata" viewBox="0 0 1440 24" preserveAspectRatio="none" aria-hidden="true" shape-rendering="crispEdges">
    <path fill="#17171c" d="M0 24V8h64v8h120V4h96v12h144V8h72v8h160V0h88v12h120V4h136v12h104V8h120v8h96V24z" />
  </svg>
  <div class="wrap community__grid">
    <div class="tg">
      <h2 class="section-title" id="tg-title">Сообщество</h2>
      <p class="section-lead">
        {any ? 'Новости и общение игроков в Telegram.' : 'Канал и чат в Telegram готовятся. Ссылки появятся здесь.'}
      </p>
      <ul class="tg__list" role="list">
        {rows.map((r) => (
          <li class="tg__row">
            <div>
              <h3 class="tg__name">Telegram: {r.name.toLowerCase()}</h3>
              <p class="tg__text">{r.text}</p>
            </div>
            {r.href ? (
              <a class="btn btn--quiet btn--small" href={r.href} rel="noopener">{r.cta}</a>
            ) : (
              <span class="tag">скоро</span>
            )}
          </li>
        ))}
      </ul>
    </div>

    <div class="soon" aria-labelledby="soon-title">
      <h3 class="soon__title" id="soon-title">В работе</h3>
      <ul class="soon__list" role="list">
        <li>
          <p class="soon__name">Донаты</p>
          <p>Перевод по СБП и криптовалюта. Реквизиты появятся в разделе ниже.</p>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .community {
    background: #17171c;
  }

  .community__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 3rem clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .tg__list {
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .tg__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.1rem;
    border-top: 1px solid var(--line-2);
  }

  .tg__row:last-child {
    border-bottom: 1px solid var(--line-2);
  }

  .tg__name {
    font-size: var(--fs-md);
  }

  .tg__text {
    color: var(--ash);
  }

  /* Список «в работе»: пунктир строительных лесов слева. */
  .soon {
    padding: clamp(1.5rem, 3vw, 2rem);
    background: var(--slate-0);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .soon__title {
    font-size: var(--fs-lg);
  }

  .soon__list {
    display: grid;
    gap: 1.25rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .soon__list li {
    padding-left: 1.1rem;
    background: repeating-linear-gradient(180deg, var(--gold-deep) 0 6px, transparent 6px 12px) 0 0.3rem / 2px calc(100% - 0.3rem) no-repeat;
  }

  .soon__name {
    color: var(--bone);
    font-weight: 700;
  }

  .soon__list p + p {
    color: var(--ash);
    font-size: 1rem;
  }

  @media (max-width: 56rem) {
    .community__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
