---
import Pixel from './Pixel.astro';
import { CRESTS, GLYPHS } from '../lib/emblems';
import { G, RACES, RACE_CHANGE, RANKS, RANK_XP, RANK_FEE, RANK_FEE_TRADE, TRADES, fmt, pct, count } from '../data/game';
import { docHref } from '../lib/docs';

const ranksHref = await docHref('ranks');
const ordersHref = await docHref('orders');
const who = G.npcs.who;
const proof = G.crafts.byId.mining.proof[1]?.[0] ?? '';
const xpTop = Math.max(...RANK_XP);
const ranks = RANKS.map((name, i) => ({
  n: i + 1,
  name,
  xp: i === 0 ? null : RANK_XP[i - 1],
  fee: i === 0 ? null : RANK_FEE[i - 1],
}));
const fees = RANK_FEE.map(fmt).join(', ');
const tradeFees = RANK_FEE_TRADE.map(fmt).join(', ');
---
<section class="village section" id="village" aria-labelledby="village-title">
  <svg class="strata" viewBox="0 0 1440 24" preserveAspectRatio="none" aria-hidden="true" shape-rendering="crispEdges">
    <path fill="#1a181d" d="M0 24V12h88V4h136v12h160V8h96v8h120V0h72v12h184V8h104v8h112V4h128v12h96V8h144V24z" />
  </svg>
  <div class="wrap">
    <header class="section-head">
      <h2 class="section-title" id="village-title">Деревня мастеров</h2>
      <p class="section-lead">
        Сразу за южными воротами столицы. Старейшина принимает в народ, мастера дают ранги в ремёслах, староста даёт
        заказы на день и сдаёт дома, знахарка продаёт зелья, картограф — карты и клады. Провожатый у въезда покажет,
        кто где живёт.
      </p>
    </header>

    <div class="races-head">
      <h3 class="sub-title">Народы</h3>
      <p>
        Каждый даёт +{pct(G.races.xpBonus)} опыта своему ремеслу и свой дар. Первый выбор у старейшины бесплатный, сменить — <b>{fmt(RACE_CHANGE)} монет</b>.
      </p>
    </div>
    <ul class="races" role="list">
      {RACES.map((race) => (
        <li class:list={['race', `race--${race.id}`]}>
          <Pixel grid={CRESTS[race.id]} class="race__crest" />
          <h4 class="race__name">{race.name}</h4>
          <p class="race__who">{race.who}</p>
          <ul class="race__bonus" role="list">
            {race.bonus.map((b) => <li>{b}</li>)}
          </ul>
          <p class="race__fits"><span>Кому:</span> {race.fits}</p>
        </li>
      ))}
    </ul>

    <div class="masters">
      <div class="masters__text">
        <h3 class="sub-title">Ремёсла и ранги</h3>
        <p>
          {count(G.crafts.count, ['ремесло', 'ремесла', 'ремёсел'])}, в каждом {count(RANKS.length, ['ранг', 'ранга', 'рангов'])}. Опыт копится делом: рудой в шахте, урожаем, брёвнами, уловом, тварями,
          торговлей. Набрал опыт — иди к мастеру ремесла, он посвятит в следующий ранг.
        </p>
        <ol class="rite" role="list">
          <li><b>Опыт</b> <span>копится сам, пока работаешь; заказы старост дают его сверху (<a href={ordersHref}>заказы</a>)</span></li>
          <li><b>Проба</b> <span>товар ремесла, мастер её забирает: например, {proof} на «{RANKS[1]}» в горном деле</span></li>
          <li><b>Плата</b> <span>{fees} монет за ранги со второго по последний, у торгового дела {tradeFees}</span></li>
        </ol>
        <p class="masters__note">
          Ранг — ещё и пропуск: с ранга «{RANKS[2]}» продают незерит и редкое оружие, а ранг «{G.vedun.rank}» {G.vedun.craftGen} открывает ведуна с чарами сверх предела.
        </p>
      </div>

      <figure class="ladder">
        <figcaption class="ladder__title">Опыт для ранга и плата мастеру, монет</figcaption>
        <ol class="ranks" role="list">
          {ranks.map((r) => (
            <li class="rank">
              <span class="rank__n" aria-hidden="true">{r.n}</span>
              <div class="rank__body">
                <p class="rank__line">
                  <span class="rank__name">{r.name}</span>
                  <span class="rank__xp">{r.xp === null ? 'начало пути' : `${fmt(r.xp)} опыта`}</span>
                </p>
                <span class="rank__track" aria-hidden="true">
                  {r.xp !== null && <span class="rank__fill" style={`width:${((r.xp / xpTop) * 100).toFixed(1)}%`}></span>}
                </span>
              </div>
              <p class="rank__fee">{r.fee === null ? '—' : fmt(r.fee)}</p>
            </li>
          ))}
        </ol>
      </figure>
    </div>

    <ul class="trades" role="list">
      {TRADES.map((t) => (
        <li class:list={['trade', `trade--${t.id}`]}>
          <div class="trade__top">
            <span class="slot" aria-hidden="true"><Pixel grid={GLYPHS[t.glyph]} /></span>
            <div>
              <h4 class="trade__name">{t.name}</h4>
              <p class="trade__who">{t.master} · {t.where}</p>
            </div>
          </div>
          <p class="trade__xp"><span>Опыт:</span> {t.xp}</p>
          <ul class="trade__perks" role="list">
            {t.perks.map((p) => <li>{p}</li>)}
          </ul>
        </li>
      ))}
    </ul>

    <p class="village__more">
      <a class="more" href={ranksHref}>Ремёсла, ранги и народы подробно</a>
    </p>
  </div>
</section>

<style>
  .village {
    background:
      radial-gradient(70% 50% at 85% 0%, rgb(124 31 44 / 0.12), transparent 70%),
      #1a181d;
  }

  .sub-title {
    font-size: var(--fs-lg);
  }

  .races-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--line-2);
  }

  .races-head p {
    color: var(--bone-2);
  }

  .races-head b {
    color: var(--gold);
  }

  .races {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  /* Карточка народа: вставка в каменной раме, герб поднят над полем. */
  .race {
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    justify-items: start;
    gap: 0.5rem;
    padding: 1.4rem 1.25rem 1.25rem;
    background: #1f1d24;
    box-shadow:
      inset 0 0 0 2px #0b0b0e,
      inset 2px 2px 0 2px #36343f,
      inset -2px -2px 0 2px #121116;
  }

  .race :global(.race__crest) {
    width: 4.5rem;
    height: 4.8rem;
    margin-bottom: 0.5rem;
    filter: drop-shadow(0 5px 0 rgb(0 0 0 / 0.45));
  }

  .race__name {
    font-size: var(--fs-md);
    line-height: 1.15;
  }

  .race__who {
    color: var(--ash);
    font-size: 1rem;
  }

  .race__bonus {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .race__bonus li {
    position: relative;
    padding-left: 1.1rem;
    color: var(--gold);
    font-weight: 700;
    line-height: 1.35;
  }

  .race__bonus li::before {
    content: '+';
    position: absolute;
    left: 0;
    top: 0.05em;
    color: var(--moss);
    font-family: var(--font-pixel);
  }

  .race__fits {
    margin-top: 0.5rem;
    padding-top: 0.6rem;
    width: 100%;
    border-top: 1px dashed var(--line-2);
    color: var(--bone-2);
    font-size: 1rem;
  }

  .race__fits span {
    color: var(--ash);
  }

  /* ——— ремёсла и ранги ——— */
  .masters {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: 2.5rem clamp(2.5rem, 6vw, 5rem);
    align-items: start;
    margin-top: clamp(3.5rem, 8vw, 5.5rem);
  }

  .masters__text > p {
    margin-top: 0.9rem;
    color: var(--bone-2);
  }

  .masters__text > .masters__note {
    color: var(--ash);
    font-size: 1rem;
  }

  /* Посвящение в три условия: опыт, проба, плата. */
  .rite {
    display: grid;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-2);
    counter-reset: rite;
  }

  .rite li {
    display: grid;
    grid-template-columns: 2rem minmax(5rem, auto) minmax(0, 1fr);
    gap: 0.2rem 1rem;
    align-items: baseline;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--line);
    counter-increment: rite;
  }

  .rite li::before {
    content: counter(rite);
    color: var(--torch);
    font-family: var(--font-pixel);
  }

  .rite b {
    color: var(--bone);
  }

  .rite span {
    color: var(--bone-2);
  }

  /* Лестница рангов: длина полосы — накопленный опыт. */
  .ladder {
    margin: 0;
    padding: 1.25rem 1.25rem 1.1rem;
    background: var(--slate-0);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .ladder__title {
    color: var(--ash);
    font-size: 1rem;
  }

  .ranks {
    display: grid;
    gap: 0.9rem;
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .rank {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr) 3.75rem;
    align-items: end;
    gap: 0 0.75rem;
  }

  .rank__n {
    color: var(--torch);
    font-family: var(--font-pixel);
    font-size: 1.125rem;
    line-height: 1.2;
  }

  .rank__line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 0.75rem;
  }

  .rank__name {
    color: var(--bone);
    font-weight: 700;
  }

  .rank__xp {
    color: var(--ash);
    font-size: 0.9375rem;
    white-space: nowrap;
  }

  .rank__track {
    position: relative;
    display: block;
    height: 12px;
    margin-top: 0.3rem;
    background:
      repeating-linear-gradient(90deg, rgb(236 228 208 / 0.08) 0 1px, transparent 1px 10%),
      #0b0c0f;
    box-shadow: inset 0 0 0 1px var(--slate-3);
  }

  .rank__fill {
    position: absolute;
    top: 2px;
    bottom: 2px;
    left: 2px;
    min-width: 6px;
    max-width: calc(100% - 4px);
    background: linear-gradient(#b7ec8a 0 45%, #6fae3f 45%);
    box-shadow: inset 0 -2px 0 rgb(0 40 0 / 0.4);
  }

  .rank__fee {
    color: var(--gold);
    font-family: var(--font-pixel);
    font-size: 1rem;
    line-height: 1.2;
    text-align: right;
    white-space: nowrap;
  }

  /* ——— шесть ремёсел ——— */
  .trades {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: clamp(2rem, 5vw, 3rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .trade {
    display: grid;
    align-content: start;
    gap: 0.8rem;
    padding: 1.1rem 1.15rem 1.2rem;
    background: #1f1d24;
    box-shadow:
      inset 0 0 0 2px #0b0b0e,
      inset 2px 2px 0 2px #36343f,
      inset -2px -2px 0 2px #121116;
  }

  .trade__top {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.9rem;
  }

  .trade__name {
    font-size: var(--fs-md);
    line-height: 1.15;
  }

  .trade__who {
    margin-top: 0.15rem;
    color: var(--ash);
    font-size: 0.9375rem;
    line-height: 1.35;
  }

  .trade__xp {
    color: var(--bone-2);
    font-size: 1rem;
    line-height: 1.45;
  }

  .trade__xp span {
    color: var(--ash);
  }

  .trade__perks {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding: 0.75rem 0 0;
    list-style: none;
    border-top: 1px dashed var(--line-2);
    color: var(--gold);
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  .trade__perks li {
    position: relative;
    padding-left: 1rem;
  }

  .trade__perks li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 5px;
    height: 5px;
    background: var(--moss);
  }

  .slot {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    background: #26272f;
    box-shadow:
      inset 3px 3px 0 #0e0e12,
      inset -3px -3px 0 #464856;
  }

  .slot :global(.pixel) {
    width: 2.1rem;
    height: 2.1rem;
  }

  .village__more {
    margin-top: 2.5rem;
  }

  @media (max-width: 64rem) {
    .races,
    .trades {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .masters {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 40rem) {
    .trades {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 36rem) {
    .races {
      grid-template-columns: 1fr;
    }

    .rite li {
      grid-template-columns: 2rem minmax(0, 1fr);
    }

    .rite span {
      grid-column: 2;
    }

    .ladder {
      padding-inline: 1rem;
    }

    .rank {
      grid-template-columns: 1.25rem minmax(0, 1fr) 3.25rem;
      gap: 0 0.6rem;
    }

    .rank__fee {
      font-size: 0.9375rem;
    }
  }
</style>
