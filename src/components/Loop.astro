---
import Pixel from './Pixel.astro';
import { GLYPHS, type GlyphId } from '../lib/emblems';
import { START_COINS, ENCHANT, enchantStep, SHULKER_PRICE, RANKS, STATIONS, ROAD, MAIL, DEMAND, fare } from '../data/game';
import { docHref } from '../lib/docs';

const economyHref = await docHref('economy');
const startHref = await docHref('start');
const roadsHref = await docHref('roads');
const villageHref = await docHref('village');
const capital = STATIONS[0];
const farthest = Math.max(...STATIONS.map((s) => fare(capital, s)));
const x = (n: number) => String(n).replace('.', ',');
const fmt = (n: number) => n.toLocaleString('ru-RU').replace(/ /g, ' ');
const ROMAN = ['I', 'II', 'III', 'IV', 'V'];
const sharp = ROMAN.map((r, i) => [r, enchantStep(ENCHANT.sharpness.base, i + 1)] as const);

const steps: Array<{ glyph: GlyphId; title: string; text: string }> = [
  { glyph: 'pickaxe', title: 'Добываешь', text: 'Руда в шахте, урожай на поле, брёвна в саду, рыба. Или трофеи с мобов в подземельях и тёмных землях.' },
  { glyph: 'pouch', title: 'Продаёшь купцу', text: 'ПКМ по купцу открывает его окно. Кликнул по товару в своём инвентаре — продано.' },
  { glyph: 'coin', title: 'Получаешь монеты', text: 'Баланс всплывает над хотбаром. Командой монеты не передать, но другу их можно отправить посылкой у ямщика.' },
  { glyph: 'anvil', title: 'Растёшь в ремесле', text: 'Опыт копится делом. Мастер в деревне за пробу и плату даёт новый ранг: дороже продажа, больше добычи, урон и сердца.' },
];

// Окно рудного купца: цены из конфига плагина 1.7.0, раскладка окна упрощена.
const IRON = 3;
const lot = 32;
const prices: Array<GlyphId | null> = ['coal', 'iron', 'gold', 'gem', null, null, null, null, null];
const bag: Array<[GlyphId, number] | null> = [['pickaxe', 1], ['iron', lot], ['coal', 20], ['gem', 2], ['bread', 6], null, null, null, null];
const picked = 1;
const gain = IRON * lot;
---
<section class="loop section" id="how" aria-labelledby="how-title">
  <div class="wrap">
    <header class="section-head">
      <h2 class="section-title" id="how-title">Как устроена игра</h2>
      <p class="section-lead">
        Один круг на всю игру: добыл, продал, получил монеты, вырос в ремесле. Со следующим кругом тот же час работы
        приносит больше.
      </p>
    </header>

    <ol class="cycle" role="list">
      {steps.map((s, i) => (
        <li class="cycle__step">
          <span class="slot" aria-hidden="true"><Pixel grid={GLYPHS[s.glyph]} /></span>
          <p class="cycle__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="cycle__title">{s.title}</h3>
          <p class="cycle__text">{s.text}</p>
        </li>
      ))}
    </ol>
    <p class="cycle__back">
      <span class="cycle__arrow" aria-hidden="true"></span>
      И снова к шахте, полю или в подземелье, но уже рангом выше.
    </p>

    <div class="npc">
      <div class="npc__text">
        <h3 class="npc__title">Всё через NPC и их окна</h3>
        <p>
          Команд вроде <code>/sell</code> нет. Жмёшь ПКМ по NPC — открывается его окно. Продать или выбрать вещь — клик
          по ней в своём инвентаре.
        </p>
        <dl class="gestures">
          <div>
            <dt><kbd>Клик</kbd> по своей вещи</dt>
            <dd>продана вся стопка</dd>
          </div>
          <div>
            <dt><kbd>Shift</kbd> + <kbd>клик</kbd></dt>
            <dd>продан весь такой товар из инвентаря</dd>
          </div>
          <div>
            <dt><kbd>ПКМ</kbd> по вещи в окне</dt>
            <dd>продана одна штука</dd>
          </div>
          <div>
            <dt>«Продать всё подходящее»</dt>
            <dd>всё, что берёт этот купец</dd>
          </div>
        </dl>
        <p class="npc__nav">
          <b>Навигатор.</b> Стрелка и расстояние сверху экрана ведут к цели, нужный NPC подсвечивается. Дорогу
          показывают проводник Добромир у точки спавна, глашатаи у входов на рынок и провожатый у въезда в деревню
          мастеров.
        </p>
        <p class="npc__more">Цены скупки и покупки: <a href={economyHref}>Монеты и рынок</a>. Первые шаги: <a href={startHref}>Начало игры</a>.</p>
      </div>

      <figure class="screen">
        <div class="screen__view" aria-hidden="true">
          <div class="navbar">
            <p class="navbar__label"><span class="navbar__arrow">↑</span> Рудный купец · 14 м</p>
            <span class="navbar__bar"></span>
          </div>
          <div class="gui">
            <p class="gui__title">Рудный купец · скупка</p>
            <div class="gui__grid">
              {prices.map((g) => (
                <span class="gui__slot">{g && <Pixel grid={GLYPHS[g]} />}</span>
              ))}
              {Array.from({ length: 9 }, (_, i) => (
                <span class:list={['gui__slot', { 'gui__slot--btn': i === 4 }]}>{i === 4 && <Pixel grid={GLYPHS.pouch} />}</span>
              ))}
            </div>
            <p class="gui__title">Инвентарь</p>
            <div class="gui__grid">
              {bag.map((it, i) => (
                <span class:list={['gui__slot', { 'gui__slot--on': i === picked }]}>
                  {it && <Pixel grid={GLYPHS[it[0]]} />}
                  {it && it[1] > 1 && <span class="gui__count">{it[1]}</span>}
                </span>
              ))}
            </div>
            <div class="gui__tip">
              <p class="gui__tip-name">Рудное железо</p>
              <p>Цена: <span>{IRON}</span> за шт.</p>
              <p>У вас: {lot} шт. → <span>{gain}</span></p>
              <p class="gui__tip-act">Клик — продать стопку</p>
            </div>
          </div>
          <p class="screen__balance">+{gain} · {START_COINS + gain} монет</p>
        </div>
        <figcaption>
          Пример: окно рудного купца. Клик по руде в своём инвентаре — стопка продана, баланс всплывает над хотбаром.
          Сверху — навигатор.
        </figcaption>
      </figure>
    </div>

    <section class="roads" aria-labelledby="roads-block-title">
      <div class="market__head">
        <h3 class="npc__title" id="roads-block-title">Дороги, почта и заказы</h3>
        <p>Государство большое: по нему ездят на ямских, шлют посылки и берут заказы у старост.</p>
      </div>
      <ul class="roads__list" role="list">
        <li class="mcard">
          <div class="mcard__top">
            <span class="slot slot--sm" aria-hidden="true"><Pixel grid={GLYPHS.horseshoe} /></span>
            <h4 class="mcard__name">Ямская служба <span>{STATIONS.length} станций</span></h4>
          </div>
          <p class="mcard__text">
            У столицы, рынка, деревни мастеров, мест ремёсел, ристалища и шести деревень. Станция открывается, когда
            дойдёшь до неё пешком. Поездка — {ROAD.base} монет плюс 1 за каждые {ROAD.perBlocks} блоков: от столицы до
            самой дальней деревни ≈ {farthest}. Отправление через {ROAD.countdown} с, стой на месте.
          </p>
        </li>
        <li class="mcard">
          <div class="mcard__top">
            <span class="slot slot--sm" aria-hidden="true"><Pixel grid={GLYPHS.letter} /></span>
            <h4 class="mcard__name">Почта <span>у любого ямщика</span></h4>
          </div>
          <p class="mcard__text">
            Вещи, до {MAIL.maxStacks} стопок, и монеты любому игроку, даже если его нет в игре. Доставка — {MAIL.base} +
            {' '}{MAIL.perStack} за стопку + {MAIL.coinShare * 100}% от монет. Забрать посылку можно у любого ямщика.
          </p>
        </li>
        <li class="mcard">
          <div class="mcard__top">
            <span class="slot slot--sm" aria-hidden="true"><Pixel grid={GLYPHS.tome} /></span>
            <h4 class="mcard__name">Заказы старост <span>в каждой из 7 деревень</span></h4>
          </div>
          <p class="mcard__text">
            Каждый день 3 заказа: 2 простых и 1 для мастеров. Награда — монеты и опыт ремесла. Ещё у старосты видно,
            что сегодня в цене: сельский скупщик платит ×{x(DEMAND.hot)} за две темы товара и ×{x(DEMAND.cold)} за одну.
          </p>
        </li>
      </ul>
      <p class="roads__more">
        <a class="more" href={roadsHref}>Ямская служба и почта</a>
        <a class="more" href={`${villageHref}#старосты-и-заказы`}>Заказы старост</a>
      </p>
    </section>

    <section class="market" aria-labelledby="market-title">
      <div class="market__head">
        <h3 class="npc__title" id="market-title">Кто ещё есть на рынке</h3>
        <p>Кроме купцов и лавок с оружием, бронёй, инструментами и едой.</p>
      </div>
      <ul class="market__list" role="list">
        <li class="mcard mcard--enchant">
          <div class="mcard__top">
            <span class="slot slot--sm" aria-hidden="true"><Pixel grid={GLYPHS.tome} /></span>
            <h4 class="mcard__name">Чародей <span>прокачка снаряжения</span></h4>
          </div>
          <p class="mcard__text">
            Кликни по вещи в своём инвентаре или по надетой: в окне появятся чары, которые к ней подходят. Цена ступени —
            база × ступень².
          </p>
          <figure class="steps">
            <figcaption>{ENCHANT.sharpness.name}, база {ENCHANT.sharpness.base}</figcaption>
            <ol class="steps__list" role="list">
              {sharp.map(([r, price]) => (
                <li style={`--h:${(price / sharp[sharp.length - 1][1]).toFixed(3)}`}>
                  <span class="steps__price">{fmt(price)}</span>
                  <span class="steps__bar" aria-hidden="true"></span>
                  <span class="steps__lvl">{r}</span>
                </li>
              ))}
            </ol>
          </figure>
          <p class="mcard__text">
            Ступени до III — всем. IV открывает ранг {RANKS[2]}, V — {RANKS[3]} в подходящем ремесле: для оружия и
            брони это ратное дело.
          </p>
          <dl class="mcard__prices">
            {ENCHANT.examples.map((e) => (
              <div><dt>{e.name} <span>{e.need}</span></dt><dd>{fmt(e.price)}</dd></div>
            ))}
          </dl>
          <p class="mcard__note">Удачи и шёлкового касания у чародея нет.</p>
        </li>
        <li class="mcard">
          <div class="mcard__top">
            <span class="slot slot--sm" aria-hidden="true"><Pixel grid={GLYPHS.anvil} /></span>
            <h4 class="mcard__name">Кузнецы <span>оружейник, бронник, инструментщик</span></h4>
          </div>
          <p class="mcard__text">
            Не только продают: чинят за монеты и скупают снаряжение. Снятое с тварей ценится выше: алмазный нагрудник с
            твари, целый и без чар, — 475. Изготовленное или купленное — не дороже своих материалов.
          </p>
        </li>
        <li class="mcard">
          <div class="mcard__top">
            <span class="slot slot--sm" aria-hidden="true"><Pixel grid={GLYPHS.pouch} /></span>
            <h4 class="mcard__name">Старьёвщик</h4>
          </div>
          <p class="mcard__text">
            Берёт всё, что не берут другие купцы, за копейки: мелочь по 0,01 за штуку, железную вещь за 1, алмазную за 3.
            Купленное у NPC, трофеи и шалкеры не берёт.
          </p>
        </li>
        <li class="mcard">
          <div class="mcard__top">
            <span class="slot slot--sm" aria-hidden="true"><Pixel grid={GLYPHS.lantern} /></span>
            <h4 class="mcard__name">Фонарщик</h4>
          </div>
          <p class="mcard__text">
            Факелы ×16 за 8, фонарь за 30. Ставить их нельзя, зато в любой руке они светят вокруг тебя, и свет видят все
            рядом.
          </p>
        </li>
        <li class="mcard">
          <div class="mcard__top">
            <span class="slot slot--sm" aria-hidden="true"><Pixel grid={GLYPHS.shulker} /></span>
            <h4 class="mcard__name">Шалкер <span>у инструментщика</span></h4>
          </div>
          <p class="mcard__text">
            {SHULKER_PRICE} монет. Ставится где угодно, кроме карьера шахты. Открыть и забрать его может только тот, кто
            поставил.
          </p>
        </li>
      </ul>
      <a class="more market__more" href={`${economyHref}#чародей`}>Все чары, кузнецы, старьёвщик и лавки</a>
    </section>
  </div>
</section>

<style>
  .loop {
    background: var(--slate-0);
  }

  /* ——— круг ——— */
  .cycle {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem clamp(1.5rem, 3vw, 2.75rem);
    margin: clamp(2.5rem, 6vw, 4rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .cycle__step {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-content: start;
    gap: 0.25rem 1rem;
  }

  .cycle__step .slot {
    grid-row: span 2;
  }

  /* Пиксельная стрелка к следующему шагу. */
  .cycle__step:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 1.35rem;
    right: calc(-1 * clamp(1.5rem, 3vw, 2.75rem) + 0.35rem);
    width: calc(clamp(1.5rem, 3vw, 2.75rem) - 0.7rem);
    height: 10px;
    background:
      linear-gradient(var(--gold-deep), var(--gold-deep)) left 0 top 4px / calc(100% - 6px) 2px no-repeat,
      linear-gradient(var(--gold), var(--gold)) right 4px top 0 / 2px 10px no-repeat,
      linear-gradient(var(--gold), var(--gold)) right 2px top 2px / 2px 6px no-repeat,
      linear-gradient(var(--gold), var(--gold)) right 0 top 4px / 2px 2px no-repeat;
  }

  .cycle__n {
    align-self: end;
    color: var(--torch);
    font-family: var(--font-pixel);
    font-size: 1rem;
    line-height: 1;
  }

  .cycle__title {
    align-self: start;
    font-size: var(--fs-md);
    line-height: 1.15;
  }

  .cycle__text {
    grid-column: 1 / -1;
    margin-top: 0.75rem;
    color: var(--bone-2);
  }

  .cycle__back {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2.25rem;
    padding: 0.85rem 1.1rem;
    background: rgb(237 163 60 / 0.06);
    box-shadow: inset 0 0 0 1px rgb(237 163 60 / 0.25);
    color: var(--bone);
  }

  /* Стрелка «назад к началу»: уголок из пикселей. */
  .cycle__arrow {
    flex: none;
    width: 22px;
    height: 16px;
    background:
      linear-gradient(var(--gold), var(--gold)) 4px 2px / 18px 3px no-repeat,
      linear-gradient(var(--gold), var(--gold)) 19px 2px / 3px 12px no-repeat,
      linear-gradient(var(--gold), var(--gold)) 0 1px / 3px 5px no-repeat,
      linear-gradient(var(--gold), var(--gold)) 3px 0 / 2px 7px no-repeat;
  }

  /* Ячейка инвентаря. */
  .slot {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    background: #26272f;
    box-shadow:
      inset 3px 3px 0 #0e0e12,
      inset -3px -3px 0 #464856;
  }

  .slot :global(.pixel) {
    width: 2.25rem;
    height: 2.25rem;
  }

  /* ——— NPC ——— */
  .npc {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 2.5rem clamp(2.5rem, 6vw, 5rem);
    align-items: center;
    margin-top: clamp(4rem, 9vw, 6rem);
  }

  .npc__title {
    font-size: var(--fs-lg);
  }

  .npc__text > p {
    margin-top: 0.9rem;
    color: var(--bone-2);
  }

  .npc code {
    padding: 0.05em 0.35em;
    background: rgb(0 0 0 / 0.5);
    color: #f3f0e6;
  }

  .gestures {
    display: grid;
    margin-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .gestures div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0.25rem 1.25rem;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--line);
  }

  .gestures dt {
    color: var(--bone);
  }

  .gestures dd {
    margin: 0;
    color: var(--bone-2);
  }

  kbd {
    display: inline-block;
    min-width: 1.8em;
    padding: 0.1em 0.45em;
    background: var(--slate-3);
    box-shadow: inset 0 -3px 0 rgb(0 0 0 / 0.45), inset 0 2px 0 rgb(255 255 255 / 0.1);
    color: var(--gold);
    font-size: 0.9375rem;
    line-height: 1.4;
    text-align: center;
  }

  .npc .npc__more {
    color: var(--ash);
    font-size: 1rem;
  }

  .npc .npc__nav {
    padding: 0.85rem 1rem;
    background: rgb(131 196 147 / 0.06);
    box-shadow: inset 2px 0 0 var(--moss);
  }

  .npc__nav b {
    color: var(--moss);
  }

  /* Игровой экран: ночное небо, сверху навигатор, по центру окно NPC, внизу баланс. */
  .screen__view {
    position: relative;
    display: grid;
    justify-items: center;
    align-content: space-between;
    gap: 1rem;
    min-height: 22rem;
    padding: 0.75rem 1rem 1rem;
    overflow: hidden;
    background:
      linear-gradient(180deg, transparent 62%, rgb(0 0 0 / 0.25) 62% 64%, transparent 64%),
      repeating-linear-gradient(90deg, #1b2017 0 32px, #20271c 32px 64px) 0 100% / 100% 36% no-repeat,
      linear-gradient(180deg, #0a0f1d 0%, #16203a 60%, #1c2543 100%);
    box-shadow:
      0 0 0 2px #0a0a0d,
      0 0 0 6px #2a2b33,
      0 0 0 8px #0a0a0d;
  }

  /* Навигатор: полоса как у босса, над ней цель и расстояние. */
  .navbar {
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    width: min(18rem, 90%);
  }

  .navbar__label {
    color: #f3f0e6;
    font-family: var(--font-pixel);
    font-size: 0.9375rem;
    line-height: 1.2;
    text-shadow: 2px 2px 0 #1c1c1c;
    white-space: nowrap;
  }

  .navbar__arrow {
    color: #8fd06f;
  }

  .navbar__bar {
    display: block;
    width: 100%;
    height: 6px;
    background: linear-gradient(#b7ec8a 0 50%, #4f8f2a 50%);
    box-shadow: 0 0 0 1px #0a0a0d;
  }

  /* Окно NPC: серое, как сундук в игре. */
  .gui {
    position: relative;
    width: 100%;
    max-width: 23rem;
    padding: 0.5rem 0.55rem 0.6rem;
    background: #c6c6c6;
    box-shadow:
      inset 2px 2px 0 #ffffff,
      inset -2px -2px 0 #555555,
      0 0 0 2px #0a0a0d;
  }

  .gui__title {
    margin: 0.1rem 0 0.25rem;
    color: #3f3f3f;
    font-family: var(--font-pixel);
    font-size: 0.8125rem;
    line-height: 1.2;
  }

  .gui__title + .gui__grid + .gui__title {
    margin-top: 0.45rem;
  }

  .gui__grid {
    display: grid;
    grid-template-columns: repeat(9, minmax(0, 1fr));
  }

  .gui__slot {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    background: #8b8b8b;
    box-shadow:
      inset 2px 2px 0 #373737,
      inset -2px -2px 0 #ffffff;
  }

  .gui__slot :global(.pixel) {
    width: 64%;
    height: 64%;
  }

  .gui__slot--btn {
    background: #8fbf6f;
  }

  .gui__slot--on {
    background: #b8b8b8;
    box-shadow:
      inset 2px 2px 0 #373737,
      inset -2px -2px 0 #ffffff,
      inset 0 0 0 4px rgb(255 255 255 / 0.35);
  }

  .gui__count {
    position: absolute;
    right: 2px;
    bottom: 0;
    color: #fff;
    font-family: var(--font-pixel);
    font-size: 0.6875rem;
    line-height: 1;
    text-shadow: 1px 1px 0 #3f3f3f;
  }

  /* Подсказка к выбранной вещи. */
  .gui__tip {
    justify-self: start;
    width: fit-content;
    max-width: 100%;
    margin: 0.5rem 0 0 calc(100% / 9);
    padding: 0.35rem 0.55rem;
    background: rgb(16 0 16 / 0.94);
