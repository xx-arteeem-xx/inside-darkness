---
import Pixel from './Pixel.astro';
import { GLYPHS, type GlyphId } from '../lib/emblems';
import { G, START_COINS, fmt } from '../data/game';
import { docHref } from '../lib/docs';

const pricesHref = await docHref('prices');
const tradeHref = await docHref('trade');
const startHref = await docHref('start');
const peopleHref = await docHref('people');

const steps: Array<{ glyph: GlyphId; title: string; text: string }> = [
  { glyph: 'pickaxe', title: 'Добываешь', text: 'Руда в шахте, урожай на поле, брёвна в саду, рыба. Или трофеи с тварей в подземельях и за Стеной.' },
  { glyph: 'pouch', title: 'Продаёшь с умом', text: 'Цены живые: их двигают вести по миру и расстояние. У угодья — сразу, в дальней деревне — дороже.' },
  { glyph: 'coin', title: 'Получаешь монеты', text: 'Платят купцы, старосты за заказы, летописец за открытые места, хозяева подземелий и отбитые набеги.' },
  { glyph: 'anvil', title: 'Растёшь в ремесле', text: 'Мастер даёт ранг за пробу и плату. Ранг — дороже товар, больше добычи и пропуск к незериту и высоким чарам.' },
];

// Окно рудного купца: базовая цена рудного железа из конфига, раскладка окна упрощена.
const IRON = G.market.price.RAW_IRON;
const lot = 32;
const prices: Array<GlyphId | null> = ['coal', 'iron', 'gold', 'gem', null, null, null, null, null];
const bag: Array<[GlyphId, number] | null> = [['pickaxe', 1], ['iron', lot], ['coal', 20], ['gem', 2], ['bread', 6], null, null, null, null];
const picked = 1;
const gain = IRON * lot;
---
<section class="loop section" id="how" aria-labelledby="how-title">
  <div class="wrap">
    <header class="section-head">
      <h2 class="section-title" id="how-title">Как устроена игра</h2>
      <p class="section-lead">
        Один круг на всю игру: добыл, продал там, где дороже, получил монеты, вырос в ремесле. Со следующим кругом
        тот же час работы приносит больше.
      </p>
    </header>

    <ol class="cycle" role="list">
      {steps.map((s, i) => (
        <li class="cycle__step">
          <span class="slot" aria-hidden="true"><Pixel grid={GLYPHS[s.glyph]} /></span>
          <p class="cycle__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="cycle__title">{s.title}</h3>
          <p class="cycle__text">{s.text}</p>
        </li>
      ))}
    </ol>
    <p class="cycle__back">
      <span class="cycle__arrow" aria-hidden="true"></span>
      И снова к шахте, полю или в подземелье, но уже рангом выше.
    </p>

    <div class="npc">
      <div class="npc__text">
        <h3 class="npc__title">Всё через людей и их окна</h3>
        <p>
          Команд вроде <code>/sell</code> или телепортов нет. Жмёшь ПКМ по жителю — открывается его окно. Продать или
          выбрать вещь — клик по ней в своём инвентаре.
        </p>
        <dl class="gestures">
          <div>
            <dt><kbd>Клик</kbd> по своей вещи</dt>
            <dd>продана вся стопка</dd>
          </div>
          <div>
            <dt><kbd>Shift</kbd> + <kbd>клик</kbd></dt>
            <dd>продан весь такой товар из инвентаря</dd>
          </div>
          <div>
            <dt><kbd>ПКМ</kbd> по вещи в окне</dt>
            <dd>продана одна штука</dd>
          </div>
          <div>
            <dt>«Продать всё подходящее»</dt>
            <dd>всё, что берёт этот купец</dd>
          </div>
        </dl>
        <p class="npc__nav">
          <b>Навигатор.</b> Стрелка и расстояние сверху экрана ведут к цели, нужный житель подсвечивается. Дорогу
          показывают {G.npcs.who.guide.job.toLowerCase()} {G.npcs.who.guide.short} на площади столицы, глашатаи у входов на рынок и провожатый у въезда
          в Деревню мастеров.
        </p>
        <p class="npc__more">Кто где: <a href={peopleHref}>Кто где</a>. Почему цены разные: <a href={tradeHref}>Торг и вести</a>. Базовые цены: <a href={pricesHref}>Купцы и базовые цены</a>. С чего начать: <a href={startHref}>Первые шаги</a>.</p>
      </div>

      <figure class="screen">
        <div class="screen__view" aria-hidden="true">
          <div class="navbar">
            <p class="navbar__label"><span class="navbar__arrow">↑</span> Рудный купец · 14 м</p>
            <span class="navbar__bar"></span>
          </div>
          <div class="gui">
            <p class="gui__title">Рудный купец · скупка</p>
            <div class="gui__grid">
              {prices.map((g) => (
                <span class="gui__slot">{g && <Pixel grid={GLYPHS[g]} />}</span>
              ))}
              {Array.from({ length: 9 }, (_, i) => (
                <span class:list={['gui__slot', { 'gui__slot--btn': i === 4 }]}>{i === 4 && <Pixel grid={GLYPHS.pouch} />}</span>
              ))}
            </div>
            <p class="gui__title">Инвентарь</p>
            <div class="gui__grid">
              {bag.map((it, i) => (
                <span class:list={['gui__slot', { 'gui__slot--on': i === picked }]}>
                  {it && <Pixel grid={GLYPHS[it[0]]} />}
                  {it && it[1] > 1 && <span class="gui__count">{it[1]}</span>}
                </span>
              ))}
            </div>
            <div class="gui__tip">
              <p class="gui__tip-name">Рудное железо</p>
              <p>Цена: <span>{fmt(IRON)}</span> за шт.</p>
              <p>У вас: {lot} шт. → <span>{fmt(gain)}</span></p>
              <p class="gui__tip-act">Клик — продать стопку</p>
            </div>
          </div>
          <p class="screen__balance">+{fmt(gain)} · {fmt(START_COINS + gain)} монет</p>
        </div>
        <figcaption>
          Пример: окно рудного купца с базовой ценой, без вестей. Клик по руде в своём инвентаре — стопка продана,
          баланс всплывает над хотбаром. Сверху — навигатор.
        </figcaption>
      </figure>
    </div>

  </div>
</section>

<style>
  .loop {
    background: var(--slate-0);
  }

  /* ——— круг ——— */
  .cycle {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem clamp(1.5rem, 3vw, 2.75rem);
    margin: clamp(2.5rem, 6vw, 4rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .cycle__step {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-content: start;
    gap: 0.25rem 1rem;
  }

  .cycle__step .slot {
    grid-row: span 2;
  }

  /* Пиксельная стрелка к следующему шагу. */
  .cycle__step:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 1.35rem;
    right: calc(-1 * clamp(1.5rem, 3vw, 2.75rem) + 0.35rem);
    width: calc(clamp(1.5rem, 3vw, 2.75rem) - 0.7rem);
    height: 10px;
    background:
      linear-gradient(var(--gold-deep), var(--gold-deep)) left 0 top 4px / calc(100% - 6px) 2px no-repeat,
      linear-gradient(var(--gold), var(--gold)) right 4px top 0 / 2px 10px no-repeat,
      linear-gradient(var(--gold), var(--gold)) right 2px top 2px / 2px 6px no-repeat,
      linear-gradient(var(--gold), var(--gold)) right 0 top 4px / 2px 2px no-repeat;
  }

  .cycle__n {
    align-self: end;
    color: var(--torch);
    font-family: var(--font-pixel);
    font-size: 1rem;
    line-height: 1;
  }

  .cycle__title {
    align-self: start;
    font-size: var(--fs-md);
    line-height: 1.15;
  }

  .cycle__text {
    grid-column: 1 / -1;
    margin-top: 0.75rem;
    color: var(--bone-2);
  }

  .cycle__back {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2.25rem;
    padding: 0.85rem 1.1rem;
    background: rgb(237 163 60 / 0.06);
    box-shadow: inset 0 0 0 1px rgb(237 163 60 / 0.25);
    color: var(--bone);
  }

  /* Стрелка «назад к началу»: уголок из пикселей. */
  .cycle__arrow {
    flex: none;
    width: 22px;
    height: 16px;
    background:
      linear-gradient(var(--gold), var(--gold)) 4px 2px / 18px 3px no-repeat,
      linear-gradient(var(--gold), var(--gold)) 19px 2px / 3px 12px no-repeat,
      linear-gradient(var(--gold), var(--gold)) 0 1px / 3px 5px no-repeat,
      linear-gradient(var(--gold), var(--gold)) 3px 0 / 2px 7px no-repeat;
  }

  /* Ячейка инвентаря. */
  .slot {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    background: #26272f;
    box-shadow:
      inset 3px 3px 0 #0e0e12,
      inset -3px -3px 0 #464856;
  }

  .slot :global(.pixel) {
    width: 2.25rem;
    height: 2.25rem;
  }

  /* ——— NPC ——— */
  .npc {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 2.5rem clamp(2.5rem, 6vw, 5rem);
    align-items: center;
    margin-top: clamp(4rem, 9vw, 6rem);
  }

  .npc__title {
    font-size: var(--fs-lg);
  }

  .npc__text > p {
    margin-top: 0.9rem;
    color: var(--bone-2);
  }

  .npc code {
    padding: 0.05em 0.35em;
    background: rgb(0 0 0 / 0.5);
    color: #f3f0e6;
  }

  .gestures {
    display: grid;
    margin-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .gestures div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0.25rem 1.25rem;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--line);
  }

  .gestures dt {
    color: var(--bone);
  }

  .gestures dd {
    margin: 0;
    color: var(--bone-2);
  }

  kbd {
    display: inline-block;
    min-width: 1.8em;
    padding: 0.1em 0.45em;
    background: var(--slate-3);
    box-shadow: inset 0 -3px 0 rgb(0 0 0 / 0.45), inset 0 2px 0 rgb(255 255 255 / 0.1);
    color: var(--gold);
    font-size: 0.9375rem;
    line-height: 1.4;
    text-align: center;
  }

  .npc .npc__more {
    color: var(--ash);
    font-size: 1rem;
  }

  .npc .npc__nav {
    padding: 0.85rem 1rem;
    background: rgb(131 196 147 / 0.06);
    box-shadow: inset 2px 0 0 var(--moss);
  }

  .npc__nav b {
    color: var(--moss);
  }

  /* Игровой экран: ночное небо, сверху навигатор, по центру окно NPC, внизу баланс. */
  .screen__view {
    position: relative;
    display: grid;
    justify-items: center;
    align-content: space-between;
    gap: 1rem;
    min-height: 22rem;
    padding: 0.75rem 1rem 1rem;
    overflow: hidden;
    background:
      linear-gradient(180deg, transparent 62%, rgb(0 0 0 / 0.25) 62% 64%, transparent 64%),
      repeating-linear-gradient(90deg, #1b2017 0 32px, #20271c 32px 64px) 0 100% / 100% 36% no-repeat,
      linear-gradient(180deg, #0a0f1d 0%, #16203a 60%, #1c2543 100%);
    box-shadow:
      0 0 0 2px #0a0a0d,
      0 0 0 6px #2a2b33,
      0 0 0 8px #0a0a0d;
  }

  /* Навигатор: полоса как у босса, над ней цель и расстояние. */
  .navbar {
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    width: min(18rem, 90%);
  }

  .navbar__label {
    color: #f3f0e6;
    font-family: var(--font-pixel);
    font-size: 0.9375rem;
    line-height: 1.2;
    text-shadow: 2px 2px 0 #1c1c1c;
    white-space: nowrap;
  }

  .navbar__arrow {
    color: #8fd06f;
  }

  .navbar__bar {
    display: block;
    width: 100%;
    height: 6px;
    background: linear-gradient(#b7ec8a 0 50%, #4f8f2a 50%);
    box-shadow: 0 0 0 1px #0a0a0d;
  }

  /* Окно NPC: серое, как сундук в игре. */
  .gui {
    position: relative;
    width: 100%;
    max-width: 23rem;
    padding: 0.5rem 0.55rem 0.6rem;
    background: #c6c6c6;
    box-shadow:
      inset 2px 2px 0 #ffffff,
      inset -2px -2px 0 #555555,
      0 0 0 2px #0a0a0d;
  }

  .gui__title {
    margin: 0.1rem 0 0.25rem;
    color: #3f3f3f;
    font-family: var(--font-pixel);
    font-size: 0.8125rem;
    line-height: 1.2;
  }

  .gui__title + .gui__grid + .gui__title {
    margin-top: 0.45rem;
  }

  .gui__grid {
    display: grid;
    grid-template-columns: repeat(9, minmax(0, 1fr));
  }

  .gui__slot {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    background: #8b8b8b;
    box-shadow:
      inset 2px 2px 0 #373737,
      inset -2px -2px 0 #ffffff;
  }

  .gui__slot :global(.pixel) {
    width: 64%;
    height: 64%;
  }

  .gui__slot--btn {
    background: #8fbf6f;
  }

  .gui__slot--on {
    background: #b8b8b8;
    box-shadow:
      inset 2px 2px 0 #373737,
      inset -2px -2px 0 #ffffff,
      inset 0 0 0 4px rgb(255 255 255 / 0.35);
  }

  .gui__count {
    position: absolute;
    right: 2px;
    bottom: 0;
    color: #fff;
    font-family: var(--font-pixel);
    font-size: 0.6875rem;
    line-height: 1;
    text-shadow: 1px 1px 0 #3f3f3f;
  }

  /* Подсказка к выбранной вещи. */
  .gui__tip {
    justify-self: start;
    width: fit-content;
    max-width: 100%;
    margin: 0.5rem 0 0 calc(100% / 9);
    padding: 0.35rem 0.55rem;
    background: rgb(16 0 16 / 0.94);
    box-shadow: inset 0 0 0 2px #2a0b5e;
    color: #aaaaaa;
    font-family: var(--font-pixel);
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .gui__tip span {
    color: #ffaa00;
  }

  .gui__tip-name {
    color: #ffffff;
  }

  .gui__tip-act {
    color: #ffff55;
  }

  .screen__balance {
    color: var(--gold);
    font-family: var(--font-pixel);
    font-size: 1.0625rem;
    text-shadow: 2px 2px 0 #3a2a0c;
  }

  .screen figcaption {
    margin-top: 1.1rem;
    color: var(--ash);
    font-size: var(--fs-sm);
  }

  @media (max-width: 64rem) {
    .cycle {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cycle__step::after {
      display: none;
    }

    .npc {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 36rem) {
    .cycle {
      grid-template-columns: 1fr;
    }

    .gestures div {
      grid-template-columns: 1fr;
    }

    .screen__view {
      min-height: 18rem;
      padding: 0.6rem 0.6rem 0.75rem;
    }

    .gui {
      padding-inline: 0.4rem;
    }

    .gui__tip {
      margin-left: 0;
    }
  }
</style>
