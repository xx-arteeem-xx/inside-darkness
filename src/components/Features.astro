---
import Pixel from './Pixel.astro';
import Person from './Person.astro';
import { GLYPHS, type GlyphId } from '../lib/emblems';
import { url } from '../lib/url';
import { G } from '../data/game';

const R = G.ranks.names;
// жители, с которыми новичок встретится в первый же вечер: скины — как в игре
const FOLK = ['guide', 'station_capital', 'bank_capital', 'market_5', 'headman_west_plains', 'inn_acacia_west', 'chronicler', 'village_5'];
const items: { glyph: GlyphId; title: string; text: string; href: string; more: string }[] = [
  {
    glyph: 'pouch',
    title: 'Ремёсла и торг',
    text: `Шахта, поле, сад, рыбалка и охота на тварей, а над ними — торговое дело. В каждом занятии свои ранги, от «${R[0]}» до «${R[R.length - 1]}». Цены у купцов живые: их двигают вести, расстояние и набеги.`,
    href: '/guide/crafts/',
    more: 'Занятия и ранги',
  },
  {
    glyph: 'anvil',
    title: 'Качество вещей и комплекты',
    text: 'У каждой вещи есть качество, от обычного до легендарного. Кузнец поднимает его за материалы и монеты, без случайных неудач. Комплекты собирают с хозяев подземелий.',
    href: '/guide/gear/',
    more: 'Снаряжение',
  },
  {
    glyph: 'skull',
    title: 'Подземелья с хозяевами',
    text: 'Подземелье проходят зал за залом: твари идут волнами, решётка поднимается после зачистки. В конце — хозяин со своим приёмом и личный сундук добычи каждому, кто бился.',
    href: '/guide/dungeons/',
    more: 'Подземелья',
  },
  {
    glyph: 'darkheart',
    title: 'Тёмные земли за Стеной',
    text: 'За Большой стеной нет солнца и закона. Твари живут в логовах: чем глубже, тем сильнее и богаче добыча. Тьма давит на тех, кто идёт без ладанки.',
    href: '/guide/darklands/',
    more: 'Тёмные земли',
  },
  {
    glyph: 'banner',
    title: 'Жильё, дружины, поручения',
    text: 'Комната в таверне или дом в деревне — со своей кроватью и сундуками. Дружиной ходят на хозяев и отбивают набеги, у старост и в столице берут поручения.',
    href: '/guide/housing/',
    more: 'Жизнь в краю',
  },
  {
    glyph: 'scroll',
    title: 'Всё через жителей',
    text: 'Торг, поездки, жильё, ранги — у жителей, в их окнах. Ямщик возит, казначей хранит, летописец платит за открытые места. Команды учить не нужно.',
    href: '/guide/world/',
    more: 'Край и его места',
  },
];
---
<section class="features section" id="features" aria-labelledby="features-title">
  <div class="wrap">
    <header class="section-head">
      <h2 class="section-title" id="features-title">Чем этот край отличается</h2>
      <p class="section-lead">
        Обычный Minecraft, только устроенный как MMORPG: роли, рост, добыча, опасность и люди вокруг. Каждую систему
        объясняет житель одной фразой, и открывается она тогда, когда ты до неё дорос.
      </p>
    </header>

    <ul class="features__list" role="list">
      {items.map((it) => (
        <li class="feature">
          <span class="slot"><Pixel grid={GLYPHS[it.glyph]} /></span>
          <div class="feature__body">
            <h3 class="feature__title">{it.title}</h3>
            <p class="feature__text">{it.text}</p>
            <a class="feature__more" href={url(it.href)}>{it.more}</a>
          </div>
        </li>
      ))}
    </ul>

    <div class="folk">
      <h3 class="folk__title">Они ждут тебя в краю</h3>
      <p class="folk__lead">Проводник, ямщик, казначей, кузнец, староста, трактирщица, летописец, воевода — у каждого своё окно и своё дело. Так они и выглядят в игре.</p>
      <ul class="folk__list" role="list">
        {FOLK.map((id) => <li><Person id={id} size="figure" scale={4} class="folk__who" /></li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .features {
    padding-top: clamp(3rem, 6vw, 5rem);
    background:
      linear-gradient(180deg, var(--void), var(--slate-0) 22%);
  }

  .features__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 21rem), 1fr));
    gap: 2.75rem clamp(2rem, 4vw, 3.5rem);
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .feature {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.1rem;
    align-items: start;
  }

  .feature__title {
    font-size: var(--fs-md);
    line-height: 1.15;
  }

  .feature__text {
    margin-top: 0.5rem;
    color: var(--bone-2);
    line-height: 1.55;
  }

  .feature__more {
    display: inline-block;
    margin-top: 0.6rem;
    color: var(--gold);
    font-weight: 700;
    text-decoration-color: var(--gold-deep);
  }

  .feature__more:hover {
    color: var(--bone);
  }

  .folk {
    margin-top: clamp(3.5rem, 7vw, 5rem);
    padding-top: 2.25rem;
    border-top: 1px solid var(--line);
  }

  .folk__title {
    font-size: var(--fs-lg);
  }

  .folk__lead {
    max-width: 44rem;
    margin-top: 0.6rem;
    color: var(--bone-2);
  }

  .folk__list {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 2rem 0.75rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .folk__list > li {
    display: grid;
  }

  /* фигуры стоят на одной земле, подписи — под ней */
  .folk__list :global(.folk__who) {
    grid-template-rows: auto 1fr;
    align-items: start;
  }

  .folk__list :global(.folk__who .pp__frame) {
    width: 100%;
    display: flex;
    justify-content: center;
    border-bottom: 2px solid var(--slate-3);
    box-sizing: content-box;
    padding-bottom: 0.25rem;
  }

  .folk__list :global(.folk__who .pp__frame img) {
    position: static;
  }

  @media (max-width: 72rem) {
    .folk__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 30rem) {
    .folk__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
