---
import Base from './Base.astro';
import GuideSearch from '../components/GuideSearch.astro';
import '../styles/prose.css';
import { url } from '../lib/url';
import { flatten, type DocSection } from '../lib/guide';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  title: string;
  description?: string;
  sections: DocSection[];
  currentId?: string;
  headings?: Heading[];
}

const { title, description, sections, currentId, headings = [] } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const isIndex = !currentId;
const numberOf = new Map(flatten(sections).map((d, i) => [d.id, i + 1]));
---
<Base title={title} description={description || undefined}>
  <div class="guide">
    <aside class="guide__side" aria-label="Главы гайда">
      <GuideSearch />
      <button class="guide__toggle" type="button" aria-expanded="false" aria-controls="guide-nav" hidden>
        Все главы
      </button>
      <nav class="guide__nav" id="guide-nav">
        <a class="guide__home" href={url('/guide/')} aria-current={isIndex ? 'page' : undefined}>Гайд по краю</a>
        {sections.length === 0 && <p class="guide__empty">Главы пока пишутся.</p>}
        {sections.map((section) => (
          <div class="guide__group">
            <p class="guide__part">{section.name}</p>
            <ul role="list">
              {section.docs.map((doc) => (
                <li>
                  <a href={url(`/guide/${doc.id}/`)} aria-current={doc.id === currentId ? 'page' : undefined}>
                    <span class="guide__num" aria-hidden="true">{numberOf.get(doc.id)}</span>
                    <span>{doc.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </aside>

    <div class="guide__main">
      <slot />
    </div>

    {toc.length > 1 && (
      <aside class="guide__toc" aria-labelledby="toc-title">
        <p class="guide__toc-title" id="toc-title">На этой странице</p>
        <ul role="list">
          {toc.map((h) => (
            <li class:list={[`toc-d${h.depth}`]}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </div>
</Base>

<style>
  :global(body[data-variant='inner']) {
    background: var(--slate-0);
  }

  .guide {
    display: grid;
    grid-template-columns: 17rem minmax(0, 46rem) 14rem;
    justify-content: center;
    gap: 0 clamp(2rem, 4vw, 4rem);
    max-width: 92rem;
    margin-inline: auto;
    padding: 2.25rem var(--gutter) 6rem;
  }

  .guide__side,
  .guide__toc {
    position: sticky;
    top: 5.75rem;
    align-self: start;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--slate-4) transparent;
  }

  /* у боковой колонки выпадающий список поиска не должен обрезаться */
  .guide__side {
    z-index: 5;
    overflow: visible;
    max-height: none;
  }

  .guide__nav {
    display: grid;
    align-content: start;
    gap: 1.5rem;
    max-height: calc(100vh - 11rem);
    margin-top: 1.5rem;
    padding: 0 0.25rem 1rem 3px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--slate-4) transparent;
  }

  .guide__home {
    justify-self: start;
    padding: 0.15rem 0.4rem;
    margin-left: -0.4rem;
    color: var(--bone);
    font-size: 1.125rem;
    font-weight: 900;
    text-decoration: none;
  }

  .guide__home[aria-current='page'],
  .guide__home:hover {
    color: var(--gold);
  }

  .guide__empty {
    color: var(--ash);
  }

  .guide__part {
    margin-bottom: 0.45rem;
    color: var(--ash);
    font-size: 0.9375rem;
  }

  .guide__group ul,
  .guide__toc ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guide__group a {
    position: relative;
    display: grid;
    grid-template-columns: 1.6rem 1fr;
    align-items: baseline;
    padding: 0.32rem 0 0.32rem 0.75rem;
    color: var(--bone-2);
    font-size: 1rem;
    line-height: 1.3;
    text-decoration: none;
    box-shadow: inset 2px 0 0 var(--slate-3);
  }

  .guide__num {
    color: var(--ash-2);
    font-family: var(--font-pixel);
    font-size: 0.875rem;
  }

  .guide__group a:hover {
    color: var(--bone);
    box-shadow: inset 2px 0 0 var(--stone);
  }

  /* Текущая глава: золотой «пиксель» на линии. */
  .guide__group a[aria-current='page'] {
    color: var(--gold);
    font-weight: 700;
    box-shadow: inset 2px 0 0 var(--gold-deep);
  }

  .guide__group a[aria-current='page'] .guide__num {
    color: var(--gold);
  }

  .guide__group a[aria-current='page']::before {
    content: '';
    position: absolute;
    left: -3px;
    top: 50%;
    width: 8px;
    height: 8px;
    margin-top: -4px;
    background: var(--gold);
  }

  .guide__home:focus-visible,
  .guide__group a:focus-visible,
  .guide__toc a:focus-visible {
    outline-offset: -3px;
  }

  .guide__toc-title {
    margin-bottom: 0.6rem;
    color: var(--bone);
    font-size: 1rem;
    font-weight: 700;
  }

  .guide__toc a {
    display: block;
    padding-block: 0.25rem;
    color: var(--ash);
    font-size: 0.9375rem;
    line-height: 1.35;
    text-decoration: none;
  }

  .guide__toc a:hover,
  .guide__toc a[aria-current='true'] {
    color: var(--gold);
  }

  .guide__toc .toc-d3 a {
    padding-left: 0.85rem;
    font-size: 0.875rem;
  }

  .guide__toggle {
    display: none;
  }

  @media (max-width: 76rem) {
    .guide {
      grid-template-columns: 16rem minmax(0, 46rem);
    }

    .guide__toc {
      display: none;
    }
  }

  @media (max-width: 54rem) {
    .guide {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 1.25rem;
    }

    .guide__side {
      position: static;
      margin-bottom: 2rem;
      padding-bottom: 1.25rem;
      border-bottom: 1px solid var(--line);
    }

    .guide__toggle:not([hidden]) {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      min-height: 2.75rem;
      margin-top: 0.75rem;
      padding: 0.5rem 1rem;
      border: 0;
      background: var(--slate-3);
      box-shadow: inset 0 2px 0 rgb(255 255 255 / 0.08), inset 0 -3px 0 rgb(0 0 0 / 0.35);
      color: var(--bone);
      font: inherit;
      font-weight: 700;
      cursor: pointer;
    }

    .guide__toggle::after {
      content: '';
      width: 0.55rem;
      height: 0.55rem;
      border-right: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      transform: translateY(-2px) rotate(45deg);
    }

    .guide__toggle[aria-expanded='true']::after {
      transform: translateY(2px) rotate(-135deg);
    }

    :global(html.js) .guide__toggle[aria-expanded='false'] + .guide__nav {
      display: none;
    }

    .guide__nav {
      max-height: none;
      margin-top: 1.25rem;
      overflow: visible;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.guide__toggle');
  if (toggle) {
    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
    });
  }

  // Подсветка текущего пункта оглавления при прокрутке.
  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('.guide__toc a')];
  if (tocLinks.length && 'IntersectionObserver' in window) {
    const byId = new Map(tocLinks.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (!visible.length) return;
        const link = byId.get(visible[0].target.id);
        if (!link) return;
        tocLinks.forEach((a) => a.removeAttribute('aria-current'));
        link.setAttribute('aria-current', 'true');
      },
      { rootMargin: '0px 0px -70% 0px' },
    );
    byId.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  }
</script>
