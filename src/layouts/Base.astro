---
// Шрифты отдаются с самого сайта: Vollkorn (заголовки и текст) и пиксельный Tiny5 (адрес, команды, метки).
// Подключаем только кириллицу и латиницу, остальные наборы не нужны.
import vk400c from '@fontsource/vollkorn/files/vollkorn-cyrillic-400-normal.woff2?url';
import vk400l from '@fontsource/vollkorn/files/vollkorn-latin-400-normal.woff2?url';
import vk400ic from '@fontsource/vollkorn/files/vollkorn-cyrillic-400-italic.woff2?url';
import vk400il from '@fontsource/vollkorn/files/vollkorn-latin-400-italic.woff2?url';
import vk700c from '@fontsource/vollkorn/files/vollkorn-cyrillic-700-normal.woff2?url';
import vk700l from '@fontsource/vollkorn/files/vollkorn-latin-700-normal.woff2?url';
import vk900c from '@fontsource/vollkorn/files/vollkorn-cyrillic-900-normal.woff2?url';
import vk900l from '@fontsource/vollkorn/files/vollkorn-latin-900-normal.woff2?url';
import t5c from '@fontsource/tiny5/files/tiny5-cyrillic-400-normal.woff2?url';
import t5l from '@fontsource/tiny5/files/tiny5-latin-400-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url';
import { SERVER } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  variant?: 'home' | 'inner';
}

const {
  title,
  description = `Средневековый сервер Minecraft на русском: зарабатывай монеты ремеслом и охотой, расти в ремёслах до великого мастера. Всё через NPC и их окна. Java ${SERVER.versions}, пиратка разрешена. Адрес: ${SERVER.address}`,
  variant = 'inner',
} = Astro.props;

const fullTitle = title ? `${title} | ${SERVER.name}` : `${SERVER.name}: средневековый сервер Minecraft`;
const canonical = new URL(Astro.url.pathname, Astro.site);

const LATIN = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const CYR = 'U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116';
const face = (family: string, weight: number, style: string, src: string, range: string) =>
  `@font-face{font-family:'${family}';font-style:${style};font-weight:${weight};font-display:swap;src:url(${src}) format('woff2');unicode-range:${range}}`;
const fontCss = [
  face('Vollkorn', 400, 'normal', vk400c, CYR),
  face('Vollkorn', 400, 'normal', vk400l, LATIN),
  face('Vollkorn', 400, 'italic', vk400ic, CYR),
  face('Vollkorn', 400, 'italic', vk400il, LATIN),
  face('Vollkorn', 700, 'normal', vk700c, CYR),
  face('Vollkorn', 700, 'normal', vk700l, LATIN),
  face('Vollkorn', 900, 'normal', vk900c, CYR),
  face('Vollkorn', 900, 'normal', vk900l, LATIN),
  face('Tiny5', 400, 'normal', t5c, CYR),
  face('Tiny5', 400, 'normal', t5l, LATIN),
].join('');
const preload = variant === 'home' ? [vk900l, vk400c, t5l] : [vk900c, vk400c];
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    {preload.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
    <style is:inline set:html={fontCss}></style>
    <meta name="theme-color" content="#070a14" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={SERVER.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body data-variant={variant}>
    <a class="skip-link" href="#main">К содержимому</a>
    <Header variant={variant} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
